# ===========================================================================
sect_20() {
section "20. re-arm cannot deadlock on a turn it never saw"
# A steered turn can start AND finish inside the watcher blind spot. The old
# re-arm loop waited forever for a 'working' it had already missed, so the next
# genuine settle was never reported. The session log moving on is the way out.
setup; seq_state "$AID" working 200; pi_session mid-tool
start_watcher
wait_watcher_armed
pi_session completed e5; seq_state "$AID" idle 201        # first settle
wait_settles 1
first="$(settles)"
# steered + finished entirely between probes: status never reads 'working'
pi_session completed e6; seq_state "$AID" idle 202
wait_settles 2
dwell                                                    # and no third
second="$(settles)"
stop_watchers
is "first settle reported" "$first" "1"
is "the missed turn's settle is reported too (no deadlock)" "$second" "2"
}

# Longest sections FIRST: with bounded concurrency the makespan is dominated by
# whatever starts last, so the live-watcher cases (the only ones that dwell) go
# out of the gate first and the cheap ones backfill around them.
SECTION_ORDER="5 16 18 8 20 6 17 15 7 9 11 2 19 12 3 1 14 4 10 13 0"

# ---------------------------------------------------------------------------
# the runner
#
# Every section runs in its own subshell against its own sandbox + its own stub
# state/log (see setup()), so there is nothing left to serialise them for. Each
# writes its output and its pass/fail/elapsed tally to a file; the parent then
# replays them in the CANONICAL order, so the transcript is identical whatever
# the concurrency is. -j1 is exactly the old serial behaviour.
# ---------------------------------------------------------------------------
RESDIR="$TMPROOT/results"; mkdir -p "$RESDIR"

_run_one() {
  local n="$1" t0
  # A child must NEVER inherit the parent's cleanup trap, or the first section
  # to finish would delete the whole run's TMPROOT out from under the others.
  trap - EXIT
  CASE_PREFIX="$n"; CASE_SEQ=0
  t0="$(_ms)"
  {
    "sect_$n"
    stop_watchers
  } > "$RESDIR/$n.out" 2>&1
  printf '%s %s %s\n' "$PASS" "$FAIL" "$(( $(_ms) - t0 ))" > "$RESDIR/$n.tally"
}

_live_jobs() {
  local p c=0
  for p in $RUN_PIDS; do kill -0 "$p" 2>/dev/null && c=$((c + 1)); done
  printf '%s\n' "$c"
}

RUN_PIDS=""
for n in $SECTION_ORDER; do
  if [ "$JOBS" -gt 1 ]; then
    while [ "$(_live_jobs)" -ge "$JOBS" ]; do sleep 0.02; done
    _run_one "$n" & RUN_PIDS="$RUN_PIDS $!"
  else
    ( _run_one "$n" )
  fi
done
wait

# replay in canonical order and tally
TIMINGS=""
SECTION_FAILS=""
for n in $(printf '%s\n' $SECTION_ORDER | sort -n); do
  if [ -s "$RESDIR/$n.tally" ]; then
    cat "$RESDIR/$n.out"
    read -r p f el < "$RESDIR/$n.tally"
    PASS=$((PASS + p)); FAIL=$((FAIL + f))
    TIMINGS="$TIMINGS$el	section $n\n"
    SECTION_FAILS="$SECTION_FAILS$n=$f "
  else
    printf '\n  \033[31mFAIL\033[0m section %s produced no result (it crashed)\n' "$n"
    [ -f "$RESDIR/$n.out" ] && cat "$RESDIR/$n.out"
    FAIL=$((FAIL + 1))
  fi
done

# section_failed <n> -> rc 0 if section <n> recorded at least one failure
section_failed() {
  case " $SECTION_FAILS" in *" $1=0 "*) return 1 ;; *" $1="*) return 0 ;; esac
  return 1
}

timing_report() {
  local total=$(( $(_ms) - RUN_T0 ))
  printf '\n\033[1mtiming breakdown\033[0m (section wall-clock, slowest first; -j%s)\n' "$JOBS"
  printf "$TIMINGS" | sort -rn | awk -F'\t' '$0 != "" {printf "  %7.2fs  %s\n", $1/1000, $2}'
  printf '  %7.2fs  \033[1mTOTAL (wall clock)\033[0m\n' "$(awk -v t="$total" 'BEGIN{print t/1000}')"
}

timing_report
printf '\n\033[1m%d passed, %d failed\033[0m\n\n' "$PASS" "$FAIL"

if [ "$FALSIFY" -eq 1 ]; then
  if section_failed 5; then
    printf '\033[32mFALSIFICATION OK\033[0m: section 5 caught the broken watcher (%d failures overall).\n\n' "$FAIL"
    exit 0
  fi
  if [ "$(cat "$RESDIR/falsify.armed" 2>/dev/null)" != "yes" ]; then
    printf '\033[33mFALSIFICATION INCONCLUSIVE\033[0m: the bug never reproduced.\n'
    printf 'The sabotaged watcher was so slow to start (heavy load on this host) that\n'
    printf 'section 5 had already set the agent working before it armed — so it\n'
    printf 'witnessed a real work phase and behaved CORRECTLY by accident. This says\n'
    printf 'nothing about the %ss dwell. Re-run on an unloaded machine.\n\n' "$DWELL"
    exit 2
  fi
  printf '\033[31mFALSIFICATION FAILED\033[0m: a watcher that armed its settle loop WITHOUT\n'
  printf 'witnessing a work phase still passed section 5. The %ss dwell is too short —\n' "$DWELL"
  printf 'its negative assertions are vacuous and no longer detect the bug they exist for.\n\n'
  exit 1
fi
[ "$FAIL" -eq 0 ]
