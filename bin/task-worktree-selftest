sect_12() {
section "12. settle CLASSIFIER: why did the agent go idle?"
setup; seq_state "$AID" idle 120
pi_session completed;   is "stopReason=stop                        -> completed"       "$(cause)" "completed"
pi_session human;       is "'Operation aborted' (pi /stop)          -> human-interrupt" "$(cause)" "human-interrupt"
pi_session human-http;  is "'This operation was aborted' (/stop)    -> human-interrupt" "$(cause)" "human-interrupt"
pi_session crash;       is "'Connection error.'                     -> agent-error"     "$(cause)" "agent-error"
pi_session retry-crash; is "'Aborted after 1 retry attempt'         -> agent-error"     "$(cause)" "agent-error"
pi_session mid-tool;    is "session ends mid tool-loop              -> unknown"         "$(cause)" "unknown"
no_pi_session;          is "no session log at all                   -> unknown"         "$(cause)" "unknown"
HERDR_STUB_AGENT=claude pi_session human
is "a non-pi agent kind                     -> unknown" "$(HERDR_STUB_AGENT=claude cause)" "unknown"
}

