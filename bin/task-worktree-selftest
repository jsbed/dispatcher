# ===========================================================================
sect_20() {
section "20. re-arm cannot deadlock on a turn it never saw"
# A steered turn can start AND finish inside the watcher blind spot. The old
# re-arm loop waited forever for a 'working' it had already missed, so the next
# genuine settle was never reported. The session log moving on is the way out.
setup; seq_state "$AID" working 200; pi_session mid-tool
start_watcher
wait_watcher_armed
pi_session completed e5; seq_state "$AID" idle 201        # first settle
wait_settles 1
first="$(settles)"
# steered + finished entirely between probes: status never reads 'working'
pi_session completed e6; seq_state "$AID" idle 202
wait_settles 2
dwell                                                    # and no third
second="$(settles)"
stop_watchers
is "first settle reported" "$first" "1"
is "the missed turn's settle is reported too (no deadlock)" "$second" "2"
}

# ===========================================================================
sect_21() {
section "21. create --pr attaches a task to an existing PR branch"
setup; pr_sandbox; mk_repo widget feature-x
pr_fixture 7 OPEN feature-x
pr_fixture 9 CLOSED old-branch

err="$(TW create --slug pr-demo --repo widget --pr 7 --no-agent 2>&1 >"$SANDBOX/id.out")"; rc=$?
id="$(cat "$SANDBOX/id.out")"
is "create --pr succeeds" "$rc" "0"
case "$err" in *"base: widget @ origin/feature-x"*) ok "the PR head is the base ref" ;;
  *) bad "the PR head is the base ref" "$err" ;; esac
wt="$(grep '^WORKTREE' "$HERDR_STUB_LOG" | head -1)"
is "the worktree is cut from the PR branch, not off main" \
   "$(printf '%s' "$wt" | cut -f2,3,4)" "$(printf 'widget\tfeature-x\torigin/feature-x')"
env_file="$SANDBOX/tasks/$id/task.env"
is "task.env records the branch" "$(. "$env_file" 2>/dev/null; echo "${TASK_BRANCH:-}")" "feature-x"
is "task.env records TASK_PR_NUMBER" "$(. "$env_file" 2>/dev/null; echo "${TASK_PR_NUMBER:-}")" "7"
is "task.env records TASK_PR_URL" "$(. "$env_file" 2>/dev/null; echo "${TASK_PR_URL:-}")" \
   "https://github.com/acme/widget/pull/7"
is "the mode stays 'code'" "$(. "$env_file" 2>/dev/null; echo "${TASK_MODE:-}")" "code"
case "$(cat "$SANDBOX/.dispatch/ledger.jsonl")" in *'Autopilot PR 7'*) ok "the default request names the PR" ;;
  *) bad "the default request names the PR" "$(tail -1 "$SANDBOX/.dispatch/ledger.jsonl")" ;; esac

# the slug is optional when --pr identifies the work
setup; pr_sandbox; mk_repo widget feature-x; pr_fixture 7 OPEN feature-x
id2="$(TW create --repo widget --pr 7 --no-agent 2>/dev/null)"
case "$id2" in autopilot-pr-7-*) ok "--slug defaults to autopilot-pr-<N>" ;;
  *) bad "--slug defaults to autopilot-pr-<N>" "got '$id2'" ;; esac

# the executor is briefed with the autopilot loop
setup; pr_sandbox; mk_repo widget feature-x; pr_fixture 7 OPEN feature-x
TW create --repo widget --pr 7 >/dev/null 2>&1
brief="$(grep '^PROMPT' "$HERDR_STUB_LOG" | head -1)"
case "$brief" in *autopilot*|*Autopilot*) ok "the default prompt is the autopilot loop" ;;
  *) bad "the default prompt is the autopilot loop" "$brief" ;; esac
for want in 'feature-x' 'https://github.com/acme/widget/pull/7' 'gh pr checks'; do
  case "$brief" in *"$want"*) ok "the brief is substituted with: $want" ;;
    *) bad "the brief is substituted with: $want" "$brief" ;; esac
done

# an explicit --prompt / --request / --slug still wins
setup; pr_sandbox; mk_repo widget feature-x; pr_fixture 7 OPEN feature-x
id3="$(TW create --repo widget --pr 7 --slug mine --request "my words" --prompt "do it my way" 2>/dev/null)"
case "$id3" in mine-*) ok "--slug overrides the autopilot default" ;;
  *) bad "--slug overrides the autopilot default" "got '$id3'" ;; esac
case "$(grep '^PROMPT' "$HERDR_STUB_LOG" | head -1)" in *'do it my way'*) ok "--prompt overrides the template" ;;
  *) bad "--prompt overrides the template" "$(grep '^PROMPT' "$HERDR_STUB_LOG" | head -1)" ;; esac
case "$(cat "$SANDBOX/.dispatch/ledger.jsonl")" in *'my words'*) ok "--request overrides the default" ;;
  *) bad "--request overrides the default" "$(tail -1 "$SANDBOX/.dispatch/ledger.jsonl")" ;; esac

# a PR that is not open must never be attached
setup; pr_sandbox; mk_repo widget old-branch; pr_fixture 9 CLOSED old-branch
out="$(TW create --repo widget --pr 9 --no-agent 2>&1)"; rc=$?
is "a closed PR is refused" "$rc" "1"
case "$out" in *CLOSED*|*'not open'*) ok "and says the PR is not open" ;;
  *) bad "and says the PR is not open" "$out" ;; esac
is "and no worktree is created for it" "$(grep -c '^WORKTREE' "$HERDR_STUB_LOG" | tr -d ' ')" "0"

# a PR that does not exist at all
setup; pr_sandbox; mk_repo widget
out="$(TW create --repo widget --pr 404 --no-agent 2>&1)"; rc=$?
is "an unknown PR fails loudly" "$rc" "1"

# --pr owns the branch and the base; the caller may not also pick them
setup; pr_sandbox; mk_repo widget feature-x; pr_fixture 7 OPEN feature-x
out="$(TW create --slug x --repo widget --pr 7 --branch mine --no-agent 2>&1)"; rc=$?
is "--pr with --branch is refused" "$rc" "1"
case "$out" in *--branch*) ok "and the error names --branch" ;; *) bad "and the error names --branch" "$out" ;; esac
out="$(TW create --slug x --repo widget --pr 7 --base main --no-agent 2>&1)"; rc=$?
is "--pr with --base is refused" "$rc" "1"
case "$out" in *--base*) ok "and the error names --base" ;; *) bad "and the error names --base" "$out" ;; esac

# a PR url is accepted in place of a bare number
setup; pr_sandbox; mk_repo widget feature-x; pr_fixture 7 OPEN feature-x
id4="$(TW create --repo widget --pr https://github.com/acme/widget/pull/7 --no-agent 2>/dev/null)"
is "a PR url resolves to the same branch" \
   "$(. "$SANDBOX/tasks/$id4/task.env" 2>/dev/null; echo "${TASK_BRANCH:-}")" "feature-x"

# help mentions the flag, so it is discoverable
case "$(TW create --help 2>&1)" in *--pr*) ok "create --help documents --pr" ;;
  *) bad "create --help documents --pr" ;; esac
}

# ===========================================================================
sect_22() {
section "22. brainstorm: an idle session is a CONVERSATION, not a settle"
# The whole premise of --mode brainstorm: the human is typing at it, so it is
# idle between every turn. If that produced a settle, Dispatch would be woken on
# every conversational turn AND the exactly-once claim would be burned.
setup; brainstorm_ledger both
seq_state "$AID" working 220; pi_session mid-tool
start_watcher
wait_watcher_armed
pi_session completed e5; seq_state "$AID" idle 221   # turn ends; waiting for the human
# POSITIVE: the watcher must reach a verdict (it records the conversation).
wait_convos 1
# NEGATIVE: and having reached it, must NOT settle or wake. No event to wait
# for, so dwell (see DWELL).
dwell
is "an idle brainstorm session records NO settle" "$(settles)" "0"
is "and does NOT wake Dispatch" "$(dwakes)" "0"
is "but a durable 'conversing' event IS recorded" "$(convos)" "1"
if grep -q '"status": *"in-conversation"' "$SANDBOX/.dispatch/ledger.jsonl"; then
  ok "with status in-conversation"
else bad "with status in-conversation" "$(ledger | tail -1)"; fi
if [ -z "$(grep '^NOTIFY' "$HERDR_STUB_LOG" 2>/dev/null)" ]; then
  ok "and no desktop notification is fired"
else bad "and no desktop notification is fired" "$(grep '^NOTIFY' "$HERDR_STUB_LOG")"; fi
case "$(TW list 2>&1)" in *"IN CONVERSATION"*) ok "'list' reads as a conversation, not a stalled task" ;;
  *) bad "'list' reads as a conversation, not a stalled task" "$(TW list 2>&1)" ;; esac
case "$(TW list 2>&1)" in *"skills: both"*) ok "'list' shows which skills the session was given" ;;
  *) bad "'list' shows which skills the session was given" "$(TW list 2>&1)" ;; esac

# turn 2: the human types, it works, it goes idle again. Still not news, and
# the ledger must not grow a line per turn.
pi_session mid-tool e6; seq_state "$AID" working 222
wait_watcher_rearmed 1
pi_session completed e7; seq_state "$AID" idle 223
dwell
is "a second conversational turn still records no settle" "$(settles)" "0"
is "still no wake" "$(dwakes)" "0"
is "and does not spam the ledger (one record per conversation)" "$(convos)" "1"
stop_watchers
}

# ===========================================================================
sect_23() {
section "23. brainstorm: the AGENT dying is NOT a conversational pause"
# The dangerous failure mode of the suppression above: swallowing a real crash
# because "brainstorm sessions are always idle". Only cause=completed is a
# conversation; everything else still wakes.
setup; brainstorm_ledger grill
seq_state "$AID" working 230; pi_session mid-tool
start_watcher
wait_watcher_armed
pi_session crash; seq_state "$AID" idle 231          # provider/agent failure
wait_settles 1
dwell                                                # exactly-once: no duplicate
got_s="$(settles)"; got_w="$(dwakes)"
stop_watchers
is "an agent-error settle in a brainstorm session IS recorded" "$got_s" "1"
is "and DOES wake Dispatch" "$got_w" "1"
is "and is not filed as a conversation" "$(convos)" "0"
if grep -q '"cause": *"agent-error"' "$SANDBOX/.dispatch/ledger.jsonl"; then
  ok "the cause is recorded on the settle event"
else bad "the cause is recorded on the settle event" "$(ledger | tail -1)"; fi

# a session that dies mid tool-loop is ambiguous -> still wakes (bias to waking)
setup; brainstorm_ledger both; seq_state "$AID" idle 232; pi_session mid-tool
TW notify-settle "$AID" --by watcher --status awaiting-dispatch --classify >/dev/null 2>&1
is "an ambiguous settle still wakes, even in brainstorm mode" "$(dwakes)" "1"

# and the human stopping it is still a pause, not a conversation
setup; brainstorm_ledger both; seq_state "$AID" idle 233; pi_session human
TW notify-settle "$AID" --by watcher --status awaiting-dispatch --classify >/dev/null 2>&1
is "a human /stop is still recorded as paused-by-human" "$(pauses)" "1"
is "and still does not wake" "$(dwakes)" "0"
}

# ===========================================================================
sect_24() {
section "24. wrapup: one report, one wake, then auto-close"
# A UNIQUE task id: the teardown at the end of this section pkills the task's
# watcher by name, which would otherwise reach into concurrently-running
# sections that share the default id.
AID="brainstorm-wrapup-xyz"

# wrapup only applies to a dialogue
setup; seq_state "$AID" idle 240                     # setup() writes a CODE task
out="$(TW wrapup "$AID" 2>&1)"; rc=$?
is "wrapup on a non-brainstorm task is refused" "$rc" "1"
case "$out" in *brainstorm*) ok "and the error says wrapup is for brainstorm sessions" ;;
  *) bad "and the error says wrapup is for brainstorm sessions" "$out" ;; esac
is "and it prompts nobody" "$(wakes)" "0"
is "and records nothing" "$(settles)" "0"

# an unknown task is refused too
out="$(TW wrapup no-such-task 2>&1)"; rc=$?
is "wrapup on an unknown task is refused" "$rc" "1"

# a brainstorm session with no live agent cannot be asked anything
setup; brainstorm_ledger both; rm -f "$HERDR_STUB_STATE/$AID"
out="$(TW wrapup "$AID" 2>&1)"; rc=$?
is "wrapup on a dead session is refused" "$rc" "1"
case "$out" in *"no live agent"*) ok "and says the session is gone" ;;
  *) bad "and says the session is gone" "$out" ;; esac

# the real path
setup; brainstorm_ledger both; seq_state "$AID" idle 241
TW wrapup "$AID" >/dev/null 2>&1
is "wrapup succeeds on a live brainstorm session" "$?" "0"
is "it asks the SESSION (not Dispatch) for the plan" "$(agent_prompts)" "1"
is "and does not wake Dispatch by itself" "$(dwakes)" "0"
case "$(grep "^PROMPT	$AID" "$HERDR_STUB_LOG")" in *"WRAP-UP REQUEST"*) ok "the ask is a wrap-up request" ;;
  *) bad "the ask is a wrap-up request" "$(grep "^PROMPT	$AID" "$HERDR_STUB_LOG")" ;; esac
for want in Decided Rejected 'Open questions' 'Next tasks'; do
  case "$(grep "^PROMPT	$AID" "$HERDR_STUB_LOG")" in *"$want"*) ok "the ask names the '$want' section" ;;
    *) bad "the ask names the '$want' section" ;; esac
done
if grep -q '"status": *"wrapping-up"' "$SANDBOX/.dispatch/ledger.jsonl"; then
  ok "the request is recorded durably as wrapping-up"
else bad "the request is recorded durably as wrapping-up" "$(ledger | tail -1)"; fi

# ...which LIFTS the conversational-idle suppression: a session that writes its
# plan and then forgets to call 'done' must still be caught by the backstop.
pi_session completed; seq_state "$AID" idle 242
TW notify-settle "$AID" --by watcher --status awaiting-dispatch --classify >/dev/null 2>&1
is "after wrapup, an idle session is news again (backstop still covers it)" "$(settles)" "1"
is "and it is NOT filed as a conversation" "$(convos)" "0"

# the session delivers through the ORDINARY done path (no second mechanism)
setup; brainstorm_ledger both; seq_state "$AID" idle 243
TW wrapup "$AID" >/dev/null 2>&1
printf '# Plan\n\n## Decided\nx\n' > "$SANDBOX/plan.md"
seq_state "$AID" working 244
TW done "$AID" --note "plan delivered" --body-file "$SANDBOX/plan.md" >/dev/null 2>&1
is "the session's 'done' records exactly one settle" "$(settles)" "1"
is "and wakes Dispatch exactly once" "$(dwakes)" "1"
if [ -f "$(rep_exec)" ]; then ok "the plan is durable at reports/<date>-<id>.executor.md"
else bad "the plan is durable at reports/<date>-<id>.executor.md" "$(ls "$SANDBOX/reports")"; fi

# Dispatch persists it -> exactly one report, and the task auto-closes
TW report "$AID" --status awaiting-review --note "the plan" \
  --body-file "$(rep_exec)" >/dev/null 2>&1
is "report writes exactly one report event" "$(reports_n)" "1"
if [ -f "$(rep_md)" ]; then ok "the plan lands at reports/<date>-<id>.md"
else bad "the plan lands at reports/<date>-<id>.md" "$(ls "$SANDBOX/reports")"; fi
case "$(cat "$(rep_md)")" in *'## Decided'*) ok "and it is the session's own plan" ;;
  *) bad "and it is the session's own plan" "$(cat "$(rep_md)")" ;; esac
if grep -q '"event": *"closed"' "$SANDBOX/.dispatch/ledger.jsonl"; then
  ok "the task AUTO-CLOSES on report (like investigate)"
else bad "the task AUTO-CLOSES on report (like investigate)" "$(ledger | tail -1)"; fi
if [ ! -d "$SANDBOX/tasks/$AID" ]; then ok "and its ephemeral task dir is gone"
else bad "and its ephemeral task dir is gone"; fi
is "and the whole wrap-up woke Dispatch exactly once" "$(dwakes)" "1"
}

# ===========================================================================
sect_25() {
section "25. create --mode brainstorm: the skills are CHOSEN, never assumed"
setup; brainstorm_sandbox; mk_repo widget

# no selection -> refuse, and tell the orchestrator to ASK rather than guess
out="$(TW create --slug bs --repo widget --mode brainstorm --no-agent 2>&1)"; rc=$?
is "--mode brainstorm without --skill is refused" "$rc" "1"
case "$out" in *"ASK THE HUMAN"*) ok "and the error tells Dispatch to ask the human" ;;
  *) bad "and the error tells Dispatch to ask the human" "$out" ;; esac
case "$out" in *"do NOT default to 'both'"*) ok "and forbids defaulting to both" ;;
  *) bad "and forbids defaulting to both" "$out" ;; esac
is "and nothing is created for it" "$(grep -c '^WORKTREE' "$HERDR_STUB_LOG" | tr -d ' ')" "0"

out="$(TW create --slug bs --repo widget --mode brainstorm --skill bogus --no-agent 2>&1)"; rc=$?
is "an unknown --skill is refused" "$rc" "1"
out="$(TW create --slug bs --repo widget --mode code --skill both --no-agent 2>&1)"; rc=$?
is "--skill outside brainstorm mode is refused" "$rc" "1"

# each selection briefs the session with THAT skill's guidance and no other
for sel in brainstorm grill both; do
  setup; brainstorm_sandbox; mk_repo widget
  TW create --slug bs --repo widget --mode brainstorm --skill "$sel" >/dev/null 2>&1
  brief="$(grep '^PROMPT' "$HERDR_STUB_LOG" | head -1)"
  has_b=no; has_g=no
  case "$brief" in *'Skill: brainstorming'*) has_b=yes ;; esac
  case "$brief" in *'Skill: grilling'*) has_g=yes ;; esac
  case "$sel" in
    brainstorm) is "--skill brainstorm briefs brainstorming" "$has_b" "yes"
                is "--skill brainstorm does NOT brief grilling" "$has_g" "no" ;;
    grill)      is "--skill grill briefs grilling" "$has_g" "yes"
                is "--skill grill does NOT brief brainstorming" "$has_b" "no" ;;
    both)       is "--skill both briefs brainstorming" "$has_b" "yes"
                is "--skill both briefs grilling" "$has_g" "yes" ;;
  esac
  case "$brief" in *'one question at a time'*|*'One question at a time'*)
      ok "--skill $sel keeps the shared dialogue frame" ;;
    *) bad "--skill $sel keeps the shared dialogue frame" "$brief" ;; esac
done

# the selection is visible afterwards: task.env + ledger, and create says how
# the human reaches the session at all (the entire point of the mode)
setup; brainstorm_sandbox; mk_repo widget
err="$(TW create --slug bs --repo widget --mode brainstorm --skill grill 2>&1 >"$SANDBOX/id.out")"
id="$(cat "$SANDBOX/id.out")"
env_file="$SANDBOX/tasks/$id/task.env"
is "task.env records the mode" "$(. "$env_file" 2>/dev/null; echo "${TASK_MODE:-}")" "brainstorm"
is "task.env records the skill selection" "$(. "$env_file" 2>/dev/null; echo "${TASK_SKILLS:-}")" "grill"
case "$(cat "$SANDBOX/.dispatch/ledger.jsonl")" in *'"skills": "grill"'*) ok "the ledger records the selection" ;;
  *) bad "the ledger records the selection" "$(tail -1 "$SANDBOX/.dispatch/ledger.jsonl")" ;; esac
case "$err" in *"herdr agent focus $id"*) ok "create prints how the human attaches to the pane" ;;
  *) bad "create prints how the human attaches to the pane" "$err" ;; esac
case "$err" in *"wrapup $id"*) ok "and how the session is ended" ;;
  *) bad "and how the session is ended" "$err" ;; esac
case "$(TW create --help 2>&1)" in *--skill*) ok "create --help documents --skill" ;;
  *) bad "create --help documents --skill" ;; esac
case "$(TW create --help 2>&1)" in *brainstorm*) ok "create --help documents the brainstorm mode" ;;
  *) bad "create --help documents the brainstorm mode" ;; esac

# --pr is code work, not a dialogue
out="$(TW create --repo widget --pr 7 --mode brainstorm --skill both --no-agent 2>&1)"; rc=$?
is "--pr with --mode brainstorm is refused" "$rc" "1"
}

# ===========================================================================
sect_26() {
section "26. autopilot: an executor may babysit ITS OWN PR, in-lane"
# The episode this exists for: an executor was told "run autopilot" by the human
# in its own pane and had to refuse, because autopilot only existed as a
# Dispatch-level mode. The verb sanctions the loop WITHOUT giving the executor
# any of the plumbing it must never have (no spawn, no herdr), and renders the
# brief from the SAME template as `create --pr` so the two cannot drift.

# ---- happy path: the PR is on this task's own branch ----------------------
setup; pr_sandbox; mk_repo widget feature-x; pr_fixture 7 OPEN feature-x
id="$(TW create --repo widget --pr 7 --no-agent 2>/dev/null)"
: > "$HERDR_STUB_LOG"                 # forget create's calls; the verb must add none
ledger_before="$(grep -c '"event"' "$SANDBOX/.dispatch/ledger.jsonl" | tr -d ' ')"
brief="$(TW autopilot 7 --task "$id" 2>"$SANDBOX/ap.err")"; rc=$?
is "autopilot renders a brief for an open PR on this branch" "$rc" "0"
for want in 'feature-x' 'https://github.com/acme/widget/pull/7' 'gh pr checks' 'Never'; do
  case "$brief" in *"$want"*) ok "the brief is substituted with: $want" ;;
    *) bad "the brief is substituted with: $want" "$brief" ;; esac
done
# It is a PRINTER, not a spawner: no worktree, no agent, no wake, nothing.
is "autopilot touches herdr not at all" "$(grep -c . "$HERDR_STUB_LOG" | tr -d ' ')" "0"
is "and adds no ledger event" \
   "$(grep -c '"event"' "$SANDBOX/.dispatch/ledger.jsonl" | tr -d ' ')" "$ledger_before"
case "$(cat "$SANDBOX/ap.err")" in *'do NOT spawn tasks or call herdr'*)
    ok "and says so on stderr" ;;
  *) bad "and says so on stderr" "$(cat "$SANDBOX/ap.err")" ;; esac

# ---- ONE definition of the loop: identical to what create --pr briefs ------
ledger_prompt="$(python3 - "$SANDBOX/.dispatch/ledger.jsonl" "$id" <<'PY'
import json, sys
for line in open(sys.argv[1]):
    o = json.loads(line)
    if o.get("id") == sys.argv[2] and o.get("event") == "created":
        sys.stdout.write(o.get("prompt") or "")
PY
)"
is "the brief is byte-identical to the one create --pr uses" \
   "$(printf '%s' "$brief")" "$(printf '%s' "$ledger_prompt")"

# ---- the PR number is optional: TASK_PR_NUMBER is on record ---------------
brief2="$(TW autopilot --task "$id" 2>/dev/null)"
is "with no argument it uses the task's own PR" "$brief2" "$brief"
# and a url works as well as a number
brief3="$(TW autopilot https://github.com/acme/widget/pull/7 --task "$id" 2>/dev/null)"
is "a PR url resolves the same way" "$brief3" "$brief"

# ---- an ordinary code task that grew a PR later: resolve by BRANCH --------
setup; pr_sandbox; mk_repo widget feature-x
printf '%s\n' '{"event":"created","id":"plain-1","slug":"plain","branch":"feature-x","primary_repo":"widget","mode":"code","status":"working","ts":"x"}' \
  > "$SANDBOX/.dispatch/ledger.jsonl"
pr_fixture 15 OPEN feature-x feature-x   # gh resolves a branch name to its PR
out="$(TW autopilot --task plain-1 2>/dev/null)"; rc=$?
is "a task with no PR on record resolves the PR for its branch" "$rc" "0"
case "$out" in *'PR #15'*) ok "and the brief names the PR it found" ;;
  *) bad "and the brief names the PR it found" "$out" ;; esac

# ---- REFUSAL 1: a PR on someone else's branch is out of lane --------------
setup; pr_sandbox; mk_repo widget feature-x other-branch
printf '%s\n' '{"event":"created","id":"plain-1","slug":"plain","branch":"feature-x","primary_repo":"widget","mode":"code","status":"working","ts":"x"}' \
  > "$SANDBOX/.dispatch/ledger.jsonl"
pr_fixture 12 OPEN other-branch
out="$(TW autopilot 12 --task plain-1 2>&1)"; rc=$?
is "a PR on another branch is refused" "$rc" "1"
case "$out" in *"owns 'feature-x'"*) ok "and the error names the task's own branch" ;;
  *) bad "and the error names the task's own branch" "$out" ;; esac
case "$out" in *'create --repo widget --pr 12'*) ok "and tells the human what to ask Dispatch for" ;;
  *) bad "and tells the human what to ask Dispatch for" "$out" ;; esac

# ---- REFUSAL 2: a PR that is not open -------------------------------------
pr_fixture 9 CLOSED feature-x
out="$(TW autopilot 9 --task plain-1 2>&1)"; rc=$?
is "a closed PR is refused" "$rc" "1"
case "$out" in *CLOSED*|*'not open'*) ok "and says the PR is not open" ;;
  *) bad "and says the PR is not open" "$out" ;; esac
out="$(TW autopilot 404 --task plain-1 2>&1)"; rc=$?
is "an unknown PR fails loudly" "$rc" "1"

# ---- REFUSAL 3: no task == no lane ----------------------------------------
out="$(cd "$SANDBOX" && TASK_ID= "$SANDBOX/bin/task-worktree" autopilot 7 2>&1)"; rc=$?
is "outside a task dir it refuses" "$rc" "1"
case "$out" in *'task id required'*) ok "and says a task id is required" ;;
  *) bad "and says a task id is required" "$out" ;; esac
out="$(TW autopilot 7 --task no-such-task 2>&1)"; rc=$?
is "an unknown task is refused" "$rc" "1"

# ---- discoverability -------------------------------------------------------
case "$(TW autopilot --help 2>&1)" in *'OWN branch'*) ok "autopilot --help states the own-branch rule" ;;
  *) bad "autopilot --help states the own-branch rule" ;; esac
case "$(TW autopilot --help 2>&1)" in *'NOT a licence to spawn tasks'*) ok "and that it is not a spawn licence" ;;
  *) bad "and that it is not a spawn licence" ;; esac
case "$(TW help 2>&1)" in *autopilot*) ok "the top-level usage lists autopilot" ;;
  *) bad "the top-level usage lists autopilot" ;; esac
}

# ===========================================================================
sect_27() {
section "26. durable reports are dated by the task's CREATION date"
AID="dated-reports-zzz"
CREATED_TS="2025-03-04T18:30:00Z"
LATER_TS="2025-06-09T18:30:00Z"
D0="$(local_date "$CREATED_TS")"
D1="$(local_date "$LATER_TS")"

# a ledger whose 'created' record carries a REAL timestamp
dated_ledger() {
  printf '%s\n' "{\"event\":\"created\",\"id\":\"$AID\",\"slug\":\"demo\",\"branch\":\"demo\",\"primary_repo\":\"none\",\"mode\":\"code\",\"dispatch_pane\":\"wDISPATCH:p1\",\"status\":\"working\",\"ts\":\"$CREATED_TS\"}" \
    > "$SANDBOX/.dispatch/ledger.jsonl"
}
body() { printf '# body\n' > "$SANDBOX/body.md"; printf '%s' "$SANDBOX/body.md"; }

# --- the prefix is the creation date, and both files share it ---------------
setup; dated_ledger; seq_state "$AID" working 260
TW done "$AID" --note n --body-file "$(body)" >/dev/null 2>&1
if [ -f "$(rep_exec "$AID" "$D0")" ]; then ok "the executor report is reports/$D0-<id>.executor.md"
else bad "the executor report is reports/$D0-<id>.executor.md" "$(ls "$SANDBOX/reports")"; fi
TW report "$AID" --note n --body "x" >/dev/null 2>&1
if [ -f "$(rep_md "$AID" "$D0")" ]; then ok "the final report is reports/$D0-<id>.md"
else bad "the final report is reports/$D0-<id>.md" "$(ls "$SANDBOX/reports")"; fi
is "the task has exactly two report files" "$(rep_all "$AID")" "2"
if [ "$(ls "$SANDBOX/reports" | sed 's/-'"$AID"'.*//' | sort -u)" = "$D0" ]; then
  ok "and both halves of the task share ONE prefix"
else bad "and both halves of the task share ONE prefix" "$(ls "$SANDBOX/reports")"; fi
is "the prefix is strictly YYYY-MM-DD" \
  "$(ls "$SANDBOX/reports" | grep -c '^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-' | tr -d ' ')" "2"

# --- the path the LEDGER and the WAKE name is the path on disk -------------
if grep -q "reports/$D0-$AID.executor.md" "$SANDBOX/.dispatch/ledger.jsonl"; then
  ok "the ledger records the dated path"
else bad "the ledger records the dated path" "$(ledger | tail -2)"; fi
if grep -q "reports/$D0-$AID.executor.md" "$HERDR_STUB_LOG"; then
  ok "and the wake tells Dispatch the same dated path"
else bad "and the wake tells Dispatch the same dated path" "$(cat "$HERDR_STUB_LOG")"; fi

# --- a SECOND settle rewrites the same file, it does not make a new one -----
seq_state "$AID" working 261
TW done "$AID" --force --note "round two" --body-file "$(body)" >/dev/null 2>&1
is "a second settle records a second settle event" "$(settles)" "2"
is "but still exactly two report files" "$(rep_all "$AID")" "2"
TW report "$AID" --note "round two" --body "x" >/dev/null 2>&1
is "and a second report does not fork the filename either" "$(rep_all "$AID")" "2"

# --- a HANDOFF keeps the ORIGINAL creation date ----------------------------
printf '%s\n' "{\"event\":\"handoff\",\"id\":\"$AID\",\"branch\":\"demo\",\"primary_repo\":\"none\",\"mode\":\"code\",\"dispatch_pane\":\"wDISPATCH:p1\",\"ts\":\"$LATER_TS\"}" \
  >> "$SANDBOX/.dispatch/ledger.jsonl"
seq_state "$AID" working 262
TW done "$AID" --force --note "after handoff" --body-file "$(body)" >/dev/null 2>&1
TW report "$AID" --note "after handoff" --body "x" >/dev/null 2>&1
is "a handed-off task keeps its original date (no $D1 file)" "$(rep_all "$AID")" "2"
if [ -f "$(rep_exec "$AID" "$D0")" ] && [ ! -f "$(rep_exec "$AID" "$D1")" ]; then
  ok "the handoff's own date is NOT used"
else bad "the handoff's own date is NOT used" "$(ls "$SANDBOX/reports")"; fi

# --- legacy un-prefixed files are tolerated, not orphaned or duplicated -----
setup; dated_ledger; seq_state "$AID" working 263
mkdir -p "$SANDBOX/reports"; printf 'old\n' > "$SANDBOX/reports/$AID.md"
TW report "$AID" --note n --body "fresh" >/dev/null 2>&1
is "an un-prefixed legacy report is rewritten in place, not twinned" "$(rep_all "$AID")" "1"
case "$(cat "$SANDBOX/reports/$AID.md")" in *fresh*) ok "and it is the new content" ;;
  *) bad "and it is the new content" "$(cat "$SANDBOX/reports/$AID.md")" ;; esac
TW done "$AID" --note n --body-file "$(body)" >/dev/null 2>&1
if [ -f "$SANDBOX/reports/$AID.executor.md" ]; then
  ok "and the task's other half stays on the same (legacy) prefix"
else bad "and the task's other half stays on the same (legacy) prefix" "$(ls "$SANDBOX/reports")"; fi
}

# Longest sections FIRST: with bounded concurrency the makespan is dominated by
# whatever starts last, so the live-watcher cases (the only ones that dwell) go
# out of the gate first and the cheap ones backfill around them.
# TASK_SELFTEST_SECTIONS narrows a run to named sections while debugging one;
# unset (the default, and the gate) is every section.
SECTION_ORDER="${TASK_SELFTEST_SECTIONS:-5 16 18 22 8 20 6 17 23 15 7 9 11 2 19 12 3 1 14 4 10 13 21 25 26 27 24 0}"

# ---------------------------------------------------------------------------
# the runner
#
# Every section runs in its own subshell against its own sandbox + its own stub
# state/log (see setup()), so there is nothing left to serialise them for. Each
# writes its output and its pass/fail/elapsed tally to a file; the parent then
# replays them in the CANONICAL order, so the transcript is identical whatever
# the concurrency is. -j1 is exactly the old serial behaviour.
# ---------------------------------------------------------------------------
RESDIR="$TMPROOT/results"; mkdir -p "$RESDIR"

_run_one() {
  local n="$1" t0
  # A child must NEVER inherit the parent's cleanup trap, or the first section
  # to finish would delete the whole run's TMPROOT out from under the others.
  trap - EXIT
  CASE_PREFIX="$n"; CASE_SEQ=0
  t0="$(_ms)"
  {
    "sect_$n"
    stop_watchers
  } > "$RESDIR/$n.out" 2>&1
  printf '%s %s %s\n' "$PASS" "$FAIL" "$(( $(_ms) - t0 ))" > "$RESDIR/$n.tally"
}

_live_jobs() {
  local p c=0
  for p in $RUN_PIDS; do kill -0 "$p" 2>/dev/null && c=$((c + 1)); done
  printf '%s\n' "$c"
}

RUN_PIDS=""
for n in $SECTION_ORDER; do
  if [ "$JOBS" -gt 1 ]; then
    while [ "$(_live_jobs)" -ge "$JOBS" ]; do sleep 0.02; done
    _run_one "$n" & RUN_PIDS="$RUN_PIDS $!"
  else
    ( _run_one "$n" )
  fi
done
wait

# replay in canonical order and tally
TIMINGS=""
SECTION_FAILS=""
for n in $(printf '%s\n' $SECTION_ORDER | sort -n); do
  if [ -s "$RESDIR/$n.tally" ]; then
    cat "$RESDIR/$n.out"
    read -r p f el < "$RESDIR/$n.tally"
    PASS=$((PASS + p)); FAIL=$((FAIL + f))
    TIMINGS="$TIMINGS$el	section $n\n"
    SECTION_FAILS="$SECTION_FAILS$n=$f "
  else
    printf '\n  \033[31mFAIL\033[0m section %s produced no result (it crashed)\n' "$n"
    [ -f "$RESDIR/$n.out" ] && cat "$RESDIR/$n.out"
    FAIL=$((FAIL + 1))
  fi
done

# section_failed <n> -> rc 0 if section <n> recorded at least one failure
section_failed() {
  case " $SECTION_FAILS" in *" $1=0 "*) return 1 ;; *" $1="*) return 0 ;; esac
  return 1
}

timing_report() {
  local total=$(( $(_ms) - RUN_T0 ))
  printf '\n\033[1mtiming breakdown\033[0m (section wall-clock, slowest first; -j%s)\n' "$JOBS"
  printf "$TIMINGS" | sort -rn | awk -F'\t' '$0 != "" {printf "  %7.2fs  %s\n", $1/1000, $2}'
  printf '  %7.2fs  \033[1mTOTAL (wall clock)\033[0m\n' "$(awk -v t="$total" 'BEGIN{print t/1000}')"
}

timing_report
printf '\n\033[1m%d passed, %d failed\033[0m\n\n' "$PASS" "$FAIL"

if [ "$FALSIFY" -eq 1 ]; then
  if section_failed 5; then
    printf '\033[32mFALSIFICATION OK\033[0m: section 5 caught the broken watcher (%d failures overall).\n\n' "$FAIL"
    exit 0
  fi
  if [ "$(cat "$RESDIR/falsify.armed" 2>/dev/null)" != "yes" ]; then
    printf '\033[33mFALSIFICATION INCONCLUSIVE\033[0m: the bug never reproduced.\n'
    printf 'The sabotaged watcher was so slow to start (heavy load on this host) that\n'
    printf 'section 5 had already set the agent working before it armed — so it\n'
    printf 'witnessed a real work phase and behaved CORRECTLY by accident. This says\n'
    printf 'nothing about the %ss dwell. Re-run on an unloaded machine.\n\n' "$DWELL"
    exit 2
  fi
  printf '\033[31mFALSIFICATION FAILED\033[0m: a watcher that armed its settle loop WITHOUT\n'
  printf 'witnessing a work phase still passed section 5. The %ss dwell is too short —\n' "$DWELL"
  printf 'its negative assertions are vacuous and no longer detect the bug they exist for.\n\n'
  exit 1
fi
[ "$FAIL" -eq 0 ]
