#!/usr/bin/env bash
#
# task-worktree-selftest — exercises the completion machinery of task-worktree
# against a scripted fake herdr, so the watcher is TESTED rather than eyeballed.
#
# It covers the two failure modes that previously bit us:
#   * the multi-value `--until idle done blocked` invocation (herdr rc=2), which
#     silently turned every settle probe into "false" and made the watcher spin
#     forever without recording anything, and
#   * the boot transient, where a freshly-booted agent reads idle/done BEFORE it
#     starts working and can trigger a FALSE settle, and
#   * the HUMAN-INTERRUPT false settle: the human stopping an executor (pi
#     /stop / Esc) also makes herdr report 'idle', which used to wake Dispatch
#     with a half-finished task.
# plus the exactly-once + re-arming guarantees of the settle claim.
#
# Usage: bin/task-worktree-selftest [-v]
#
# The fake herdr mirrors the REAL CLI contract, verified against live agents:
#   agent wait  --until <ONE status>, REPEAT for more; a second bare word is
#               "unknown option: <word>" with exit code 2.
#               rc 0 matched | rc 1 timeout/not-found | rc 2 bad invocation.
#   agent get   prints agent_status + state_change_seq + cwd + agent kind,
#               rc 1 when not found.
#
# The settle CLASSIFIER is exercised against fixture pi session logs whose
# stopReason/errorMessage pairs are copied verbatim from real recorded pi
# sessions (see the table in task-worktree).
set -uo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/task-worktree"
VERBOSE=0
FALSIFY=0
FALSIFY_KEEP_DEBOUNCE=0
# Section-level concurrency. Sections are fully independent (own sandbox, own
# stub state, own watcher pids), and they are dominated by WAITING rather than
# by CPU, so running them concurrently is close to free. Capped rather than
# unbounded: the negative assertions are timing-sensitive, and a machine that
# is oversubscribed makes a BROKEN watcher look slow, which is precisely the
# way a dwell goes vacuous.
JOBS="${TASK_SELFTEST_JOBS:-6}"
for arg in "$@"; do
  case "$arg" in
    -v) VERBOSE=1 ;;
    -j) printf -- '-j takes an attached value, e.g. -j4\n' >&2; exit 2 ;;
    -j*) JOBS="${arg#-j}" ;;
    --falsify) FALSIFY=1 ;;
    --falsify-witness) FALSIFY=1; FALSIFY_KEEP_DEBOUNCE=1 ;;
    -h|--help)
      printf 'usage: task-worktree-selftest [-v] [-jN] [--falsify]\n'
      printf '  -v         verbose notes\n'
      printf '  -jN        run N sections concurrently (default %s; -j1 = serial)\n' "$JOBS"
      printf '  --falsify  disable the watcher boot-transient defences and assert\n'
      printf '             the suite CATCHES it (proves the dwells are not vacuous)\n'
      printf '  --falsify-witness  as --falsify but leaves the debounce hold in\n'
      printf '             place — a SLOWER false settle, i.e. the harder case\n'
      printf '\n  TASK_SELFTEST_SECTIONS="26 21"  run only those sections (debugging;\n'
      printf '             a full run is still the gate — the default is every section)\n'
      exit 0 ;;
    *) printf 'unknown arg: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

PASS=0; FAIL=0
ok()   { PASS=$((PASS+1)); printf '  \033[32mok\033[0m   %s\n' "$1"; }
bad()  { FAIL=$((FAIL+1)); printf '  \033[31mFAIL\033[0m %s\n' "$1"; [ -n "${2:-}" ] && printf '       %s\n' "$2"; }
is()   { if [ "$2" = "$3" ]; then ok "$1"; else bad "$1" "expected '$3', got '$2'"; fi; }
note() { [ "$VERBOSE" -eq 1 ] && printf '       · %s\n' "$*"; return 0; }

# ---------------------------------------------------------------------------
# timing instrumentation — a per-section wall-clock breakdown, so "the suite is
# slow" is always a measurement rather than a guess. Costs one perl spawn per
# section (~15ms total across the run).
# ---------------------------------------------------------------------------
if command -v perl >/dev/null 2>&1; then
  _ms() { perl -MTime::HiRes=time -e 'printf "%.0f\n", time()*1000'; }
else
  _ms() { python3 -c 'import time;print(int(time.time()*1000))'; }
fi
RUN_T0="$(_ms)"
section() { printf '\n\033[1m%s\033[0m\n' "$1"; }

TMPROOT="$(mktemp -d "${TMPDIR:-/tmp}/tw-selftest.XXXXXX")"
# TASK_SELFTEST_KEEP=1 leaves the sandboxes behind for post-mortem inspection.
trap 'pkill -f "$TMPROOT" >/dev/null 2>&1; [ "${TASK_SELFTEST_KEEP:-0}" = 1 ] && printf "\nsandboxes kept: %s\n" "$TMPROOT" || rm -rf "$TMPROOT"' EXIT

# ---------------------------------------------------------------------------
# the fake herdr
# ---------------------------------------------------------------------------
STUB_BIN="$TMPROOT/stub"
mkdir -p "$STUB_BIN"
cat > "$STUB_BIN/herdr" <<'STUB'
#!/usr/bin/env bash
# Fake herdr. State lives in $HERDR_STUB_STATE/<agent> as "<status> <seq>".
set -uo pipefail
S="$HERDR_STUB_STATE"; LOG="$HERDR_STUB_LOG"
read_state() { [ -f "$S/$1" ] || return 1; cat "$S/$1"; }

case "${1:-}" in
agent)
  sub="${2:-}"; shift 2
  case "$sub" in
  get)
    st="$(read_state "${1:-}")" || { echo '{"error":{"code":"agent_not_found"}}'; exit 1; }
    set -- $st
    printf '{"id":"cli:agent:get","result":{"agent":{"agent":"%s","agent_status":"%s","state_change_seq":%s,"name":"x","pane_id":"p1","cwd":"%s"}}}\n' \
      "${HERDR_STUB_AGENT:-pi}" "$1" "$2" "${HERDR_STUB_CWD:-/x}"
    ;;
  list)
    printf '{"result":{"agents":['; sep=""
    for f in "$S"/*; do
      [ -e "$f" ] || continue
      set -- $(cat "$f")
      printf '%s{"agent":"pi","agent_status":"%s","state_change_seq":%s,"name":"%s","pane_id":"p1","cwd":"/x"}' "$sep" "$1" "$2" "$(basename "$f")"
      sep=","
    done
    printf ']}}\n'
    ;;
  wait)
    target=""; timeout=""; want=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --until)
          case "$2" in
            idle|working|blocked|done|unknown) want="$want $2"; shift 2 ;;
            *) echo "unknown option: $2" >&2; exit 2 ;;
          esac ;;
        --timeout) timeout="$2"; shift 2 ;;
        -*) echo "unknown option: $1" >&2; exit 2 ;;
        *)
          # REAL herdr behaviour: exactly one positional target. A second bare
          # word (as produced by `--until idle done blocked`) is a hard error.
          if [ -n "$target" ]; then echo "unknown option: $1" >&2; exit 2; fi
          target="$1"; shift ;;
      esac
    done
    [ -n "$want" ] || want=" idle done blocked"          # bare wait default
    deadline_ms="${timeout:-${HERDR_STUB_MAXWAIT_MS:-20000}}"
    # Poll granularity. This is the stub's own latency floor: every state
    # transition the watcher reacts to costs up to one tick, so it is a knob
    # rather than a hardcoded 100ms.
    poll_ms="${HERDR_STUB_POLL_MS:-100}"
    poll_s="$(awk -v m="$poll_ms" 'BEGIN{printf "%.3f", m/1000}')"
    waited=0
    while :; do
      st="$(read_state "$target")" || { echo '{"error":{"code":"agent_not_found"}}'; exit 1; }
      set -- $st
      for w in $want; do
        [ "$w" = "$1" ] && { printf '{"result":{"agent":{"agent_status":"%s"}}}\n' "$1"; exit 0; }
      done
      [ "$waited" -ge "$deadline_ms" ] && { echo '{"error":{"code":"timeout"}}'; exit 1; }
      sleep "$poll_s"; waited=$((waited + poll_ms))
    done
    ;;
  prompt)
    # One log LINE per prompt (newlines flattened), so `grep '^PROMPT'` counts
    # wakes correctly even for a multi-line brief such as the autopilot one.
    { printf 'PROMPT\t%s\t' "${1:-}"; printf '%s' "${2:-}" | tr '\n' ' '; printf '\n'; } >> "$LOG"
    echo '{"result":{}}' ;;
  read)   echo '{"result":{}}' ;;
  *)      echo '{"result":{}}' ;;
  esac ;;
worktree)
  sub="${2:-}"; shift 2
  case "$sub" in
  create)
    path=""; branch=""; wbase=""; label=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --path)   path="$2"; shift 2 ;;
        --branch) branch="$2"; shift 2 ;;
        --base)   wbase="$2"; shift 2 ;;
        --label)  label="$2"; shift 2 ;;
        --cwd)    shift 2 ;;
        *)        shift ;;
      esac
    done
    mkdir -p "$path"
    printf 'WORKTREE\t%s\t%s\t%s\t%s\n' "$label" "$branch" "$wbase" "$path" >> "$LOG"
    printf '{"result":{"workspace":{"workspace_id":"ws-%s"},"worktree":{"path":"%s","branch":"%s"}}}\n' \
      "$label" "$path" "$branch"
    ;;
  *) echo '{"result":{}}' ;;
  esac ;;
workspace)
  sub="${2:-}"; shift 2
  case "$sub" in
  create)
    printf '{"result":{"workspace":{"workspace_id":"ws-exec"},"root_pane":{"pane_id":"wX:p9"}}}\n' ;;
  *) echo '{"result":{}}' ;;
  esac ;;
notification) printf 'NOTIFY\t%s\n' "$*" >> "$LOG"; echo '{"result":{}}' ;;
*) echo '{"result":{}}' ;;
esac
exit 0
STUB
chmod +x "$STUB_BIN/herdr"

# ---------------------------------------------------------------------------
# the fake gh — `create --pr` resolves PRs through the GitHub CLI.
#
# Mirrors the real contract we depend on:
#   gh pr view <n> --repo <owner/name> --json number,state,headRefName,url
#     rc 0 + a JSON object when the PR exists
#     rc 1 + "no pull requests found" on stderr when it does not
# Fixtures live in $GH_STUB_STATE/<n>.json (see pr_fixture).
# ---------------------------------------------------------------------------
cat > "$STUB_BIN/gh" <<'STUB'
#!/usr/bin/env bash
set -uo pipefail
printf 'GH\t%s\n' "$*" >> "${GH_STUB_LOG:-/dev/null}"
if [ "${1:-}" = pr ] && [ "${2:-}" = view ]; then
  n="${3:-}"
  f="${GH_STUB_STATE:-/nonexistent}/$n.json"
  if [ -f "$f" ]; then cat "$f"; exit 0; fi
  echo "no pull requests found for \"$n\"" >&2; exit 1
fi
echo '{}'
exit 0
STUB
chmod +x "$STUB_BIN/gh"

export PATH="$STUB_BIN:$PATH"
# Defaults, so a probe made before the first setup() still works. Every case
# overrides these with its OWN sandbox-scoped pair (see setup()).
export HERDR_STUB_STATE="$TMPROOT/state"
export HERDR_STUB_LOG="$TMPROOT/herdr.log"
mkdir -p "$HERDR_STUB_STATE"; : > "$HERDR_STUB_LOG"
CASE_SEQ=0
CASE_PREFIX="x"          # set per section by the runner; keeps sandboxes unique

# ---------------------------------------------------------------------------
# TEST-ONLY TIMING. Every one of these is an env knob on the PRODUCTION code
# whose default is unchanged; we only drive the watcher faster here. Nothing
# below weakens an assertion — the watcher still performs every debounce,
# witness and re-probe step, just on a millisecond clock instead of a
# multi-second one.
# ---------------------------------------------------------------------------
export HERDR_STUB_POLL_MS=20          # stub's state-file poll granularity
export HERDR_STUB_MAXWAIT_MS=4000
export TASK_WATCH_DEBOUNCE=0.15       # prod default 5s
export TASK_WATCH_WITNESS_TRIES=3           # prod default 6
export TASK_WATCH_PROBE_TIMEOUT_MS=500      # prod default 60000
export TASK_WATCH_RESUME_TIMEOUT_MS=300     # prod default 30000
export TASK_WATCH_WITNESS_TIMEOUT_MS=2000   # prod default 30000
export TASK_WATCH_REARM_BACKOFF_S=1         # prod default 30
export TASK_WAKE_RETRY_SLEEP_S=0.1          # prod default 10
# The re-probe waits above are short, so a legitimately long 'working' phase
# burns spins much faster than in production. Raise the safety valve to match,
# so no test can trip a FALSE abort. (Section 9 still proves the loud-failure
# path via the agent-vanished route, which is spin-independent.)
export TASK_WATCH_MAX_SPINS=10000

# ---------------------------------------------------------------------------
# CONDITION WAITS — the reason this suite is seconds rather than minutes.
#
# A fixed `sleep N` has to be the WORST case, so every case pays worst case
# every run. A condition wait pays the ACTUAL latency and only falls back to a
# generous timeout when something is broken (in which case the assertion after
# it fails, exactly as before).
#
# wait_until <shell-predicate> [timeout_s]  -> rc 0 as soon as it holds
# ---------------------------------------------------------------------------
WAIT_TIMEOUT_S="${WAIT_TIMEOUT_S:-15}"     # generous: only reached when BROKEN
WAIT_POLL_S=0.025
wait_until() {
  local pred="$1" timeout="${2:-$WAIT_TIMEOUT_S}" i=0 max
  max="$(awk -v t="$timeout" 'BEGIN{printf "%d", t/0.025}')"
  while [ "$i" -lt "$max" ]; do
    if eval "$pred" >/dev/null 2>&1; then return 0; fi
    sleep "$WAIT_POLL_S"; i=$((i + 1))
  done
  note "wait_until TIMED OUT after ${timeout}s: $pred"
  return 1
}
wait_settles() { wait_until "[ \"\$(settles)\" -ge $1 ]" "${2:-}"; }
wait_pauses()  { wait_until "[ \"\$(pauses)\" -ge $1 ]"  "${2:-}"; }
wait_gone()    { wait_until "! kill -0 $1 2>/dev/null"   "${2:-}"; }

# ---------------------------------------------------------------------------
# DWELL — the one thing a condition wait CANNOT express.
#
# A NEGATIVE assertion ("no settle is recorded during the boot transient")
# is only meaningful if we genuinely gave the watcher long enough to get it
# wrong. There is no event to wait for, so these need real elapsed time — and
# this is the single tunable that governs all of them.
#
# How long is long enough? This is MEASURED, not guessed, via --falsify below.
# The measured dwell at which a broken watcher stops being detected:
#
#            bug variant                       serial (-j1)   concurrent (-j6)
#   both guards off (the real pre-fix bug)         0.35s            <1.5s
#   witness guard off, debounce kept (slowest)     0.8-1.0s         1.5-2.0s
#
# Concurrency matters because an oversubscribed machine makes the BROKEN
# watcher slower too, which is the one way a dwell silently goes vacuous. The
# default below is sized against the worst measured case (2.0s at the default
# concurrency), with ~25% headroom on top.
#
# None of this is assumed — it is re-provable at any time:
#   bin/task-worktree-selftest --falsify          # both guards off
#   bin/task-worktree-selftest --falsify-witness  # the slowest variant
# Both must report FALSIFICATION OK. If they do not, this dwell is too short
# and section 5's negative assertions no longer detect the bug they exist for.
# ---------------------------------------------------------------------------
DWELL="${TASK_SELFTEST_DWELL:-2.5}"
dwell() { sleep "$DWELL"; }

# ---------------------------------------------------------------------------
# FALSIFICATION MODE — proof that the dwell above is still long enough.
#
#   bin/task-worktree-selftest --falsify
#
# disables the watcher's TWO boot-transient defences (the witnessed-work-phase
# wait and the debounce hold) — i.e. it restores exactly the pre-fix watcher
# that fired a false settle off the boot transient. SECTION 5 MUST then FAIL.
# If it passes, the dwell has become too short and its negative assertions are
# vacuous, so this mode INVERTS its exit code: rc 0 means "the suite correctly
# detected the broken watcher".
#
# Both defences are plain env knobs on the production code, so nothing has to
# be monkey-patched: turning them off IS the bug.
#
# (Section 18 deliberately survives falsify mode and that is CORRECT, not
# vacuous: its boot transient is a human-interrupt, so the classifier suppresses
# the false settle even with the debounce gone. Section 18 guards the
# classifier; section 5 guards the debounce. Different bug, different test.)
# ---------------------------------------------------------------------------
if [ "$FALSIFY" -eq 1 ]; then
  export TASK_WATCH_WITNESS_TIMEOUT_MS=0      # never witness a work phase
  if [ "$FALSIFY_KEEP_DEBOUNCE" -eq 0 ]; then
    export TASK_WATCH_DEBOUNCE=0              # never require the settle to hold
    printf '\n\033[33mFALSIFY MODE: boot-transient defences DISABLED.\033[0m\n'
  else
    printf '\n\033[33mFALSIFY MODE (witness only): debounce KEPT — the SLOWEST false settle.\033[0m\n'
  fi
  printf '\033[33msection 5 MUST fail (dwell=%ss); rc 0 == it did.\033[0m\n' "$DWELL"
fi

AID="demo-task-abc"

# ---------------------------------------------------------------------------
# sandbox helpers
# ---------------------------------------------------------------------------
SANDBOX=""
setup() {
  # Kill any watcher this suite started, by EXACT pid, and reap it. The old
  # `pkill -f "$TMPROOT.*watch"; sleep 0.3` was a blind broadcast followed by a
  # hopeful wait; tracking pids lets us wait for the real thing and costs ~0ms.
  stop_watchers
  # NOTE: $$ is the PARENT's pid inside a bash 3.2 subshell, so it is useless
  # for uniqueness here — CASE_PREFIX (the section id) is what actually keeps
  # concurrent sections apart.
  SANDBOX="$TMPROOT/run-$CASE_PREFIX-$((CASE_SEQ = CASE_SEQ + 1))"
  # Per-CASE stub state and log, derived from the sandbox. Previously both were
  # process-global and merely wiped between cases, so a watcher that outlived
  # its case silently polluted the NEXT case's wake/settle counts (exactly the
  # failure mode that the pkill-and-sleep in here was papering over). Scoping
  # them per case removes the coupling entirely — and makes cases independent
  # enough to run concurrently.
  export HERDR_STUB_STATE="$SANDBOX/state"
  export HERDR_STUB_LOG="$SANDBOX/herdr.log"
  mkdir -p "$SANDBOX/bin" "$SANDBOX/tasks/$AID" "$HERDR_STUB_STATE"
  cp "$SRC" "$SANDBOX/bin/task-worktree"
  : > "$HERDR_STUB_LOG"
  mkdir -p "$SANDBOX/.dispatch"
  # the fake agent's cwd + its own private pi session store
  export HERDR_STUB_CWD="$SANDBOX/tasks/$AID"
  export HERDR_STUB_AGENT=pi
  export TASK_PI_SESSIONS_DIR="$SANDBOX/pi-sessions"
  printf '%s\n' "{\"event\":\"created\",\"id\":\"$AID\",\"slug\":\"demo\",\"branch\":\"demo\",\"primary_repo\":\"none\",\"mode\":\"code\",\"dispatch_pane\":\"wDISPATCH:p1\",\"status\":\"working\",\"ts\":\"x\"}" \
    > "$SANDBOX/.dispatch/ledger.jsonl"
}
TW() { "$SANDBOX/bin/task-worktree" "$@"; }

# ---------------------------------------------------------------------------
# fixture pi session logs (what the classifier reads instead of the terminal)
#
# stopReason/errorMessage pairs are taken VERBATIM from real pi sessions:
#   human       a /stop that landed inside pi          (retryAttempt == 0)
#   human-http  a /stop that landed in the HTTP call   (provider SDK abort)
#   completed   a turn that finished normally
#   crash       a provider failure
#   retry-crash an abort raised while retrying a provider failure (NOT human)
#   mid-tool    the session just stops mid tool-loop (executor died)
# ---------------------------------------------------------------------------
pi_session() {
  local kind="$1" eid="${2:-e2}" dir sr em ts
  dir="$TASK_PI_SESSIONS_DIR/-$(printf '%s' "$HERDR_STUB_CWD" | tr '/' '-')--"
  mkdir -p "$dir"
  case "$kind" in
    completed)   sr=stop;    em="" ;;
    human)       sr=aborted; em="Operation aborted" ;;
    human-http)  sr=error;   em="This operation was aborted" ;;
    crash)       sr=error;   em="Connection error." ;;
    retry-crash) sr=aborted; em="Aborted after 1 retry attempt" ;;
    mid-tool)    sr=toolUse; em="" ;;
    *) echo "pi_session: unknown kind '$kind'" >&2; return 1 ;;
  esac
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  {
    printf '{"type":"session","version":3,"id":"s","cwd":"%s","timestamp":"%s"}\n' "$HERDR_STUB_CWD" "$ts"
    printf '{"type":"message","id":"e1","parentId":null,"timestamp":"%s","message":{"role":"user","content":"go","timestamp":1}}\n' "$ts"
    printf '{"type":"message","id":"%s","parentId":"e1","timestamp":"%s","message":{"role":"assistant","content":[],"stopReason":"%s","errorMessage":"%s","timestamp":2}}\n' \
      "$eid" "$ts" "$sr" "$em"
  } > "$dir/session.jsonl"
}
no_pi_session() { rm -rf "$TASK_PI_SESSIONS_DIR"; }
cause() { TW classify "$AID" | cut -f1; }
pauses() { grep -c '"event": *"paused"' "$SANDBOX/.dispatch/ledger.jsonl" 2>/dev/null | tr -d ' '; }

# ---------------------------------------------------------------------------
# brainstorm fixtures
#
# A brainstorm session is a DIALOGUE: it is idle most of the time, waiting for
# the human to type. The machinery must treat that idle as a non-event, so the
# task's ledger record has to say mode=brainstorm before the classifier runs.
# ---------------------------------------------------------------------------
brainstorm_ledger() {
  printf '%s\n' "{\"event\":\"created\",\"id\":\"$AID\",\"slug\":\"demo\",\"branch\":\"demo\",\"primary_repo\":\"none\",\"mode\":\"brainstorm\",\"skills\":\"${1:-both}\",\"dispatch_pane\":\"wDISPATCH:p1\",\"worktrees\":[],\"status\":\"working\",\"ts\":\"x\"}" \
    > "$SANDBOX/.dispatch/ledger.jsonl"
}
convos() { grep -c '"event": *"conversing"' "$SANDBOX/.dispatch/ledger.jsonl" 2>/dev/null | tr -d ' '; }
wait_convos() { wait_until "[ \"\$(convos)\" -ge $1 ]" "${2:-}"; }
reports_n() { grep -c '"event": *"reported"' "$SANDBOX/.dispatch/ledger.jsonl" 2>/dev/null | tr -d ' '; }
# wakes() counts EVERY prompt the stub saw; once a case prompts the AGENT too
# (wrapup does), "did Dispatch get woken" has to be counted separately.
dwakes() { grep -c "^PROMPT	wDISPATCH:p1" "$HERDR_STUB_LOG" 2>/dev/null | tr -d ' '; }
agent_prompts() { grep -c "^PROMPT	$AID" "$HERDR_STUB_LOG" 2>/dev/null | tr -d ' '; }

# the real .dispatch/ brainstorm templates, in the sandbox's .dispatch/
brainstorm_sandbox() {
  local d f
  d="$(dirname "$SRC")/../.dispatch"
  for f in brainstorm.PROMPT.md brainstorm.skill-brainstorm.md brainstorm.skill-grill.md; do
    cp "$d/$f" "$SANDBOX/.dispatch/" 2>/dev/null || { bad "the template $f exists in .dispatch/"; return 1; }
  done
  export TASK_REPOS_DIR="$SANDBOX/repos"
  export TASK_WORKTREE_STORE="$SANDBOX/wtstore"
  mkdir -p "$TASK_REPOS_DIR" "$TASK_WORKTREE_STORE"
}
# ---------------------------------------------------------------------------
# live watcher lifecycle
#
# Watchers are tracked by pid so they can be killed EXACTLY and reaped with
# `wait` (instant and deterministic) rather than pkill-and-hope. The scoped
# pkill survives only as an EXIT-trap backstop for stray stub children; it is
# never on the per-case critical path.
# ---------------------------------------------------------------------------
WATCHER_PIDS=""
WPID=""
start_watcher() {
  # Invoke the BINARY directly, not the TW function and not a subshell: `f &`
  # and `( ... ) &` both make $! a wrapper shell, so `kill $!` reaps the wrapper
  # and leaves the real watcher orphaned — which then keeps writing wakes into
  # the shared stub log and corrupts LATER sections' counts.
  "$SANDBOX/bin/task-worktree" watch "$AID" --dispatch-pane wDISPATCH:p1 >/dev/null 2>&1 &
  WPID=$!
  WATCHER_PIDS="$WATCHER_PIDS $WPID"
}
# The watcher logs 'phase 1 done' the moment it has finished witnessing the
# work phase and entered its settle loop. Waiting for that is a REAL
# synchronisation point: it replaces the old `sleep 2` guess at "the watcher is
# probably up by now", which was both slower and weaker (a slow boot under load
# could make the case mutate state before the watcher ever looked).
watch_log_has() { grep -q "$1" "$SANDBOX/.dispatch/logs/watch-$AID.log" 2>/dev/null; }
wait_watcher_armed() { wait_until 'watch_log_has "phase 1 done"'; }
wait_watcher_rearmed() { wait_until "[ \$(grep -c 're-armed' \"\$SANDBOX/.dispatch/logs/watch-\$AID.log\" 2>/dev/null) -ge $1 ]"; }

stop_watchers() {
  local p
  for p in $WATCHER_PIDS; do
    kill "$p" >/dev/null 2>&1
  done
  for p in $WATCHER_PIDS; do
    wait "$p" 2>/dev/null
  done
  WATCHER_PIDS=""; WPID=""
  return 0
}
state() { printf '%s %s\n' "$2" "${3:-$((RANDOM + 1000))}" > "$HERDR_STUB_STATE/$1"; }
# seq_state <agent> <status> <seq>  — explicit, monotonic
seq_state() { printf '%s %s\n' "$2" "$3" > "$HERDR_STUB_STATE/$1"; }
# --- durable report paths --------------------------------------------------
# Reports are named reports/<YYYY-MM-DD>-<id>.md, dated with the TASK'S
# CREATION date (the first 'created' record). setup()'s fixture ledger carries
# ts "x", which is not a timestamp, so the script falls back to today — which
# is what these helpers reproduce. Sections that pin a specific creation date
# use dated_ledger + local_date below.
local_date() {   # <utc-ts> -> the LOCAL YYYY-MM-DD the script will use
  python3 -c 'import sys;from datetime import datetime
t=sys.argv[1]
t=t[:-1]+"+00:00" if t.endswith("Z") else t
print(datetime.fromisoformat(t).astimezone().strftime("%Y-%m-%d"))' "$1"
}
rep_md()   { printf '%s/reports/%s-%s.md\n'          "$SANDBOX" "${2:-$(date +%Y-%m-%d)}" "${1:-$AID}"; }
rep_exec() { printf '%s/reports/%s-%s.executor.md\n' "$SANDBOX" "${2:-$(date +%Y-%m-%d)}" "${1:-$AID}"; }
# every report file this sandbox holds for <id>, dated or not
rep_all()  { ls "$SANDBOX/reports/" 2>/dev/null | grep -c -- "${1:-$AID}" | tr -d ' '; }

settles() { grep -c '"event":[ ]*"settled"' "$SANDBOX/.dispatch/ledger.jsonl" 2>/dev/null | tr -d ' '; }
wakes()   { grep -c '^PROMPT' "$HERDR_STUB_LOG" 2>/dev/null | tr -d ' '; }
ledger()  { cat "$SANDBOX/.dispatch/ledger.jsonl"; }

# ---------------------------------------------------------------------------
# `create --pr` fixtures
#
# A throwaway git repo under a sandbox-scoped $REPOS, with a GitHub origin URL
# (so the slug/compare-url derivation is real) and pre-seeded remote-tracking
# refs (so no network is ever touched). The PR itself is a `gh` fixture.
# ---------------------------------------------------------------------------
GIT_Q() { git -c user.email=a@b -c user.name=a -c init.defaultBranch=main -C "$1" "${@:2}"; }

pr_sandbox() {
  # the real .dispatch/ prompt template, in the sandbox's .dispatch/
  cp "$(dirname "$SRC")/../.dispatch/autopilot.PROMPT.md" "$SANDBOX/.dispatch/" 2>/dev/null \
    || { bad "the autopilot prompt template exists in .dispatch/"; return 1; }
  export TASK_REPOS_DIR="$SANDBOX/repos"
  export TASK_WORKTREE_STORE="$SANDBOX/wtstore"
  export GH_STUB_STATE="$SANDBOX/gh"
  export GH_STUB_LOG="$SANDBOX/gh.log"
  mkdir -p "$TASK_REPOS_DIR" "$TASK_WORKTREE_STORE" "$GH_STUB_STATE"
  : > "$GH_STUB_LOG"
}

# mk_repo <repo> [extra-remote-branch ...]
mk_repo() {
  local repo="$1"; shift
  local dir="$TASK_REPOS_DIR/$repo" b
  mkdir -p "$dir"
  git -c init.defaultBranch=main init -q "$dir"
  GIT_Q "$dir" commit -q --allow-empty -m init
  GIT_Q "$dir" remote add origin "git@github.com:acme/$repo.git"
  GIT_Q "$dir" update-ref refs/remotes/origin/main HEAD
  for b in "$@"; do GIT_Q "$dir" update-ref "refs/remotes/origin/$b" HEAD; done
}

# pr_fixture <number> <state> <headRefName> [<lookup-key>]
#
# The stub keys fixtures by the SELECTOR gh was given, which is normally the PR
# number — but `gh pr view <branch>` is equally real (that is how `autopilot`
# finds the PR for a task's own branch), so the key is overridable.
pr_fixture() {
  printf '{"number":%s,"state":"%s","headRefName":"%s","url":"https://github.com/acme/widget/pull/%s","isCrossRepository":false,"title":"t"}\n' \
    "$1" "$2" "$3" "$1" > "$GH_STUB_STATE/${4:-$1}.json"
}

printf '\n\033[1mtask-worktree selftest\033[0m  (%s)\n' "$SRC"

# ===========================================================================
sect_0() {
section "0. the script parses"
# Guards a nasty bash 3.2 (macOS) trap: inside $( ... ), the parser scans the
# heredoc body for quotes, so a lone apostrophe in a python comment silently
# breaks the whole script.
err="$(bash -n "$SRC" 2>&1)"
is "bash -n is clean (watch for apostrophes in heredocs inside \$())" "${err:-clean}" "clean"
}

# ===========================================================================
sect_1() {
section "1. herdr --until contract (the regression that broke the watcher)"
herdr agent wait x --until idle done blocked >/dev/null 2>&1; rc=$?
is "multi-value '--until idle done blocked' exits rc=2" "$rc" "2"

setup; seq_state "$AID" idle 10
herdr agent wait "$AID" --until idle --until done --until blocked --timeout 500 >/dev/null 2>&1
is "repeated --until matches an idle agent (rc=0)" "$?" "0"
herdr agent wait "$AID" --timeout 500 >/dev/null 2>&1
is "bare wait defaults to idle/done/blocked (rc=0)" "$?" "0"
herdr agent wait "$AID" --until working --timeout 300 >/dev/null 2>&1
is "no-match is rc=1, not rc=2" "$?" "1"

# real (non-comment) code lines only
hits="$(grep -nE -- '--until [a-z]+ [a-z]+' "$SRC" | grep -vE '^[0-9]+: *#' | head -1)"
if [ -n "$hits" ]; then
  bad "the script never passes a multi-value --until" "found: $hits"
else
  ok "the script never passes a multi-value --until"
fi
}

# ===========================================================================
sect_2() {
section "2. exactly-once: executor done + watcher backstop"
setup; seq_state "$AID" working 20
TW done "$AID" --note "primary path" >/dev/null 2>&1
is "executor 'done' records one settle" "$(settles)" "1"
is "executor 'done' wakes Dispatch once" "$(wakes)" "1"

seq_state "$AID" idle 21                       # the agent then goes idle
TW notify-settle "$AID" --by watcher --status awaiting-dispatch >/dev/null 2>&1
is "watcher backstop is suppressed (still 1 settle)" "$(settles)" "1"
is "watcher backstop does not double-wake" "$(wakes)" "1"

TW done "$AID" --note "same settle again" >/dev/null 2>&1
is "a repeated 'done' in the same settle is suppressed" "$(settles)" "1"

TW done "$AID" --note "forced" --force >/dev/null 2>&1
is "--force overrides the claim" "$(settles)" "2"
}

# ===========================================================================
sect_3() {
section "3. re-arming: settle -> steer -> settle reports every time"
setup; seq_state "$AID" idle 30
TW notify-settle "$AID" --by watcher --status awaiting-dispatch >/dev/null 2>&1
is "first settle reported" "$(settles)" "1"

seq_state "$AID" working 31
TW notify-settle "$AID" --by watcher --status awaiting-dispatch >/dev/null 2>&1
is "no report while the claim is still held" "$(settles)" "1"

# the watcher observes the resume and releases the claim
TW _release "$AID" >/dev/null 2>&1 || true
seq_state "$AID" idle 32
TW notify-settle "$AID" --by watcher --status awaiting-dispatch >/dev/null 2>&1
is "second settle reports after release (re-armed)" "$(settles)" "2"
is "and wakes Dispatch again" "$(wakes)" "2"
}

# ===========================================================================
sect_4() {
section "4. re-arming survives a DEAD watcher (seq-advance fallback)"
setup; seq_state "$AID" working 40
TW done "$AID" --note "first" >/dev/null 2>&1
is "executor reports settle 1" "$(settles)" "1"
# nobody ever releases the claim (watcher dead). The executor is steered,
# works again, and reports: herdr's seq has advanced, so it is a NEW settle.
seq_state "$AID" working 45
TW done "$AID" --note "second, after being steered" >/dev/null 2>&1
is "executor reports settle 2 anyway" "$(settles)" "2"
}

# ===========================================================================
sect_5() {
section "5. watcher: boot transient must NOT produce a false settle"
setup
# The classic race: the agent reads idle/done for a moment right after boot.
seq_state "$AID" idle 50
start_watcher
# NEGATIVE assertion: there is no event to wait for, so this needs a real
# dwell (see DWELL above) — the watcher must be given the chance to get it
# wrong before we can claim it did not.
dwell
early="$(settles)"
# ...and a DETERMINISTIC companion to that dwell. The watcher must not arm its
# settle loop until it has witnessed a genuine work phase, and it says so in
# its own log. Unlike the dwell, this does not weaken when the machine is
# loaded (load can only make the watcher slower to arm, never faster), so the
# witnessed-work-phase defence stays covered no matter how busy the host is.
armed_unwitnessed=no
watch_log_has 'witnessed=0' && armed_unwitnessed=yes
is "the settle loop is not armed before a work phase is witnessed" "$armed_unwitnessed" "no"
# --falsify needs to distinguish "the dwell failed to catch the bug" from "the
# bug never reproduced": on a badly oversubscribed host the broken watcher can
# be so slow that this case sets it working before it ever arms, and it then
# behaves CORRECTLY by accident. Record which happened.
[ "$FALSIFY" -eq 1 ] && printf '%s\n' "$armed_unwitnessed" > "$RESDIR/falsify.armed"
seq_state "$AID" working 51                    # ... then it actually starts
wait_watcher_armed                             # it witnesses the work phase
dwell                                          # negative again: none while working
mid="$(settles)"
seq_state "$AID" idle 52                       # ... and genuinely finishes
wait_settles 1                                 # POSITIVE: wait for the event
dwell                                          # then prove no SECOND settle follows
final="$(settles)"
stop_watchers
is "no settle recorded during the boot transient" "$early" "0"
is "no settle recorded while working" "$mid" "0"
is "exactly one settle recorded after the real finish" "$final" "1"
is "Dispatch woken exactly once" "$(wakes)" "1"
note "$(ledger | tail -1)"
}

# ===========================================================================
sect_6() {
section "6. watcher: settle is detected at all (the spin-forever bug)"
setup; seq_state "$AID" working 60
start_watcher
wait_watcher_armed
seq_state "$AID" idle 61
wait_settles 1
dwell                                          # exactly-once: no duplicate
got="$(settles)"
stop_watchers
is "a working->idle transition is recorded" "$got" "1"
if grep -q '"status": *"awaiting-dispatch"' "$SANDBOX/.dispatch/ledger.jsonl"; then
  ok "recorded with status awaiting-dispatch"
else bad "recorded with status awaiting-dispatch" "$(ledger | tail -1)"; fi
}

# ===========================================================================
sect_7() {
section "7. watcher: blocked settles are reported as blocked"
setup; seq_state "$AID" working 70
start_watcher
wait_watcher_armed
seq_state "$AID" blocked 71
wait_settles 1
stop_watchers
if grep -q '"status": *"blocked"' "$SANDBOX/.dispatch/ledger.jsonl"; then
  ok "blocked settle recorded as blocked"
else bad "blocked settle recorded as blocked" "$(ledger | tail -1)"; fi
}

# ===========================================================================
sect_8() {
section "8. watcher: re-arms on a second settle (live)"
setup; seq_state "$AID" working 80
start_watcher
wait_watcher_armed
seq_state "$AID" idle 81
wait_settles 1
first="$(settles)"
seq_state "$AID" working 82                       # steered
# the watcher must OBSERVE the resume and release its claim before the next
# settle can be reported — wait for that, do not guess at it.
wait_watcher_rearmed 1
seq_state "$AID" idle 83                          # settles again
wait_settles 2
dwell                                             # and no third
second="$(settles)"
stop_watchers
is "first settle reported" "$first" "1"
is "second settle reported too (re-armed)" "$second" "2"
is "Dispatch woken exactly twice, once per settle" "$(wakes)" "2"
}

# ===========================================================================
sect_9() {
section "9. watcher FAILS LOUD instead of spinning (dead executor)"
setup; seq_state "$AID" working 90
start_watcher
wait_watcher_armed
rm -f "$HERDR_STUB_STATE/$AID"                 # the agent vanishes: herdr errors
# POSITIVE: wait for the watcher process to actually EXIT. (The old fixed
# 10s sleep asserted the same thing, just always paying the worst case.)
wait_gone "$WPID"
alive=0; kill -0 "$WPID" 2>/dev/null && alive=1
stop_watchers
is "watcher exits instead of looping on a herdr failure" "$alive" "0"
if grep -qE 'watcher-failed|"status": *"orphaned"' "$SANDBOX/.dispatch/ledger.jsonl"; then
  ok "the failure is recorded durably in the ledger"
else bad "the failure is recorded durably in the ledger" "$(ledger | tail -2)"; fi
is "and Dispatch is woken about it (a dead executor is real news)" "$(wakes)" "1"
if grep -q 'ABORT' "$SANDBOX/.dispatch/logs/watch-$AID.log" 2>/dev/null; then
  ok "and logged to .dispatch/logs/watch-<id>.log"
else bad "and logged to .dispatch/logs/watch-<id>.log"; fi
}

# ===========================================================================
sect_10() {
section "10. reconcile repairs a ledger stuck at working"
setup; seq_state "$AID" idle 100
out="$(TW reconcile --dry-run 2>&1)"
case "$out" in *REPAIR*) ok "dry-run spots the stuck task" ;; *) bad "dry-run spots the stuck task" "$out" ;; esac
is "dry-run writes nothing" "$(settles)" "0"
TW reconcile >/dev/null 2>&1
is "reconcile records the missed settle" "$(settles)" "1"
TW reconcile >/dev/null 2>&1
is "reconcile is idempotent" "$(settles)" "1"
}

