#!/usr/bin/env bash
#
# task-worktree — the one blessed path for spinning, tearing down, and
# reconciling agentic tasks in this Dispatch root.
#
# This is a scratch bash script. It is expected to graduate into a reusable
# skill (its own repo) later; keep the surface small and the herdr calls
# well-isolated so that extraction is easy.
#
# Subcommands:
#   create    Create worktree(s) + ephemeral task dir + spawn an executor agent.
#   handoff   Swap in a fresh-context executor on an existing worktree/branch.
#   wrapup    Ask a LIVE brainstorm session to produce its plan now (ends it).
#   done      Executor self-notification: "I am finished" (PRIMARY completion path).
#   watch     Detached settle watcher for one task (BACKSTOP; armed by create).
#   report    Persist an executor's report durably.
#   classify  Say WHY an executor settled (human /stop vs finished vs crashed).
#   reconcile Repair ledger status from live herdr agent state.
#   remove    Tear down a task: herdr worktrees, symlinks, task dir, ledger.
#   prune     Garbage-collect dangling worktree symlinks + unused repo symlinks.
#   list      Show current task status derived from the ledger.
#   help      Show usage.
#
# Completion is EXACTLY-ONCE per settle. Two independent paths converge on the
# same code (`notify-settle`), which takes a per-task settle CLAIM before it
# records/notifies/wakes:
#   1. PRIMARY  — the executor calls `done` as its final action.
#   2. BACKSTOP — the detached `watch` process sees the agent settle.
# Whoever gets there first claims the settle; the other is suppressed. The claim
# is released when the executor genuinely resumes work (re-arming), so a task
# that settles -> is steered -> settles again reports every time.
#
# SETTLE CLASSIFICATION (why an agent went idle)
# herdr only reports THAT an agent is idle, never WHY. A human hitting pi's
# stop/interrupt (Esc, `app.interrupt`) also produces 'idle', which used to make
# the BACKSTOP wake Dispatch with a half-finished task. pi records the reason
# structurally in its own session JSONL, so we read it there rather than
# scraping the terminal (see `classify`):
#   stopReason=stop                                   -> completed        WAKE
#   stopReason=aborted   errorMessage=Operation aborted -> human-interrupt SUPPRESS
#   stopReason=error     errorMessage=...was aborted    -> human-interrupt SUPPRESS
#   stopReason=aborted   errorMessage=Aborted after N retry... -> agent-error WAKE
#   stopReason=error     (Connection error./terminated/...)     -> agent-error WAKE
#   anything else                                     -> unknown         WAKE
# Only the BACKSTOP (`watch`) and `reconcile` classify. The executor's own
# `done` is ALWAYS trusted and never classified or suppressed. Ambiguity always
# resolves to waking: losing a real completion is far worse than one noisy wake.
# A suppressed settle is still recorded ('paused' event, status
# 'paused-by-human') so `list`/`reconcile` surface it, and it deliberately never
# touches the settle claim, so the exactly-once gate cannot be poisoned.
#
# CONVERSATIONAL IDLE (--mode brainstorm)
# A brainstorm session is a DIALOGUE with the human, so 'idle' is its resting
# state: it is idle every time it finishes a turn and waits for the human to
# type. Treating that as a settle would wake Dispatch on every conversational
# turn and burn the exactly-once claim. So the SAME suppression grain as
# human-interrupt is applied one step later, keyed on the classifier's cause:
#   mode=brainstorm AND cause=completed  -> SUPPRESS (a finished turn == waiting
#                                           for the human), recorded once per
#                                           conversation as a 'conversing' event
#                                           (status 'in-conversation').
#   cause=agent-error / unknown / mid-tool -> WAKE, exactly as for any other
#                                           task: the agent DYING is not a
#                                           conversational pause.
#   the agent vanishing entirely           -> WAKE (watch's --force path, which
#                                           never classifies at all).
# The suppression is lifted the moment `wrapup` is requested (ledger status
# 'wrapping-up'), so the backstop still covers a session that produces its plan
# and then forgets to call `done`. Like human-interrupt, a suppressed
# conversational idle never touches the settle claim.
#
set -euo pipefail

# ---------------------------------------------------------------------------
# Layout / config
# ---------------------------------------------------------------------------
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"     # the Dispatch root
SELF="$ROOT/bin/$(basename "${BASH_SOURCE[0]}")"            # re-invocable path
REPOS="${TASK_REPOS_DIR:-$HOME/Repositories}"               # source repos
WORKTREE_STORE="${TASK_WORKTREE_STORE:-$HOME/agentic-workspaces/.worktrees}"
WORKTREE_VIEW="$ROOT/worktree"                             # symlink view
TASKS_DIR="$ROOT/tasks"                                     # ephemeral task dirs
REPORTS_DIR="$ROOT/reports"                                 # durable task reports
DISPATCH_DIR="$ROOT/.dispatch"
LEDGER="$DISPATCH_DIR/ledger.jsonl"
EXECUTOR_CONTEXT="$DISPATCH_DIR/task-executor.AGENTS.md"
SETTLE_DIR="$DISPATCH_DIR/settle"                           # per-task settle claims
LOG_DIR="$DISPATCH_DIR/logs"                                # watcher logs
DEFAULT_AGENT_KIND="${TASK_AGENT_KIND:-pi}"

SETTLE_EPOCH=""     # set by _settle_claim
WATCH_LOG=""        # set by cmd_watch

die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
info() { printf '· %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

have herdr   || die "herdr not found on PATH"
have python3 || die "python3 not found on PATH"
have git     || die "git not found on PATH"

mkdir -p "$DISPATCH_DIR" "$WORKTREE_VIEW" "$TASKS_DIR" "$WORKTREE_STORE" "$REPORTS_DIR" \
         "$SETTLE_DIR" "$LOG_DIR"
[ -f "$LEDGER" ] || : > "$LEDGER"

# ---------------------------------------------------------------------------
# JSON helpers (herdr speaks JSON on stdout)
# ---------------------------------------------------------------------------

# jget <json> <python-expr-over-d>  -> prints result or exits non-zero
jget() {
  python3 - "$1" "$2" <<'PY'
import json, sys
d = json.loads(sys.argv[1])
if isinstance(d, dict) and "error" in d:
    sys.stderr.write("herdr error: %s\n" % d["error"].get("message", d["error"]))
    sys.exit(3)
try:
    print(eval(sys.argv[2], {"d": d}))
except Exception as e:
    sys.stderr.write("json path failed: %s\n" % e)
    sys.exit(4)
PY
}

nonce() { printf '%03x' "$((RANDOM % 4096))"; }

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# ledger_append <json-object-string>
ledger_append() { printf '%s\n' "$1" >> "$LEDGER"; }

# _default_branch <repo> -> prints the repo's default branch (main/master)
_default_branch() {
  local repo="$1" ref c
  ref="$(git -C "$REPOS/$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$ref" ]; then printf '%s\n' "${ref#origin/}"; return; fi
  for c in main master; do
    if git -C "$REPOS/$repo" show-ref --verify --quiet "refs/remotes/origin/$c"; then
      printf '%s\n' "$c"; return
    fi
  done
  printf 'main\n'
}

# _github_slug <repo> -> prints 'owner/name' for the repo's origin remote.
# Prints nothing (rc 0) when origin is missing or isn't GitHub.
_github_slug() {
  local url slug
  url="$(git -C "$REPOS/$1" remote get-url origin 2>/dev/null || true)"
  [ -n "$url" ] || return 0
  case "$url" in
    git@github.com:*)       slug="${url#git@github.com:}" ;;
    https://github.com/*)   slug="${url#https://github.com/}" ;;
    ssh://git@github.com/*) slug="${url#ssh://git@github.com/}" ;;
    *) return 0 ;;
  esac
  printf '%s\n' "${slug%.git}"
}

# _compare_url <repo> <branch> -> prints the GitHub compare link (main...branch)
# Built from the origin remote's GitHub slug against the repo's default branch.
# Prints nothing if origin isn't GitHub.
_compare_url() {
  local repo="$1" branch="$2" base slug
  slug="$(_github_slug "$repo")"
  [ -n "$slug" ] || return 0
  base="$(_default_branch "$repo")"
  printf 'https://github.com/%s/compare/%s...%s\n' "$slug" "$base" "$branch"
}

# ---------------------------------------------------------------------------
# herdr agent probes
#
# IMPORTANT (regression guard): `herdr agent wait --until <S>` takes ONE status
# and must be REPEATED for several (`--until idle --until done`). A
# space-separated list makes herdr exit rc=2 with "unknown option: <s>", which
# silently turns every probe into "false" — exactly the bug that made the old
# watcher spin forever without ever recording a settle. A BARE `herdr agent wait
# <id>` already defaults to idle/done/blocked, so prefer it for settle waits.
#
# Exit codes we rely on (verified against live agents):
#   0     the requested state was reached
#   1     timeout / no match / agent_not_found  (a normal, expected outcome)
#   >=2   bad invocation or herdr failure       (NEVER retry-loop on this)
# ---------------------------------------------------------------------------

HWAIT_ERR=""

# _hwait <target> [herdr-wait-args...]
#   rc 0  matched
#   rc 1  no match / timed out (agent is alive, just not in that state)
#   rc 2  FATAL: bad invocation, herdr failure, or the agent is gone.
#         Callers MUST treat rc 2 as "stop", never as "try again".
_hwait() {
  local out rc=0
  HWAIT_ERR=""
  out="$(herdr agent wait "$@" 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] && return 0
  if [ "$rc" -ge 2 ]; then
    HWAIT_ERR="herdr agent wait rc=$rc: $out"
    return 2
  fi
  case "$out" in
    *agent_not_found*) HWAIT_ERR="agent not found: $out"; return 2 ;;
  esac
  return 1
}

# _agent_field <target> <field>  -> prints the field of the live agent record.
# rc 1 if the agent does not exist. Fields: agent_status, state_change_seq, ...
_agent_field() {
  local out rc=0
  out="$(herdr agent get "$1" 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  python3 - "$out" "$2" <<'PY'
import json, sys
try:
    a = json.loads(sys.argv[1])["result"]["agent"]
except Exception:
    sys.exit(1)
print(a.get(sys.argv[2], ""))
PY
}

# _agent_status <target> -> idle|working|blocked|done|unknown, or "" if gone
_agent_status() { _agent_field "$1" agent_status 2>/dev/null || true; }
# _agent_seq <target> -> herdr's monotonic state_change_seq ("" if gone)
_agent_seq()    { _agent_field "$1" state_change_seq 2>/dev/null || true; }
# _agent_cwd <target> -> the agent's working directory ("" if gone)
_agent_cwd()    { _agent_field "$1" cwd 2>/dev/null || true; }
# _agent_kind <target> -> the detected agent kind, e.g. 'pi' ("" if gone)
_agent_kind()   { _agent_field "$1" agent 2>/dev/null || true; }

# ---------------------------------------------------------------------------
# Settle classification — WHY did the agent go idle?
#
# herdr's agent_status is screen-scraped and only ever says idle/working/
# blocked; it cannot tell "the executor finished" from "the human hit stop".
# pi, however, writes a structured session JSONL (\$PI_SESSION_FILE, under
# ~/.pi/agent/sessions/--<cwd with / as ->--/) in which every assistant turn
# carries a stopReason, and a human interrupt is recorded distinguishably.
# Verified against live sessions (2026-09-11):
#   human /stop (Esc / app.interrupt):
#       {"stopReason":"aborted","errorMessage":"Operation aborted"}       (abort
#         landed inside pi: interactive-mode sets this when retryAttempt == 0)
#       {"stopReason":"error","errorMessage":"This operation was aborted"} (abort
#         landed inside the in-flight provider HTTP request)
#   provider/agent failure (the human must still hear about it):
#       {"stopReason":"error","errorMessage":"Connection error."|"terminated"
#                                            |"Request timed out."}
#       {"stopReason":"aborted","errorMessage":"Aborted after 1 retry attempt"}
#         (retryAttempt > 0 -> NOT a human stop, despite saying 'aborted')
#   natural completion:
#       {"stopReason":"stop"}
# Everything unrecognised is 'unknown', which WAKES. Terminal scraping for
# strings like "Command aborted" is deliberately NOT used: it is lossy,
# version-dependent and invisible once the screen scrolls.
# ---------------------------------------------------------------------------

PI_SESSIONS_DIR="${TASK_PI_SESSIONS_DIR:-$HOME/.pi/agent/sessions}"

# _classify_session <cwd> [explicit-session-file]
#   prints "<cause>\t<detail>\t<marker>"
#   cause: human-interrupt | completed | agent-error | unknown
#   marker: a stable id for the settle-causing entry (used to de-duplicate
#           repeated 'paused' ledger records for the SAME interruption).
_classify_session() {
  python3 - "${1:-}" "$PI_SESSIONS_DIR" "${2:-}" <<'PY'
import glob, json, os, sys

cwd, sessions_root, explicit = sys.argv[1], sys.argv[2], sys.argv[3]

def out(cause, detail, marker=""):
    print("%s\t%s\t%s" % (cause, detail.replace("\t", " "), marker))
    raise SystemExit(0)

def newest(paths):
    paths = [p for p in paths if os.path.isfile(p)]
    return max(paths, key=os.path.getmtime) if paths else ""

def session_file():
    if explicit:
        return explicit if os.path.isfile(explicit) else ""
    if not cwd:
        return ""
    # pi's own naming: '--' + cwd with '/' -> '-' + '--'  (leading / already -)
    direct = os.path.join(sessions_root, "-" + cwd.replace("/", "-") + "--")
    hit = newest(glob.glob(os.path.join(direct, "*.jsonl")))
    if hit:
        return hit
    # Fallback: match the header cwd across the most recent session files.
    cands = sorted(glob.glob(os.path.join(sessions_root, "*", "*.jsonl")),
                   key=os.path.getmtime, reverse=True)[:60]
    for f in cands:
        try:
            with open(f) as fh:
                head = json.loads(fh.readline())
        except Exception:
            continue
        if head.get("cwd") == cwd:
            return f
    return ""

f = session_file()
if not f:
    out("unknown", "no pi session log found for cwd %r" % (cwd or "?"))

last = None
with open(f) as fh:
    for line in fh:
        line = line.strip()
        if not line:
            continue
        try:
            o = json.loads(line)
        except Exception:
            continue
        m = o.get("message") or {}
        if m.get("role") == "assistant":
            last = (o, m)

base = os.path.basename(f)
if last is None:
    out("unknown", "no assistant turn in session %s" % base)

o, m = last
sr = (m.get("stopReason") or "").strip()
em = (m.get("errorMessage") or "").strip()
marker = "%s#%s" % (base, o.get("id") or o.get("timestamp") or "")
key = em.lower().rstrip(".").strip()

# Exact phrases pi emits for a USER-initiated abort. Kept as an exact set (not a
# loose /abort/ match) precisely because provider failures also say "Aborted".
HUMAN = {
    "operation aborted",
    "this operation was aborted",
    "the operation was aborted",
    "operation was aborted",
    "request was aborted",
    "aborted by user",
}

if sr in ("aborted", "error") and key in HUMAN:
    out("human-interrupt",
        "pi turn ended stopReason=%s errorMessage=%r (user stop/interrupt) in %s"
        % (sr, em, base), marker)
if sr == "aborted" and "retry" in key:
    out("agent-error", "pi aborted during provider retry: %s" % (em or "?"), marker)
if sr == "aborted":
    out("unknown", "pi turn aborted with unrecognised errorMessage %r" % em, marker)
if sr == "error":
    out("agent-error", "pi turn failed: %s" % (em or "unknown error"), marker)
if sr == "stop":
    out("completed", "pi finished its turn normally (stopReason=stop)", marker)
if sr == "toolUse":
    out("unknown", "session ends mid tool-loop (stopReason=toolUse) — executor may have died", marker)
out("unknown", "unrecognised stopReason %r" % sr, marker)
PY
}

# _classify_settle <id> [session-file] -> "<cause>\t<detail>\t<marker>"
# Never fails: any problem resolves to 'unknown', which means WAKE.
_classify_settle() {
  local id="$1" sess="${2:-}" kind="" cwd="" res=""
  if [ -z "$sess" ]; then
    kind="$(_agent_kind "$id")"
    [ -n "$kind" ] || kind="$(_task_field "$id" agent_kind)"
    if [ -n "$kind" ] && [ "$kind" != "pi" ]; then
      printf 'unknown\tagent kind %s keeps no session log we can classify\t\n' "$kind"
      return 0
    fi
    cwd="$(_agent_cwd "$id")"
    [ -n "$cwd" ] || cwd="$TASKS_DIR/$id"
  fi
  res="$(_classify_session "$cwd" "$sess" 2>/dev/null || true)"
  [ -n "$res" ] || res="$(printf 'unknown\tclassifier failed to run\t')"
  printf '%s\n' "$res"
}

usage_classify() {
  cat >&2 <<EOF
Usage: task-worktree classify <task-id> [--session <pi-session.jsonl>]

  Says WHY an executor settled, by reading pi's own session log rather than
  scraping the terminal. Prints: <cause>\t<detail>\t<marker>

    human-interrupt  the HUMAN stopped it (pi /stop, Esc, app.interrupt)
                     -> the backstop watcher SUPPRESSES the wake
    completed        the executor finished its turn (stopReason=stop)
    agent-error      provider/agent failure (connection error, retry abort)
    unknown          not determinable — treated as a genuine settle (wakes)
EOF
}

cmd_classify() {
  local id="" sess=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) sess="$2"; shift 2 ;;
      -h|--help) usage_classify; return 0 ;;
      -*) die "classify: unknown arg '$1'" ;;
      *) [ -n "$id" ] && die "classify: unexpected arg '$1'"; id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || { usage_classify; die "classify: task id required"; }
  _classify_settle "$id" "$sess"
}

# _discover_dispatch_pane -> pane id of the Dispatch agent (cwd == the root)
_discover_dispatch_pane() {
  local out
  out="$(herdr agent list 2>/dev/null)" || return 0
  python3 - "$out" "$ROOT" <<'PY'
import json, sys
try:
    agents = json.loads(sys.argv[1])["result"]["agents"]
except Exception:
    sys.exit(0)
root = sys.argv[2]
for a in agents:
    # the Dispatch agent is the one rooted AT the dispatch root (executors live
    # in tasks/<id>/ subdirs and carry a task name)
    if a.get("cwd") == root and not a.get("name"):
        print(a.get("pane_id", "")); break
PY
}

# _task_field <id> <key> -> a field from the task's latest created/handoff record
_task_field() {
  local rec; rec="$(_find_created_rec "$1")"
  [ -n "$rec" ] || return 0
  jget "$rec" "d.get('$2') or ''" 2>/dev/null || true
}

# _resolve_dispatch_pane <id> -> the pane to wake.
# Deliberately does NOT consult $HERDR_PANE_ID: when an EXECUTOR runs `done`,
# that variable points at the executor's own pane, which would wake the wrong
# agent. Resolution order: explicit arg > task.env > ledger > live discovery.
_resolve_dispatch_pane() {
  local id="$1" explicit="${2:-}" p=""
  [ -n "$explicit" ] && { printf '%s\n' "$explicit"; return 0; }
  [ -n "${TASK_DISPATCH_PANE:-}" ] && { printf '%s\n' "$TASK_DISPATCH_PANE"; return 0; }
  if [ -n "$id" ] && [ -f "$TASKS_DIR/$id/task.env" ]; then
    p="$(. "$TASKS_DIR/$id/task.env" >/dev/null 2>&1; printf '%s' "${TASK_DISPATCH_PANE:-}")"
    [ -n "$p" ] && { printf '%s\n' "$p"; return 0; }
  fi
  [ -n "$id" ] && p="$(_task_field "$id" dispatch_pane)"
  [ -n "$p" ] && { printf '%s\n' "$p"; return 0; }
  _discover_dispatch_pane
}

# ---------------------------------------------------------------------------
# Settle claims — the exactly-once gate
#
# One claim file per task ($SETTLE_DIR/<id>.claim). Holding it means "this
# settle has already been recorded and Dispatch has already been woken". It is
# released when the executor genuinely resumes work, which is what makes the
# re-arming behaviour (settle -> steer -> settle again) keep reporting.
# ---------------------------------------------------------------------------

# _settle_claim <id> <by> <force 0|1>
#   rc 0  we own this settle -> caller must record + notify + wake
#   rc 1  suppressed — this settle was already reported by someone else
_settle_claim() {
  local id="$1" by="$2" force="${3:-0}" seq verdict
  seq="$(_agent_seq "$id")"
  mkdir -p "$SETTLE_DIR"
  verdict="$(python3 - "$SETTLE_DIR/$id.claim" "$SETTLE_DIR/$id.lock" "$by" "$seq" "$force" "$(now)" <<'PY'
import json, os, shutil, sys, time

claim_path, lock_path, by, seq, force, ts = sys.argv[1:7]
force = force == "1"
seq = int(seq) if seq.strip().isdigit() else None

# --- tiny cross-process lock (mkdir is atomic on every POSIX fs) -------------
for attempt in range(200):                       # ~10s worth of tries
    try:
        os.mkdir(lock_path); break
    except FileExistsError:
        try:                                     # break a lock left by a crash
            if time.time() - os.path.getmtime(lock_path) > 30:
                shutil.rmtree(lock_path, ignore_errors=True); continue
        except OSError:
            pass
        time.sleep(0.05)
else:
    shutil.rmtree(lock_path, ignore_errors=True)
    os.mkdir(lock_path)

try:
    claim = None
    try:
        with open(claim_path) as fh:
            claim = json.load(fh)
    except Exception:
        claim = None

    def fire(epoch):
        with open(claim_path, "w") as fh:
            json.dump({"epoch": epoch, "by": by, "seq": seq,
                       "released": False, "ts": ts}, fh)
        print("fire %d" % epoch)

    if force or claim is None:
        fire(int((claim or {}).get("epoch", 0)) + 1)
    elif claim.get("released"):
        # the executor resumed work since the last settle -> a genuinely NEW
        # settle. This is what preserves re-arming.
        fire(int(claim.get("epoch", 0)) + 1)
    elif by == "watcher":
        # BACKSTOP suppressed: the executor already self-reported this settle.
        # Record the seq we actually observed the agent settle at, so a later
        # executor-side call can tell "same settle" from "a new one".
        claim["seq"] = seq if seq is not None else claim.get("seq")
        claim["watcher_seen"] = True
        with open(claim_path, "w") as fh:
            json.dump(claim, fh)
        print("skip %d" % int(claim.get("epoch", 0)))
    else:
        # Executor/reconcile side. If the monotonic state_change_seq from herdr has
        # advanced past the claim, the agent changed state since it was taken
        # (it was steered and worked again) -> a new settle. This keeps
        # re-arming working even if the watcher died and never released.
        prev = claim.get("seq")
        if seq is not None and isinstance(prev, int) and seq > prev:
            fire(int(claim.get("epoch", 0)) + 1)
        else:
            print("skip %d" % int(claim.get("epoch", 0)))
finally:
    shutil.rmtree(lock_path, ignore_errors=True)
PY
)"
  SETTLE_EPOCH="${verdict#* }"
  case "$verdict" in
    fire*) return 0 ;;
    *)     return 1 ;;
  esac
}

# _settle_release <id> [reason] — mark the current claim released because the
# executor resumed work, so the NEXT settle reports again (re-arming).
_settle_release() {
  # NOTE: separate statements on purpose — bash expands every word of a `local`
  # command before assigning any of them, so `local a=$1 b=$a` would blow up.
  local id="$1" reason="${2:-resumed}"
  local claim="$SETTLE_DIR/$id.claim"
  [ -f "$claim" ] || return 0
  python3 - "$claim" <<'PY' || return 0
import json, sys
p = sys.argv[1]
try:
    with open(p) as fh: c = json.load(fh)
except Exception:
    sys.exit(0)
if c.get("released"):
    sys.exit(1)          # already released -> no duplicate 'resumed' event
c["released"] = True
with open(p, "w") as fh: json.dump(c, fh)
PY
  ledger_append "{\"event\":\"resumed\",\"id\":\"$id\",\"status\":\"working\",\"reason\":\"$reason\",\"ts\":\"$(now)\"}"
}

# _last_status <id> -> the task's latest ledger status ("" if unknown).
# Cheap: one pass over the append-only ledger, no herdr call.
_last_status() {
  python3 - "$LEDGER" "$1" <<'PY'
import json, sys
path, id_ = sys.argv[1], sys.argv[2]
last = ""
try:
    for line in open(path):
        line = line.strip()
        if not line:
            continue
        try:
            o = json.loads(line)
        except Exception:
            continue
        if o.get("id") == id_ and o.get("status"):
            last = o["status"]
except OSError:
    pass
print(last)
PY
}

# _record_suppressed <id> <by> <event> <status> <cause> <detail> <marker> <dedupe>
#     durably record a SUPPRESSED settle.
#
# Suppressed is NOT invisible: it goes into the ledger so `list` shows it and
# `reconcile` can re-examine it later. Deliberately does NOT touch the settle
# claim, so the exactly-once gate shared with `done` cannot be poisoned.
#
# <dedupe> picks how repeats are collapsed, because the two suppressions repeat
# for different reasons:
#   marker  ONE record per distinct interruption — skip when the last event for
#           this task is the same event with the same classifier marker (a
#           re-probing watcher/reconcile must not spam the ledger).
#   phase   ONE record per conversational phase — only record when the task is
#           currently 'working'; a brainstorm session goes idle on EVERY turn,
#           and each turn has its own marker, so marker-dedupe would append a
#           line per turn. The phase re-opens when 'resumed'/'handoff' puts the
#           task back to 'working'.
_record_suppressed() {
  local id="$1" by="$2" event="$3" status="$4" cause="$5" detail="$6" marker="$7" dedupe="$8"
  python3 - "$LEDGER" "$id" "$by" "$event" "$status" "$cause" "$detail" "$marker" \
                     "$dedupe" "$(_last_status "$id")" "$(now)" <<'PY'
import json, sys
(ledger, id_, by, event, status, cause, detail, marker, dedupe,
 last_status, ts) = sys.argv[1:12]

last = None
try:
    for line in open(ledger):
        line = line.strip()
        if not line:
            continue
        try:
            o = json.loads(line)
        except Exception:
            continue
        if o.get("id") == id_:
            last = o
except OSError:
    pass

if dedupe == "marker":
    # already recorded THIS interruption -> nothing new to say
    if last and last.get("event") == event and marker and last.get("marker") == marker:
        raise SystemExit(0)
elif dedupe == "phase":
    # the phase is already open (or the task has moved on to a settle/report/
    # wrapup/teardown state) -> nothing new to say
    if last_status != "working":
        raise SystemExit(0)

with open(ledger, "a") as fh:
    fh.write(json.dumps({
        "event": event, "id": id_, "status": status,
        "by": by, "cause": cause, "suppressed": True,
        "detail": detail or None, "marker": marker or None, "ts": ts,
    }) + "\n")
PY
}

# _record_pause <id> <by> <detail> <marker> — the HUMAN stopped the executor.
_record_pause() {
  _record_suppressed "$1" "$2" paused paused-by-human human-interrupt "$3" "$4" marker
}

# _record_conversing <id> <by> <detail> <marker> — a brainstorm session finished
# a conversational turn and is waiting for the human to type. Normal, not news.
_record_conversing() {
  _record_suppressed "$1" "$2" conversing in-conversation conversational-idle "$3" "$4" phase
}

# _settle_forget <id> — drop all claim state (teardown).
_settle_forget() {
  rm -f  "$SETTLE_DIR/$1.claim" 2>/dev/null || true
  rm -rf "$SETTLE_DIR/$1.lock"  2>/dev/null || true
}

# ---------------------------------------------------------------------------
# notify-settle — the ONE place a settle is recorded + announced.
# Used by `done` (executor, primary), `watch` (backstop) and `reconcile`.
# ---------------------------------------------------------------------------
usage_notify_settle() {
  cat >&2 <<EOF
Usage: task-worktree notify-settle <task-id> --by <executor|watcher|reconcile>
                            [--status <awaiting-dispatch|blocked|watcher-failed>]
                            [--note <text>] [--pr <url>] [--commit <sha>]
                            [--body <text> | --body-file <path>]
                            [--dispatch-pane <pane>] [--compare <url>] [--force]
                            [--classify]

  Internal plumbing: takes the settle claim, appends the durable 'settled'
  ledger event, fires the desktop notification and wakes Dispatch — EXACTLY
  ONCE per settle. Prefer 'done' (executors) over calling this directly.

  --classify  Ask 'classify' WHY the agent settled first, and SUPPRESS the wake
              + notification on positive evidence that the HUMAN stopped it
              (recording a durable 'paused' event instead). Used by the backstop
              watcher and reconcile; never by the executor's own 'done'.
              In --mode brainstorm it ALSO suppresses a plain finished turn
              (cause 'completed'), because idle is the resting state of a
              dialogue; that is recorded once as a 'conversing' event. Agent
              errors and anything ambiguous still wake, in every mode.
              Set TASK_SETTLE_CLASSIFY=0 to disable (always wake).
EOF
}

cmd_notify_settle() {
  local id="" by="" status="awaiting-dispatch" note="" pr="" commit=""
  local body="" body_file="" pane_arg="" compare="" force=0 quiet=0 classify=0
  local cause=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --classify)      classify=1; shift ;;
      --by)            by="$2"; shift 2 ;;
      --status)        status="$2"; shift 2 ;;
      --note)          note="$2"; shift 2 ;;
      --pr)            pr="$2"; shift 2 ;;
      --commit)        commit="$2"; shift 2 ;;
      --body)          body="$2"; shift 2 ;;
      --body-file)     body_file="$2"; shift 2 ;;
      --dispatch-pane) pane_arg="$2"; shift 2 ;;
      --compare)       compare="$2"; shift 2 ;;
      --force)         force=1; shift ;;
      --quiet)         quiet=1; shift ;;
      -h|--help)       usage_notify_settle; return 0 ;;
      -*) die "notify-settle: unknown arg '$1'" ;;
      *) [ -n "$id" ] && die "notify-settle: unexpected arg '$1'"; id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || { usage_notify_settle; die "notify-settle: task id required"; }
  [ -n "$by" ] || die "notify-settle: --by required"

  # 0a. WHY did it settle? Only for non-executor paths: the executor's own
  #     'done' is always trusted. Runs BEFORE the claim so a suppression can
  #     never consume/poison the exactly-once gate.
  if [ "$classify" -eq 1 ] && [ "${TASK_SETTLE_CLASSIFY:-1}" != "0" ] && [ "$force" -eq 0 ]; then
    local cls detail marker
    cls="$(_classify_settle "$id")"
    cause="$(printf '%s' "$cls" | cut -f1)"
    detail="$(printf '%s' "$cls" | cut -f2)"
    marker="$(printf '%s' "$cls" | cut -f3)"
    if [ "$cause" = "human-interrupt" ]; then
      # POSITIVE evidence the human stopped it: record, do not wake, do not
      # notify, do not claim. The watcher stays armed; the next genuine settle
      # reports normally.
      _record_pause "$id" "$by" "$detail" "$marker"
      [ "$quiet" -eq 1 ] || \
        info "settle for $id classified as human-interrupt — wake suppressed ($detail)"
      return 0
    fi
    # CONVERSATIONAL IDLE. A brainstorm session is a dialogue: a turn that ended
    # normally means "waiting for the human to type", not "finished". Same grain
    # as the human-interrupt suppression above — record it, do not wake, do not
    # notify, do not claim — and deliberately NARROW:
    #   * only cause 'completed' (a clean end-of-turn). agent-error, mid-tool
    #     and every 'unknown' fall through and wake, so a session whose AGENT
    #     dies is still reported loudly.
    #   * only while the task has not been asked to wrap up. Once `wrapup` has
    #     been requested the dialogue is over, so the backstop is live again and
    #     covers a session that writes its plan but forgets to call `done`.
    if [ "$cause" = "completed" ] \
       && [ "$(_task_field "$id" mode)" = "brainstorm" ] \
       && [ "$(_last_status "$id")" != "wrapping-up" ]; then
      _record_conversing "$id" "$by" "$detail" "$marker"
      [ "$quiet" -eq 1 ] || \
        info "settle for $id is a brainstorm conversational pause — wake suppressed ($detail)"
      return 0
    fi
    [ "$quiet" -eq 1 ] || info "settle for $id classified as '${cause:-unknown}' — waking ($detail)"
  fi

  # 0b. EXACTLY-ONCE GATE.
  if ! _settle_claim "$id" "$by" "$force"; then
    [ "$quiet" -eq 1 ] || info "settle already reported for $id (epoch ${SETTLE_EPOCH:-?}) — $by suppressed"
    return 0
  fi
  local epoch="${SETTLE_EPOCH:-1}"

  local mode branch primary
  mode="$(_task_field "$id" mode)";    [ -n "$mode" ] || mode="code"
  branch="$(_task_field "$id" branch)"
  primary="$(_task_field "$id" primary_repo)"
  if [ -z "$compare" ] && [ "$mode" = "code" ] && [ -n "$branch" ] && [ -n "$primary" ]; then
    compare="$(_compare_url "$primary" "$branch" 2>/dev/null || true)"
  fi

  # 1. The executor's own words, persisted BEFORE any wake so they survive even
  #    if every wake fails and the agent workspace is later torn down.
  local exec_report=""
  if [ -n "$body_file" ]; then
    [ -f "$body_file" ] || die "notify-settle: --body-file not found: $body_file"
    body="$(cat "$body_file")"
  fi
  if [ -n "$body" ]; then
    mkdir -p "$REPORTS_DIR"
    exec_report="$REPORTS_DIR/$id.executor.md"
    {
      printf '%s\n\n' "# Executor report: $id (settle #$epoch, by $by)"
      [ -n "$note" ]    && printf '%s\n' "- **note:** $note"
      [ -n "$pr" ]      && printf '%s\n' "- **pr:** $pr"
      [ -n "$commit" ]  && printf '%s\n' "- **commit:** $commit"
      [ -n "$compare" ] && printf '%s\n' "- **compare:** $compare"
      printf '%s\n\n---\n\n' "- **ts:** $(now)"
      printf '%s\n' "$body"
    } > "$exec_report"
  fi

  # 2. DURABLE ledger event — append-only, survives any wake failure, and makes
  #    `list` accurate with no live polling.
  local entry
  entry="$(python3 - "$id" "$status" "$by" "$epoch" "$note" "$pr" "$commit" \
                    "${exec_report:+reports/$id.executor.md}" "$compare" "$(now)" "$cause" <<'PY'
import json, sys
(id_, status, by, epoch, note, pr, commit, rf, compare, ts, cause) = sys.argv[1:12]
print(json.dumps({
    "event": "settled", "id": id_, "status": status, "by": by,
    "epoch": int(epoch) if str(epoch).isdigit() else None,
    "cause": cause or None,
    "note": note or None, "pr": pr or None, "commit": commit or None,
    "executor_report": rf or None, "compare": compare or None, "ts": ts,
}))
PY
)"
  ledger_append "$entry"

  # 3. Desktop notification for the human (covers the case where every wake fails).
  herdr notification show "Task $id settled ($status)" \
    --body "${note:-Recorded to ledger — Dispatch will report.}" >/dev/null 2>&1 || true

  # 4. Wake Dispatch — retried so a transient busy state can't swallow it.
  local pane; pane="$(_resolve_dispatch_pane "$id" "$pane_arg")"
  if [ -z "$pane" ]; then
    info "warning: could not resolve the Dispatch pane; settle is recorded in the ledger only"
    return 0
  fi
  local msg
  if [ "$by" = "executor" ]; then
    msg="[task-executor] Task $id reports DONE (status: $status)."
  else
    msg="[task-$by] Executor $id settled ($status)."
  fi
  [ "$cause" = "agent-error" ] && \
    msg="$msg WARNING: this settle looks like an AGENT/PROVIDER FAILURE, not a finished task — check the work before reporting it as done."
  [ -n "$note" ]        && msg="$msg Note: $note"
  [ -n "$pr" ]          && msg="$msg PR: $pr"
  [ -n "$compare" ]     && msg="$msg Show the human this GitHub compare link: $compare"
  [ -n "$commit" ]      && msg="$msg Commit: $commit"
  [ -n "$exec_report" ] && msg="$msg Full executor report: reports/$id.executor.md"
  msg="$msg Next: read it (herdr agent read $id) if you need more, then persist it with bin/task-worktree report $id --status awaiting-review --note \"<summary>\"${exec_report:+ --body-file reports/$id.executor.md}, and surface the result to the human."

  local attempt
  for attempt in 1 2 3 4 5; do
    herdr agent prompt "$pane" "$msg" >/dev/null 2>&1 && { 
      [ "$quiet" -eq 1 ] || info "woke Dispatch ($pane) for $id settle #$epoch"
      return 0
    }
    sleep "${TASK_WAKE_RETRY_SLEEP_S:-10}"
  done
  info "warning: could not wake Dispatch ($pane) after 5 attempts; settle #$epoch is still recorded in the ledger"
}

# ---------------------------------------------------------------------------
# done — the executor's PRIMARY completion path
# ---------------------------------------------------------------------------
usage_done() {
  cat >&2 <<EOF
Usage: task-worktree done [<task-id>] --note "<one-line summary>"
                          [--pr <url>] [--commit <sha>]
                          [--body <text> | --body-file <path>]
                          [--blocked] [--force]

  Called BY THE EXECUTOR as its final action, after committing and pushing.
  Records the durable settle event, notifies the human and wakes Dispatch.
  Executors must NEVER call 'herdr agent prompt' by hand.

  The task id defaults to \$TASK_ID, or to TASK_ID in ./task.env (which 'create'
  writes into the task workspace), so plain 'task-worktree done --note ...'
  works from inside a task dir.

  --note      One-line summary (required) — what you did.
  --pr        Pull-request URL, when the brief asked for a PR.
  --commit    Head commit SHA of your branch.
  --body[-file]  Your full markdown report; stored at reports/<id>.executor.md
              so it survives teardown.
  --blocked   You are stopping BLOCKED, not finished (status: blocked).
  --force     Report again even if this settle was already reported.
EOF
}

cmd_done() {
  local id="" status="awaiting-dispatch"
  local -a pass=()
  local note_seen=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --note)      note_seen=1; pass+=(--note "$2"); shift 2 ;;
      --pr|--commit|--body|--body-file|--dispatch-pane|--compare)
                   pass+=("$1" "$2"); shift 2 ;;
      --blocked)   status="blocked"; shift ;;
      --force)     pass+=(--force); shift ;;
      -h|--help)   usage_done; return 0 ;;
      -*) die "done: unknown arg '$1'" ;;
      *) [ -n "$id" ] && die "done: unexpected arg '$1'"; id="$1"; shift ;;
    esac
  done

  # Work out who we are without guessing: explicit arg > \$TASK_ID > ./task.env.
  [ -n "$id" ] || id="${TASK_ID:-}"
  if [ -z "$id" ] && [ -f "./task.env" ]; then
    id="$(. ./task.env >/dev/null 2>&1; printf '%s' "${TASK_ID:-}")"
  fi
  [ -n "$id" ] || { usage_done; die "done: task id required (no \$TASK_ID and no ./task.env)"; }
  [ "$note_seen" -eq 1 ] || { usage_done; die "done: --note is required"; }
  [ -n "$(_find_created_rec "$id")" ] || die "done: no ledger record for task '$id'"

  cmd_notify_settle "$id" --by executor --status "$status" ${pass[@]+"${pass[@]}"}
}

# ---------------------------------------------------------------------------
# watch — the detached settle BACKSTOP (armed by create; runs as its own process)
# ---------------------------------------------------------------------------
usage_watch() {
  cat >&2 <<EOF
Usage: task-worktree watch <task-id> [--dispatch-pane <pane>] [--compare <url>]

  Long-running BACKSTOP for one task. Waits for the executor to settle and
  hands the settle to 'notify-settle', which de-duplicates against the
  executor's own 'done'. Re-arms after every settle. Normally started detached
  by 'create'; run it in the foreground to debug (logs to .dispatch/logs/).

  Every settle it sees is CLASSIFIED first (see 'classify'): a settle caused by
  the HUMAN stopping the executor is recorded as 'paused-by-human' and does NOT
  wake Dispatch, while completions, blocks, agent errors and anything ambiguous
  do. The watcher stays armed either way.

  In --mode brainstorm a plain finished turn is ALSO suppressed (the session is
  a dialogue, so idle is its resting state; it is recorded once as
  'in-conversation'). Agent errors, a vanished agent, and anything ambiguous
  still wake — the session DYING is not a conversational pause.
EOF
}

_watch_log() { printf '%s %s\n' "$(now)" "$*" >> "$WATCH_LOG"; }

# _watch_abort <id> <reason> — fail LOUD: log it, tell the human, and record a
# durable ledger event + wake so a broken watcher can never fail silently.
_watch_abort() {
  local id="$1" reason="$2"
  _watch_log "ABORT: $reason"
  herdr notification show "Task watcher FAILED ($id)" \
    --body "$reason — see ${WATCH_LOG#$ROOT/}" >/dev/null 2>&1 || true
  cmd_notify_settle "$id" --by watcher --status watcher-failed --force \
    --note "watcher aborted: $reason (log: ${WATCH_LOG#$ROOT/}) — check this task's real state with bin/task-worktree reconcile" \
    >/dev/null 2>&1 || true
  exit 1
}

# _watch_gone <id> — the executor's agent vanished while the task was still open
# (it crashed, or its workspace was closed). That is a REAL event the human must
# hear about, so it always wakes — it is never classified or suppressed.
_watch_gone() {
  local id="$1"
  _watch_log "ABORT: executor agent vanished while the task was still open — reporting orphaned"
  herdr notification show "Executor $id DIED ($id)" \
    --body "the agent is gone but the task is still open" >/dev/null 2>&1 || true
  cmd_notify_settle "$id" --by watcher --status orphaned --force \
    --note "the executor agent is GONE (crashed or its workspace was closed) while the task was still open — nothing was self-reported; inspect the branch, then handoff or close it" \
    >/dev/null 2>&1 || true
  exit 1
}

# _watch_rc2 <id> — the one place a fatal herdr probe (rc 2) is interpreted.
# Never returns: the task was torn down (clean exit), the executor's agent is
# gone (loud 'orphaned' wake), or herdr itself failed (loud 'watcher-failed').
_watch_rc2() {
  local id="$1"
  if [ ! -d "$TASKS_DIR/$id" ]; then
    _watch_log "task dir gone — task closed; watcher exiting cleanly"; exit 0
  fi
  case "$HWAIT_ERR" in
    *"agent not found"*|*agent_not_found*) _watch_gone "$id" ;;
  esac
  _watch_abort "$id" "$HWAIT_ERR"
}

cmd_watch() {
  local id="" pane="" compare=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dispatch-pane) pane="$2"; shift 2 ;;
      --compare)       compare="$2"; shift 2 ;;
      -h|--help)       usage_watch; return 0 ;;
      -*) die "watch: unknown arg '$1'" ;;
      *) [ -n "$id" ] && die "watch: unexpected arg '$1'"; id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || { usage_watch; die "watch: task id required"; }

  mkdir -p "$LOG_DIR"
  WATCH_LOG="$LOG_DIR/watch-$id.log"

  # DEBOUNCE: seconds the executor must stay settled before we trust a settle.
  # A freshly-booted agent momentarily reports idle/done BEFORE it starts
  # working, so a single wait can latch onto that boot transient and fire a
  # false settle. Two defences, both preserved from the debounce fix:
  #   (1) require having WITNESSED a genuine working phase, and
  #   (2) require the settle to persist across the debounce window.
  # These sleeps live in this DETACHED process — they never block Dispatch.
  local debounce="${TASK_WATCH_DEBOUNCE:-5}"
  # SAFETY VALVE: the maximum number of inconclusive probes before we give up
  # and fail loud. The old watcher could spin here forever, recording nothing.
  local max_spins="${TASK_WATCH_MAX_SPINS:-120}"
  # How long each blocking herdr wait may run before we re-probe. Bounded on
  # purpose: an unbounded wait never returns if the agent disappears mid-wait.
  local probe_ms="${TASK_WATCH_PROBE_TIMEOUT_MS:-60000}"
  local resume_ms="${TASK_WATCH_RESUME_TIMEOUT_MS:-30000}"
  # How long phase 1 may block waiting to witness a genuine work phase, and how
  # long the re-arm loop backs off once it has given up on a resume. Both are
  # overridable purely so the selftest can drive this loop at millisecond
  # speed; the DEFAULTS here are the production values and must not shrink.
  local witness_ms="${TASK_WATCH_WITNESS_TIMEOUT_MS:-30000}"
  local witness_tries="${TASK_WATCH_WITNESS_TRIES:-6}"
  local rearm_backoff_s="${TASK_WATCH_REARM_BACKOFF_S:-30}"

  _watch_log "watch start (pid $$, debounce=${debounce}s, max_spins=$max_spins, pane=${pane:-auto})"

  local rc st spins n

  # Phase 1 — WITNESS a genuine work phase (first cycle only). The boot
  # transient can satisfy a bare "--until working" wait, so we additionally
  # require a fresh probe to read the agent as actually working. If the agent
  # never shows work across all attempts (a genuinely fast task that finished
  # before we looked), fall through — phase 2's debounce still guards us.
  local witnessed=0
  n=0
  while [ "$n" -lt "$witness_tries" ]; do
    n=$((n + 1))
    rc=0; _hwait "$id" --until working --timeout "$witness_ms" || rc=$?
    [ "$rc" -ge 2 ] && _watch_rc2 "$id"
    if [ "$(_agent_status "$id")" = "working" ]; then witnessed=1; break; fi
    sleep "$debounce"
  done
  _watch_log "phase 1 done: witnessed=$witnessed"

  # RE-ARMING LOOP: report EVERY settle.
  while :; do
    # Phase 2 — wait for a settle that HOLDS across the debounce window.
    # NOTE: a BARE wait already means idle|done|blocked. Never write
    # '--until idle done blocked' — herdr exits rc=2 on that.
    spins=0
    local gone=0
    while :; do
      # BOUNDED: an unbounded `herdr agent wait` never returns if the agent
      # disappears mid-wait, which used to leave the watcher hung forever on a
      # crashed executor. Timing out and re-probing is what makes the
      # crash/vanish path below reachable at all.
      rc=0; _hwait "$id" --timeout "$probe_ms" || rc=$?
      [ "$rc" -ge 2 ] && _watch_rc2 "$id"          # torn down / gone / broken
      sleep "$debounce"
      st="$(_agent_status "$id")"
      case "$st" in
        idle|done|blocked) break ;;                     # a real, held settle
        working) gone=0 ;;                              # resumed mid-window
        "") if [ ! -d "$TASKS_DIR/$id" ]; then
              _watch_log "agent gone + task dir gone — exiting cleanly"; return 0
            fi
            # the task is still open but its agent is gone: confirm once, then
            # report it LOUD rather than spinning for an hour.
            gone=$((gone + 1))
            [ "$gone" -ge 2 ] && _watch_gone "$id"
            ;;
      esac
      spins=$((spins + 1))
      [ "$spins" -gt "$max_spins" ] && \
        _watch_abort "$id" "settle never stabilised after $max_spins probes (last status: '${st:-gone}')"
      _watch_log "settle not held (status='${st:-gone}'), spin $spins/$max_spins"
    done

    local status="awaiting-dispatch"
    [ "$st" = "blocked" ] && status="blocked"
    _watch_log "settled: status=$status"

    # Hand off to the shared path — it de-duplicates against the executor's
    # own 'done', so Dispatch is woken exactly once for this settle.
    # Classify BEFORE waking: a human /stop also reads as 'idle', and waking
    # Dispatch for that reports a half-finished task as if it were done.
    local cls="" cause="" marker=""
    cls="$(_classify_settle "$id")"
    cause="$(printf '%s' "$cls" | cut -f1)"
    marker="$(printf '%s' "$cls" | cut -f3)"
    _watch_log "classified: $cls"

    cmd_notify_settle "$id" --by watcher --status "$status" --quiet --classify \
      ${pane:+--dispatch-pane "$pane"} ${compare:+--compare "$compare"} \
      >>"$WATCH_LOG" 2>&1 || _watch_log "warning: notify-settle failed (see above)"
    [ "$cause" = "human-interrupt" ] && \
      _watch_log "wake SUPPRESSED (human interrupt); recorded as paused-by-human, staying armed"
    [ "$cause" = "completed" ] && [ "$(_task_field "$id" mode)" = "brainstorm" ] && \
      _watch_log "wake possibly SUPPRESSED (brainstorm conversational pause); staying armed"

    # RE-ARM: park until the executor genuinely resumes work, then release the
    # settle claim so the NEXT settle reports again.
    #
    # Two ways out, because a short steered turn can start AND finish inside our
    # blind spot (that used to deadlock the watcher here, waiting forever for a
    # 'working' it had already missed):
    #   (a) we observe the agent working, or
    #   (b) pi's session log has moved past the settle we just handled, which
    #       means a whole new turn came and went -> a new settle is pending.
    spins=0
    while :; do
      if [ "$(_agent_status "$id")" = "working" ]; then break; fi
      local now_marker
      now_marker="$(_classify_settle "$id" | cut -f3)"
      if [ -n "$marker" ] && [ -n "$now_marker" ] && [ "$now_marker" != "$marker" ]; then
        _watch_log "re-arm: session advanced ($marker -> $now_marker) while parked; a new settle is pending"
        break
      fi
      # A bounded wait: rc 0 = resumed, rc 1 = still parked (re-check above).
      rc=0; _hwait "$id" --until working --timeout "$resume_ms" || rc=$?
      [ "$rc" -ge 2 ] && _watch_rc2 "$id"
      [ "$rc" -eq 0 ] && break
      spins=$((spins + 1))
      # Nothing is pending here (the settle is already recorded), so we back off
      # instead of aborting — but we never hot-spin.
      if [ "$spins" -gt "$max_spins" ]; then
        _watch_log "re-arm: no resume after $spins probes; backing off"
        sleep "$rearm_backoff_s"
      fi
    done
    witnessed=1
    _settle_release "$id" "executor resumed work"
    _watch_log "re-armed: executor resumed work"
  done
}

# ---------------------------------------------------------------------------
# create
# ---------------------------------------------------------------------------

# _resolve_repo <repo> -> ensures \$REPOS/<repo> resolves to a git repo,
# creating the on-demand symlink when we can work out where it lives.
# Dies with an EXACT fix-it command when we can't.
_resolve_repo() {
  local repo="$1" target=""
  if [ -d "$REPOS/$repo/.git" ] || [ -e "$REPOS/$repo/.git" ]; then return 0; fi

  # Candidates, best first:
  #   1. the Dispatch root itself (this harness repo is usually linked in as
  #      \$REPOS/<root-basename> -> the root; that link is easy to lose)
  #   2. an existing repo-view symlink at the root
  if [ "$repo" = "$(basename "$ROOT")" ] && [ -e "$ROOT/.git" ]; then
    target="$ROOT"
  elif [ -L "$ROOT/$repo" ]; then
    local t; t="$(cd "$ROOT" && readlink "$repo")"
    [ -e "$t/.git" ] && target="$t"
  fi

  if [ -n "$target" ]; then
    [ -e "$REPOS/$repo" ] && rm -f "$REPOS/$repo"
    ln -s "$target" "$REPOS/$repo"
    info "restored missing repo link: $REPOS/$repo -> $target"
    return 0
  fi

  die "repo '$repo' is not a git repo under $REPOS (missing: $REPOS/$repo).
Fix it with ONE of:
  ln -s /path/to/$repo $REPOS/$repo        # link an existing checkout
  git -C $REPOS clone <remote-url> $repo   # or clone it
Then re-run this command."
}

# _done_brief <id> <compare-url> [mode] -> the completion contract appended to
# every executor briefing, so the executor always knows how to reach Dispatch.
_done_brief() {
  local id="$1" compare="${2:-}" mode="${3:-code}"
  if [ "$mode" = "brainstorm" ]; then
    printf '%s\n' "Your task id is $id (also in ./task.env). This is a BRAINSTORM session: you are in a dialogue with a human and you do NOT commit, push or open PRs. Going idle between turns is normal and reports nothing. ONLY when the human ends the session (they say to write it up, or a wrap-up request arrives from Dispatch) do you deliver the plan — that delivery is your FINAL action:
  $SELF done $id --note \"<one-line summary of the plan>\" --body-file <path-to-your-plan.md>
(use --blocked instead if you are stopping blocked). Never run 'herdr agent prompt' by hand."
    return 0
  fi
  printf '%s' "Your task id is $id (also in ./task.env). When you are finished — after committing and pushing — your FINAL action MUST be to tell Dispatch yourself:
  $SELF done $id --note \"<one-line summary>\" [--pr <url>] [--body-file <path-to-your-report.md>]
(use --blocked instead of finishing if you are stopping blocked). Never run 'herdr agent prompt' by hand."
  [ -n "$compare" ] && printf '%s' "
Compare link for your branch: $compare"
  printf '\n'
}

# ---------------------------------------------------------------------------
# create --pr : attach a task to an EXISTING open GitHub PR (Autopilot)
#
# The point of `--pr` is that the worktree must be the PR's own head branch, not
# a fresh branch off main: an autopilot task exists to fix conflicts/review
# comments/CI *on that PR*. So `--pr` OWNS the branch and the base, which is why
# combining it with --branch/--base is a hard error rather than a merge of
# intents. gh is the source of truth for the PR (state + head ref); we refuse
# anything that is not open.
# ---------------------------------------------------------------------------
PR_NUMBER=""; PR_URL=""; PR_BRANCH=""      # set by _resolve_pr

# _resolve_pr <repo> <number-or-url> -> sets PR_NUMBER / PR_URL / PR_BRANCH
_resolve_pr() {
  local repo="$1" want="$2" slug out rc=0 state
  case "$want" in
    *://*) want="${want##*/}" ;;              # .../pull/123 -> 123
    '#'*)  want="${want#\#}" ;;
  esac
  case "$want" in
    ''|*[!0-9]*) die "create: --pr wants a PR number or url (got '$2')" ;;
  esac

  slug="$(_github_slug "$repo")"
  [ -n "$slug" ] || die "create: --pr needs repo '$repo' to have a GitHub origin remote"

  out="$(gh pr view "$want" --repo "$slug" \
          --json number,state,headRefName,url,isCrossRepository 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] || die "create: gh could not read PR #$want in $slug: $out"

  state="$(python3 - "$out" <<'PY'
import json, sys
d = json.loads(sys.argv[1])
print("\t".join([str(d.get("number", "")), (d.get("state") or "").upper(),
                 d.get("headRefName") or "", d.get("url") or "",
                 "fork" if d.get("isCrossRepository") else ""]))
PY
)" || die "create: could not parse gh output for PR #$want"

  PR_NUMBER="$(printf '%s' "$state" | cut -f1)"
  local st fork
  st="$(printf '%s' "$state" | cut -f2)"
  PR_BRANCH="$(printf '%s' "$state" | cut -f3)"
  PR_URL="$(printf '%s' "$state" | cut -f4)"
  fork="$(printf '%s' "$state" | cut -f5)"

  [ "$st" = "OPEN" ] || die "create: PR #$PR_NUMBER in $slug is $st, not open — nothing to autopilot"
  [ -n "$PR_BRANCH" ] || die "create: PR #$PR_NUMBER has no head branch (gh returned: $out)"
  [ -z "$fork" ] || die "create: PR #$PR_NUMBER comes from a fork; its head branch is not on $slug's origin"
  [ -n "$PR_URL" ] || PR_URL="https://github.com/$slug/pull/$PR_NUMBER"
}

AUTOPILOT_PROMPT="$DISPATCH_DIR/autopilot.PROMPT.md"
BRAINSTORM_PROMPT="$DISPATCH_DIR/brainstorm.PROMPT.md"

# _skill_fragment <skill> -> path of the guidance fragment for one skill
_skill_fragment() { printf '%s/brainstorm.skill-%s.md\n' "$DISPATCH_DIR" "$1"; }

# _brainstorm_prompt <task-id> <repo> <branch> <skills> -> the rendered brief.
#
# brainstorm.PROMPT.md is only the SHARED FRAME (it is a dialogue, one question
# at a time, read the code before asserting, the wrap-up format). The actual
# working method is composed in from the SELECTED skills' fragments, so a
# grill-only session is a grilling session rather than a brainstorm wearing a
# grill hat.
_brainstorm_prompt() {
  local id="$1" repo="$2" branch="$3" skills="$4" guidance="" s f
  [ -f "$BRAINSTORM_PROMPT" ] \
    || die "create: --mode brainstorm needs the prompt template at $BRAINSTORM_PROMPT (or pass --prompt)"
  for s in $(_skill_list "$skills"); do
    f="$(_skill_fragment "$s")"
    [ -f "$f" ] || die "create: missing skill guidance fragment for '--skill $s': $f"
    guidance="$guidance$(cat "$f")

"
  done
  python3 - "$BRAINSTORM_PROMPT" "$id" "$repo" "$branch" "$skills" "$guidance" <<'PY'
import sys
path, tid, repo, branch, skills, guidance = sys.argv[1:7]
with open(path) as fh:
    text = fh.read()
for k, v in (("TASK_ID", tid), ("REPO", repo), ("BRANCH", branch),
             ("SKILLS", skills), ("SKILL_GUIDANCE", guidance.rstrip() + "\n")):
    text = text.replace("{{%s}}" % k, v)
sys.stdout.write(text)
PY
}

# _skill_list <selection> -> the skill fragment names the selection expands to
_skill_list() {
  case "$1" in
    both) printf 'brainstorm grill\n' ;;
    *)    printf '%s\n' "$1" ;;
  esac
}

# _require_skill_choice <selection> — a brainstorm session's NATURE is the
# human's call, never Dispatch's, so there is deliberately NO default here.
_require_skill_choice() {
  case "${1:-}" in
    brainstorm|grill|both) return 0 ;;
    '') die "create: --mode brainstorm requires an explicit --skill <brainstorm|grill|both>.
DISPATCH: STOP AND ASK THE HUMAN which skills this session should use — do NOT
choose on their behalf and do NOT default to 'both'. Ask: 'brainstorming, grilling,
or both?', then re-run create with their answer." ;;
    *) die "create: --skill must be 'brainstorm', 'grill' or 'both' (got '$1')" ;;
  esac
}

# _autopilot_prompt <repo> <pr-number> <pr-url> <branch> -> the rendered brief
_autopilot_prompt() {
  [ -f "$AUTOPILOT_PROMPT" ] \
    || die "create: --pr needs the autopilot prompt template at $AUTOPILOT_PROMPT (or pass --prompt)"
  python3 - "$AUTOPILOT_PROMPT" "$1" "$2" "$3" "$4" <<'PY'
import sys
path, repo, num, url, branch = sys.argv[1:6]
with open(path) as fh:
    text = fh.read()
for k, v in (("REPO", repo), ("PR_NUMBER", num), ("PR_URL", url), ("BRANCH", branch)):
    text = text.replace("{{%s}}" % k, v)
sys.stdout.write(text)
PY
}

usage_create() {
  cat >&2 <<EOF
Usage: task-worktree create --slug <name> --repo <repo> [--repo <repo> ...]
                            [--branch <name>] [--base <ref>] [--pr <n|url>]
                            [--mode <mode>]
                            [--agent <kind>] [--request "<your words>"]
                            [--prompt "<opening instruction>"] [--no-agent]

  --slug     Human slug for the task (a short nonce is appended -> the task id).
             Optional with --pr (defaults to 'autopilot-pr-<n>').
  --repo     Repo under \$REPOS to work in. First --repo is the primary.
             Repeat for multi-repo tasks.
  --branch   Branch name (default: the task id).
  --base     Base ref for new branches (default: HEAD of each repo).
  --pr       Attach the task to an EXISTING open GitHub PR (number or url),
             resolved with gh against the first --repo. The worktree is that
             PR's head branch (base origin/<head>), the executor is briefed
             with the autopilot loop, and TASK_PR_URL/TASK_PR_NUMBER land in
             task.env. Cannot be combined with --branch or --base; --slug,
             --request and --prompt still override their defaults.
  --mode     Task lifecycle (default: 'code'):
               code        touches the tree; stays open for review, closed later.
               investigate read-only find/answer; reports and auto-closes itself.
               brainstorm  a LIVE dialogue the HUMAN drives in the session's own
                           pane. Idle is its resting state, so it never wakes
                           Dispatch on a conversational turn; it ends when the
                           human says so (or via 'wrapup'), delivers a plan to
                           reports/<id>.md, and then auto-closes.
  --skill    REQUIRED with --mode brainstorm, and only valid there. Which skills
             the session is briefed with: 'brainstorm', 'grill' or 'both'.
             There is no default on purpose: ASK THE HUMAN which they want.
  --agent    Executor agent kind (default: \$TASK_AGENT_KIND or 'pi').
  --request  Your original request, recorded in the ledger.
  --prompt   Opening instruction handed to the executor agent.
  --no-agent Prepare worktrees + task dir only; do not spawn an agent.
EOF
}

cmd_create() {
  local slug="" branch="" base="" agent="$DEFAULT_AGENT_KIND"
  local request="" prompt="" no_agent=0 mode="code" pr="" skills=""
  local -a repos=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --skill)   skills="$2"; shift 2 ;;
      --slug)    slug="$2"; shift 2 ;;
      --repo)    repos+=("$2"); shift 2 ;;
      --branch)  branch="$2"; shift 2 ;;
      --base)    base="$2"; shift 2 ;;
      --pr)      pr="$2"; shift 2 ;;
      --mode)    mode="$2"; shift 2 ;;
      --agent)   agent="$2"; shift 2 ;;
      --request) request="$2"; shift 2 ;;
      --prompt)  prompt="$2"; shift 2 ;;
      --no-agent) no_agent=1; shift ;;
      -h|--help) usage_create; return 0 ;;
      *) die "create: unknown arg '$1'" ;;
    esac
  done

  [ "${#repos[@]}" -gt 0 ] || { usage_create; die "create: at least one --repo required"; }
  case "$mode" in
    code|investigate|brainstorm) ;;
    *) die "create: --mode must be 'code', 'investigate' or 'brainstorm' (got '$mode')" ;;
  esac

  # The skill selection is validated BEFORE anything is created, so a session
  # whose nature was never chosen never gets a worktree.
  if [ "$mode" = "brainstorm" ]; then
    [ -z "$pr" ] || die "create: --pr cannot be combined with --mode brainstorm (a PR is code work, not a dialogue)"
    _require_skill_choice "$skills"
  else
    [ -z "$skills" ] || die "create: --skill only applies to --mode brainstorm (got --mode $mode)"
  fi

  # --pr: resolve the PR FIRST, so nothing is created for a PR we will refuse.
  if [ -n "$pr" ]; then
    [ -z "$branch" ] || die "create: --pr cannot be combined with --branch (the PR's head branch is used)"
    [ -z "$base" ]   || die "create: --pr cannot be combined with --base (the PR head tip is the base)"
    [ "${#repos[@]}" -eq 1 ] \
      || die "create: --pr takes exactly one --repo (the PR lives in one repo; got ${#repos[@]})"
    have gh || die "create: --pr needs the GitHub CLI ('gh') on PATH"
    _resolve_repo "${repos[0]}"
    _resolve_pr "${repos[0]}" "$pr"
    branch="$PR_BRANCH"
    base="origin/$PR_BRANCH"
    info "PR #$PR_NUMBER: $PR_URL (head: $branch)"
    info "fetching PR head ${repos[0]}/$branch ..."
    git -C "$REPOS/${repos[0]}" fetch --quiet origin \
        "+refs/heads/$branch:refs/remotes/origin/$branch" 2>/dev/null \
      || info "warning: fetch failed for ${repos[0]} (falling back to the local remote-tracking ref)"
    git -C "$REPOS/${repos[0]}" rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null \
      || die "create: cannot resolve origin/$branch in ${repos[0]} — fetch the PR head and retry"
    [ -n "$slug" ]    || slug="autopilot-pr-$PR_NUMBER"
    [ -n "$request" ] || request="Autopilot PR $PR_NUMBER"
    [ -n "$prompt" ]  || prompt="$(_autopilot_prompt "${repos[0]}" "$PR_NUMBER" "$PR_URL" "$branch")"
  fi

  [ -n "$slug" ] || { usage_create; die "create: --slug required"; }

  # sanitize slug: lowercase, non-alnum -> '-'
  slug="$(printf '%s' "$slug" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-//; s/-$//')"
  [ -n "$slug" ] || die "create: --slug produced an empty slug"
  local id="${slug}-$(nonce)"
  [ -n "$branch" ] || branch="$id"

  # validate repos exist (restoring a lost on-demand link when we can)
  local repo
  for repo in "${repos[@]}"; do
    _resolve_repo "$repo"
  done

  # The brainstorm brief needs the id/branch, so it is rendered here — still
  # before any worktree exists, so a broken template fails cheaply.
  if [ "$mode" = "brainstorm" ] && [ -z "$prompt" ]; then
    prompt="$(_brainstorm_prompt "$id" "${repos[0]}" "$branch" "$skills")"
  fi

  info "task id: $id  branch: $branch  mode: $mode  repos: ${repos[*]}${skills:+  skills: $skills}"

  local task_dir="$TASKS_DIR/$id"
  [ -e "$task_dir" ] && die "task dir already exists: $task_dir"
  mkdir -p "$task_dir"

  # per-repo worktree creation
  local -a wt_workspaces=()
  local -a wt_records=()
  local primary="${repos[0]}"
  for repo in "${repos[@]}"; do
    # 1. lazy on-demand repo symlink at root
    if [ ! -e "$ROOT/$repo" ]; then
      ln -s "$REPOS/$repo" "$ROOT/$repo"
      info "linked repo view: $repo -> $REPOS/$repo"
    fi

    # 2. create the worktree via herdr (authoritative)
    local checkout="$WORKTREE_STORE/$repo/$branch"
    # Base selection: an explicit --base always wins ("unless specified").
    # Otherwise start from the FRESHLY-FETCHED latest main tip so we never
    # branch off a stale local checkout.
    local repo_base="$base"
    if [ -z "$repo_base" ]; then
      local main_branch; main_branch="$(_default_branch "$repo")"
      info "fetching latest $repo/$main_branch ..."
      git -C "$REPOS/$repo" fetch --quiet origin "$main_branch" 2>/dev/null \
        || info "warning: fetch failed for $repo (continuing from local ref)"
      repo_base="origin/$main_branch"
    fi
    info "base: $repo @ $repo_base"
    local -a base_args=(--base "$repo_base")
    local out
    out="$(herdr worktree create \
      --cwd "$REPOS/$repo" \
      --branch "$branch" \
      ${base_args[@]+"${base_args[@]}"} \
      --path "$checkout" \
      --label "$repo" \
      --no-focus 2>&1)" || { printf '%s\n' "$out" >&2; die "herdr worktree create failed for $repo"; }

    local wsid path
    wsid="$(jget "$out" "d['result']['workspace']['workspace_id']")"
    path="$(jget "$out" "d['result']['worktree']['path']")"
    wt_workspaces+=("$wsid")
    info "worktree: $repo@$branch -> $path (ws $wsid)"

    # 3. symlink into the flat worktree view
    mkdir -p "$WORKTREE_VIEW/$repo/$(dirname "$branch")"
    ln -sfn "$path" "$WORKTREE_VIEW/$repo/$branch"

    # 4. symlink into the ephemeral task dir (executor's isolated view)
    ln -sfn "$WORKTREE_VIEW/$repo/$branch" "$task_dir/$repo"

    wt_records+=("{\"repo\":\"$repo\",\"branch\":\"$branch\",\"workspace_id\":\"$wsid\",\"path\":\"$path\"}")
  done

  # executor AGENTS.md into the task dir
  ln -sfn "$EXECUTOR_CONTEXT" "$task_dir/AGENTS.md"

  # Dispatch's own pane: resolved ONCE, here, where $HERDR_PANE_ID legitimately
  # belongs to Dispatch (it is running this command). It is then persisted into
  # the task workspace + ledger so the executor's `done` never has to guess.
  local dispatch_pane="${DISPATCH_PANE_ID:-${HERDR_PANE_ID:-}}"
  [ -n "$dispatch_pane" ] || dispatch_pane="$(_discover_dispatch_pane)"
  local task_compare=""
  [ "$mode" = "code" ] && task_compare="$(_compare_url "$primary" "$branch" 2>/dev/null || true)"

  # task.env — the executor's identity kit. Sourced by `task-worktree done`, and
  # readable by the executor itself.
  cat > "$task_dir/task.env" <<EOF
# Identity of this task — written by 'task-worktree create'. Source it or read it.
TASK_ID="$id"
TASK_SLUG="$slug"
TASK_MODE="$mode"
TASK_SKILLS="$skills"
TASK_BRANCH="$branch"
TASK_PRIMARY_REPO="$primary"
TASK_REPOS="${repos[*]}"
TASK_DISPATCH_PANE="$dispatch_pane"
TASK_COMPARE_URL="$task_compare"
TASK_PR_NUMBER="$PR_NUMBER"
TASK_PR_URL="$PR_URL"
TASK_WORKTREE_BIN="$SELF"
EOF

  # spawn executor agent in an isolated workspace rooted at the task dir
  local exec_wsid="" exec_pane=""
  if [ "$no_agent" -eq 0 ]; then
    local out
    out="$(herdr workspace create --cwd "$task_dir" --label "$id" --no-focus 2>&1)" \
      || { printf '%s\n' "$out" >&2; die "herdr workspace create failed"; }
    exec_wsid="$(jget "$out" "d['result']['workspace']['workspace_id']")"
    exec_pane="$(jget "$out" "d['result']['root_pane']['pane_id']")"
    info "executor workspace: $exec_wsid  pane: $exec_pane"

    herdr agent start "$id" --kind "$agent" --pane "$exec_pane" >/dev/null 2>&1 \
      || die "herdr agent start failed (kind=$agent pane=$exec_pane)"
    info "started $agent agent '$id'"

    if [ -n "$prompt" ]; then
      local full="$prompt

Read ./AGENTS.md first — it defines how you must operate as a task executor. Primary repo: $primary (branch $branch).
$(_done_brief "$id" "$task_compare" "$mode")"
      herdr agent prompt "$id" "$full" >/dev/null 2>&1 \
        || info "warning: agent prompt submission failed; brief the agent manually"
    fi

    # BACKSTOP watcher: a detached `task-worktree watch` process. It never
    # blocks Dispatch and never polls Dispatch; it waits on herdr for the
    # executor to settle and then goes through the SAME notify-settle path the
    # executor's own `done` uses, so the two can't double-report. It lives in
    # its own process (not an inline heredoc) so it can be run and tested
    # directly: bin/task-worktree watch <id>.
    nohup "$SELF" watch "$id" \
      ${dispatch_pane:+--dispatch-pane "$dispatch_pane"} \
      ${task_compare:+--compare "$task_compare"} \
      >>"$LOG_DIR/watch-$id.log" 2>&1 &
    disown 2>/dev/null || true
    info "backstop watcher armed for $id (log: .dispatch/logs/watch-$id.log); primary path is the executor's own 'done'"

    # A brainstorm session is USELESS unless the human can reach it: the whole
    # mode is "talk to this agent yourself". So say exactly how, loudly.
    if [ "$mode" = "brainstorm" ]; then
      cat >&2 <<EOF

💬 brainstorm session '$id' is LIVE (skills: $skills) and waiting for the HUMAN.
   It is a dialogue — nobody reports until you end it. Attach to its pane:

     herdr agent focus $id        # jump to it in the current herdr session
     herdr agent attach $id       # or attach directly to its terminal

   pane: $exec_pane   workspace: $exec_wsid
   End it by telling the session to write it up, or (on the HUMAN's word only):
     $SELF wrapup $id
EOF
    fi
  fi


  # ledger entry
  local wts; wts="$(IFS=,; echo "${wt_records[*]}")"
  local entry
  entry="$(python3 - "$id" "$slug" "$branch" "$primary" "$agent" \
                    "$request" "$prompt" "$exec_wsid" "$mode" "$(now)" "$wts" \
                    "$dispatch_pane" "$task_compare" "$PR_NUMBER" "$PR_URL" "$skills" <<'PY'
import json, sys
(id_, slug, branch, primary, agent, request, prompt, exec_ws, mode, ts, wts,
 pane, compare, pr_num, pr_url, skills) = sys.argv[1:17]
print(json.dumps({
    "event": "created",
    "id": id_, "slug": slug, "branch": branch, "primary_repo": primary,
    "agent_kind": agent, "mode": mode, "skills": skills or None,
    "request": request, "prompt": prompt,
    "executor_workspace_id": exec_ws or None,
    "dispatch_pane": pane or None, "compare": compare or None,
    "pr_number": int(pr_num) if pr_num else None, "pr_url": pr_url or None,
    "worktrees": json.loads("[" + wts + "]"),
    "status": "working", "ts": ts,
}))
PY
)"
  ledger_append "$entry"
  # A fresh task is a fresh settle epoch.
  _settle_forget "$id"

  printf '\n✔ task %s ready\n  task dir: %s\n' "$id" "$task_dir" >&2
  echo "$id"
}

# ---------------------------------------------------------------------------
# remove
# ---------------------------------------------------------------------------
usage_remove() {
  cat >&2 <<EOF
Usage: task-worktree remove <task-id> [--delete-branch]

  Tears down herdr worktree workspaces, the executor workspace, the flat
  worktree symlinks, the ephemeral task dir, and unused repo symlinks.
  The git branch is kept by default (it holds the work); pass --delete-branch
  to also delete it.
EOF
}

# _find_created_rec <id>  -> prints the latest task record (or empty).
# Matches 'created' OR 'handoff' events: a handoff replaces the executor and
# carries a FRESH executor_workspace_id plus the copied worktrees/branch/mode,
# so teardown/report always act on the LIVE workspace, not a stale one.
_find_created_rec() {
  python3 - "$LEDGER" "$1" <<'PY'
import json, sys
path, id_ = sys.argv[1], sys.argv[2]
found = None
for line in open(path):
    line = line.strip()
    if not line: continue
    try: o = json.loads(line)
    except Exception: continue
    if o.get("id") == id_ and o.get("event") in ("created", "handoff"):
        found = o
print(json.dumps(found) if found else "")
PY
}

# _teardown_from_rec <rec-json> <delete_branch 0|1> <id>
# Tears down herdr worktrees, the executor workspace, view symlinks, the task
# dir, and records a 'closed' event. Shared by `remove` and investigate
# auto-close. Callers must persist any report BEFORE invoking this.
_teardown_from_rec() {
  local rec="$1" delete_branch="$2" id="$3"

  # Stop the backstop watcher first so it can't fire on the agent disappearing.
  pkill -f "task-worktree watch $id" >/dev/null 2>&1 \
    && info "stopped backstop watcher for $id" || true
  _settle_forget "$id"

  python3 - "$rec" <<'PY' | while IFS=$'\t' read -r wsid repo branch path; do
import json, sys
o = json.loads(sys.argv[1])
for w in o.get("worktrees", []):
    print("\t".join([w["workspace_id"], w["repo"], w["branch"], w["path"]]))
PY
    info "removing worktree $repo@$branch (ws $wsid)"
    herdr worktree remove --workspace "$wsid" --force >/dev/null 2>&1 \
      || info "warning: herdr worktree remove failed for $wsid (continuing)"
    rm -f "$WORKTREE_VIEW/$repo/$branch"
    if [ "$delete_branch" -eq 1 ]; then
      git -C "$REPOS/$repo" branch -D "$branch" >/dev/null 2>&1 \
        && info "deleted branch $repo@$branch" || true
    fi
  done

  local exec_ws; exec_ws="$(jget "$rec" "d.get('executor_workspace_id') or ''" 2>/dev/null || true)"
  if [ -n "$exec_ws" ] && [ "$exec_ws" != "None" ]; then
    herdr workspace close "$exec_ws" >/dev/null 2>&1 \
      && info "closed executor workspace $exec_ws" || true
  fi

  rm -rf "${TASKS_DIR:?}/$id"
  find "$WORKTREE_VIEW" -mindepth 1 -type d -empty -delete 2>/dev/null || true
  prune_repo_symlinks

  ledger_append "{\"event\":\"closed\",\"id\":\"$id\",\"status\":\"closed\",\"ts\":\"$(now)\"}"
  info "task $id closed"
}

cmd_remove() {
  local id="" delete_branch=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --delete-branch) delete_branch=1; shift ;;
      -h|--help) usage_remove; return 0 ;;
      -*) die "remove: unknown arg '$1'" ;;
      *) id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || { usage_remove; die "remove: task id required"; }

  local rec; rec="$(_find_created_rec "$id")"
  [ -n "$rec" ] || die "no ledger record for task '$id'"
  _teardown_from_rec "$rec" "$delete_branch" "$id"
}

# ---------------------------------------------------------------------------
# handoff — baton-pass an existing task to a FRESH-context executor
# ---------------------------------------------------------------------------
usage_handoff() {
  cat >&2 <<EOF
Usage: task-worktree handoff <task-id> [--prompt "<opening instruction>"]
                            [--note-from <path>] [--agent <kind>]

  Replaces the idle executor on an existing task with a brand-new, empty-context
  agent, keeping the SAME worktree(s), branch, uncommitted changes and PR — the
  baton pass. The old executor workspace (its context) is closed; the worktrees
  are untouched. The existing re-arming watcher keeps tracking the task id, so
  no duplicate watcher is armed.

  --prompt     Opening instruction for the fresh agent (defaults to a generic
               "continue this task" brief).
  --note-from  File whose contents are handed to the fresh agent as a handoff
               note (e.g. the prior agent's HANDOFF.md). Optional but strongly
               recommended — the old agent's knowledge lives in the tree/notes,
               not in the discarded context.
  --agent      Executor kind for the fresh agent (default: the task's original).
EOF
}

cmd_handoff() {
  local id="" prompt="" note_file="" agent=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --prompt)    prompt="$2"; shift 2 ;;
      --note-from) note_file="$2"; shift 2 ;;
      --agent)     agent="$2"; shift 2 ;;
      -h|--help)   usage_handoff; return 0 ;;
      -*) die "handoff: unknown arg '$1'" ;;
      *) [ -n "$id" ] && die "handoff: unexpected arg '$1'"; id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || { usage_handoff; die "handoff: task id required"; }

  local rec; rec="$(_find_created_rec "$id")"
  [ -n "$rec" ] || die "handoff: no ledger record for task '$id'"

  local mode branch primary old_ws agent_kind
  mode="$(jget "$rec" "d.get('mode') or 'code'")"
  branch="$(jget "$rec" "d.get('branch') or ''")"
  primary="$(jget "$rec" "d.get('primary_repo') or ''")"
  old_ws="$(jget "$rec" "d.get('executor_workspace_id') or ''")"
  agent_kind="$(jget "$rec" "d.get('agent_kind') or '$DEFAULT_AGENT_KIND'")"
  [ -n "$agent" ] && agent_kind="$agent"

  local task_dir="$TASKS_DIR/$id"
  [ -d "$task_dir" ] || die "handoff: task dir missing ($task_dir) — is the task closed?"

  local note=""
  if [ -n "$note_file" ]; then
    [ -f "$note_file" ] || die "handoff: --note-from not found: $note_file"
    note="$(cat "$note_file")"
  fi
  [ -n "$prompt" ] || prompt="You are taking over this in-progress task with a fresh context. Read ./AGENTS.md and inspect the working tree (including any HANDOFF note / recent commits) to see what the previous executor did, then carry the work to completion."

  info "handoff: task $id  branch $branch  agent $agent_kind"

  # 1. Close the prior executor workspace (discards the old context). The
  #    worktree workspaces are separate, so uncommitted work is preserved.
  if [ -n "$old_ws" ] && [ "$old_ws" != "None" ]; then
    herdr workspace close "$old_ws" >/dev/null 2>&1 \
      && info "closed prior executor workspace $old_ws" \
      || info "warning: could not close prior executor workspace $old_ws (continuing)"
  fi

  # 2. Fresh executor workspace + agent, rooted at the SAME task dir (which
  #    already symlinks to the existing worktree(s)).
  local out new_ws new_pane
  out="$(herdr workspace create --cwd "$task_dir" --label "$id" --no-focus 2>&1)" \
    || { printf '%s\n' "$out" >&2; die "handoff: herdr workspace create failed"; }
  new_ws="$(jget "$out" "d['result']['workspace']['workspace_id']")"
  new_pane="$(jget "$out" "d['result']['root_pane']['pane_id']")"
  info "new executor workspace: $new_ws  pane: $new_pane"

  herdr agent start "$id" --kind "$agent_kind" --pane "$new_pane" >/dev/null 2>&1 \
    || die "handoff: herdr agent start failed (kind=$agent_kind pane=$new_pane)"
  info "started fresh $agent_kind agent '$id'"

  # 3. Brief the fresh agent: prompt + optional handoff note + standard footer.
  local full="$prompt"
  [ -n "$note" ] && full="$full

--- handoff note ---
$note
--- end handoff note ---"
  local ho_compare=""
  [ "$mode" = "code" ] && [ -n "$primary" ] && [ -n "$branch" ] \
    && ho_compare="$(_compare_url "$primary" "$branch" 2>/dev/null || true)"
  full="$full

Read ./AGENTS.md first — it defines how you must operate as a task executor. Primary repo: $primary (branch $branch).
$(_done_brief "$id" "$ho_compare" "$mode")"
  herdr agent prompt "$id" "$full" >/dev/null 2>&1 \
    || info "warning: agent prompt submission failed; brief the agent manually"

  # A fresh executor means fresh work: release the settle claim so its eventual
  # settle reports again (and refresh task.env, whose pane/branch may be stale).
  _settle_release "$id" "handed off to a fresh executor"
  if [ -f "$task_dir/task.env" ]; then
    local ho_pane; ho_pane="$(_resolve_dispatch_pane "$id")"
    python3 - "$task_dir/task.env" "$ho_pane" <<'PY' || true
import re, sys
p, pane = sys.argv[1], sys.argv[2]
if pane:
    s = open(p).read()
    s = re.sub(r'^TASK_DISPATCH_PANE=.*$', 'TASK_DISPATCH_PANE="%s"' % pane, s, flags=re.M)
    open(p, "w").write(s)
PY
  fi

  # 4. Ledger 'handoff' event — copies the task's worktrees/branch/mode from the
  #    prior record but records the NEW executor_workspace_id so teardown/report
  #    act on the live workspace. status stays 'working'.
  local entry
  entry="$(python3 - "$rec" "$id" "$new_ws" "$prompt" "$note" "$(now)" <<'PY'
import json, sys
(rec, id_, new_ws, prompt, note, ts) = sys.argv[1:7]
o = json.loads(rec)
print(json.dumps({
    "event": "handoff",
    "id": id_,
    "slug": o.get("slug"),
    "branch": o.get("branch"),
    "primary_repo": o.get("primary_repo"),
    "agent_kind": o.get("agent_kind"),
    "mode": o.get("mode") or "code",
    "skills": o.get("skills"),
    "request": o.get("request"),
    "prompt": prompt,
    "handoff_note": note or None,
    "executor_workspace_id": new_ws or None,
    "worktrees": o.get("worktrees", []),
    "status": "working",
    "ts": ts,
}))
PY
)"
  ledger_append "$entry"

  # 5. Watcher: the original re-arming watcher keys on the task id and is parked
  #    in its "wait for work to resume" phase, so it picks up the fresh agent —
  #    no second watcher is armed (avoids duplicate settle records / wakes).
  info "reused existing re-arming watcher for $id (no duplicate armed)"

  printf '\n✔ handoff complete for %s\n  task dir: %s\n' "$id" "$task_dir" >&2
  echo "$id"
}

# ---------------------------------------------------------------------------
# wrapup — ask a LIVE brainstorm session to produce its plan now
#
# This is the SECOND of the two ways a brainstorm session ends (the first is the
# human simply telling the session "write it up" in its own pane). It is
# deliberately NOT a second reporting mechanism: all it does is prompt the live
# session, which then delivers the plan through the ordinary executor `done`
# path — same settle claim, same exactly-once wake, same durable report.
#
# It also flips the task's ledger status to 'wrapping-up', which LIFTS the
# conversational-idle suppression (see notify-settle): from here on, an idle
# session is news again, so the backstop still catches a session that writes its
# plan and then forgets to call `done`.
# ---------------------------------------------------------------------------
usage_wrapup() {
  cat >&2 <<EOF
Usage: task-worktree wrapup <task-id> [--note "<extra steer>"]

  Asks a LIVE --mode brainstorm session to stop asking questions and write up
  its plan NOW. The session delivers it through the normal 'done' path, so
  Dispatch is woken exactly once, the plan is persisted under reports/, and the
  task then auto-closes on 'report'.

  ONLY run this when the HUMAN explicitly says to wrap the session up. Dispatch
  must never decide on its own that a conversation is finished — it is the
  human's dialogue, and an interrupted one loses the un-asked questions.

  --note  Extra steer folded into the request (e.g. "focus on the migration").
EOF
}

cmd_wrapup() {
  local id="" note=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --note)    note="$2"; shift 2 ;;
      -h|--help) usage_wrapup; return 0 ;;
      -*) die "wrapup: unknown arg '$1'" ;;
      *) [ -n "$id" ] && die "wrapup: unexpected arg '$1'"; id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || { usage_wrapup; die "wrapup: task id required"; }

  local rec; rec="$(_find_created_rec "$id")"
  [ -n "$rec" ] || die "wrapup: no ledger record for task '$id'"
  local mode; mode="$(jget "$rec" "d.get('mode') or 'code'")"
  [ "$mode" = "brainstorm" ] \
    || die "wrapup: task '$id' is --mode $mode; wrapup only applies to --mode brainstorm sessions.
A $mode task ends when its executor calls 'done' — steer it with a prompt, or close it with 'remove'."

  local live; live="$(_agent_status "$id")"
  [ -n "$live" ] \
    || die "wrapup: no live agent for '$id' — the session is gone. Its plan was never delivered; check 'list'/'reconcile', then close it with 'remove'."

  local skills; skills="$(jget "$rec" "d.get('skills') or ''")"
  info "wrapup: asking brainstorm session $id (skills: ${skills:-?}, agent: $live) for its plan"

  # 1. Record the request FIRST. This is what lifts the conversational-idle
  #    suppression, so it must be durable before the session can go idle again.
  ledger_append "$(python3 - "$id" "$note" "$(now)" <<'PY'
import json, sys
id_, note, ts = sys.argv[1:4]
print(json.dumps({"event": "wrapup-requested", "id": id_,
                  "status": "wrapping-up", "note": note or None, "ts": ts}))
PY
)"

  # 2. Prompt the live session. Same wording as the template's wrap-up section,
  #    so both endings land the session in exactly the same place.
  local ask="WRAP-UP REQUEST from the human (via Dispatch). Stop asking questions now and write up the plan.

Produce a single markdown file in your task dir (e.g. ./PLAN.md) with these sections, in this order: 'Decided' (what we settled and why), 'Rejected' (what we considered and did NOT do, each with the reason), 'Open questions' (what is still undecided and what would settle it), and 'Next tasks' (concrete tasks Dispatch could spawn: slug, repo, mode, two-line brief — each sized for one executor).

Then, as your FINAL action, deliver it:
  $SELF done $id --note \"<one-line summary of the plan>\" --body-file <path-to-that-file>

This task auto-closes once the plan is persisted, so anything not in that file is lost — do not leave conclusions in the worktree or in chat."
  [ -n "$note" ] && ask="$ask

Extra steer from the human: $note"

  herdr agent prompt "$id" "$ask" >/dev/null 2>&1 \
    || die "wrapup: could not prompt the session '$id' — it may have died; check 'list'/'reconcile'"

  info "wrapup requested for $id — it will report through the normal 'done' path (one wake), then auto-close on 'report'"
}

# ---------------------------------------------------------------------------
# report
# ---------------------------------------------------------------------------
usage_report() {
  cat >&2 <<EOF
Usage: task-worktree report <task-id> [--status <status>] [--note <text>]
                            [--commit <sha>] [--body <text> | --body-file <path>]

  Persists the executor's report DURABLY — first to reports/<id>.md, then as a
  'reported' ledger event — BEFORE any teardown, so it can never be lost.

  If the task was created with --mode investigate or --mode brainstorm, it then
  auto-closes itself (teardown + branch delete, nothing to review — the report
  IS the deliverable). A --mode code task is left open at its report status for
  human review and explicit 'remove' later.

  --status   Report status (default: awaiting-review).
  --note     One-line summary recorded in the ledger.
  --commit   Commit SHA to record (code tasks).
  --body     Full report text (markdown) for reports/<id>.md.
  --body-file  Read the full report text from a file instead of --body.
EOF
}

cmd_report() {
  local id="" status="" note="" commit="" body="" body_file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --status)    status="$2"; shift 2 ;;
      --note)      note="$2"; shift 2 ;;
      --commit)    commit="$2"; shift 2 ;;
      --body)      body="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      -h|--help)   usage_report; return 0 ;;
      -*) die "report: unknown arg '$1'" ;;
      *) [ -n "$id" ] && die "report: unexpected arg '$1'"; id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || { usage_report; die "report: task id required"; }

  local rec; rec="$(_find_created_rec "$id")"
  [ -n "$rec" ] || die "report: no ledger record for task '$id'"
  local mode; mode="$(jget "$rec" "d.get('mode') or 'code'")"
  local rep_branch; rep_branch="$(jget "$rec" "d.get('branch') or ''")"
  local rep_primary; rep_primary="$(jget "$rec" "d.get('primary_repo') or ''")"
  [ -n "$status" ] || status="awaiting-review"

  # Compare link (code tasks): main...branch on the primary repo.
  local compare=""
  if [ "$mode" = "code" ] && [ -n "$rep_branch" ] && [ -n "$rep_primary" ]; then
    compare="$(_compare_url "$rep_primary" "$rep_branch")"
  fi

  if [ -n "$body_file" ]; then
    [ -f "$body_file" ] || die "report: --body-file not found: $body_file"
    body="$(cat "$body_file")"
  fi

  # 1. DURABLE report file first — human-readable, survives any teardown.
  mkdir -p "$REPORTS_DIR"
  local report_file="$REPORTS_DIR/$id.md"
  {
    printf '%s\n\n' "# Task report: $id"
    printf '%s\n' "- **status:** $status"
    printf '%s\n' "- **mode:** $mode"
    [ -n "$commit" ] && printf '%s\n' "- **commit:** $commit"
    [ -n "$compare" ] && printf '%s\n' "- **compare:** $compare"
    printf '%s\n\n' "- **ts:** $(now)"
    [ -n "$note" ] && printf '%s\n\n' "**note:** $note"
    printf '%s\n\n' '---'
    printf '%s\n' "$body"
  } > "$report_file"
  info "report persisted: ${report_file#$ROOT/}"

  # 2. Ledger 'reported' event pointing at the durable file.
  local entry
  entry="$(python3 - "$id" "$status" "$note" "$commit" "$mode" "reports/$id.md" "$(now)" <<'PY'
import json, sys
(id_, status, note, commit, mode, rf, ts) = sys.argv[1:8]
print(json.dumps({
    "event": "reported", "id": id_, "status": status,
    "note": note or None, "commit": commit or None, "mode": mode,
    "report_file": rf, "ts": ts,
}))
PY
)"
  ledger_append "$entry"

  # 3. Investigate and brainstorm tasks auto-close: their whole deliverable is
  #    the report, which is already safely persisted above.
  if [ "$mode" = "investigate" ] || [ "$mode" = "brainstorm" ]; then
    info "mode=$mode → auto-closing $id (the plan/report is durable at reports/$id.md)"
    _teardown_from_rec "$rec" 1 "$id"
  else
    info "mode=code → task $id left open at '$status' for review"
    [ -n "$compare" ] && info "compare: $compare"
  fi
}

# ---------------------------------------------------------------------------
# reconcile — repair ledger status from LIVE herdr state
# ---------------------------------------------------------------------------
usage_reconcile() {
  cat >&2 <<EOF
Usage: task-worktree reconcile [<task-id> ...] [--dry-run] [--no-wake]

  The ledger is the record of intent; herdr is authoritative for liveness. If a
  settle was ever missed (a dead watcher, a crashed executor), a task can sit at
  'working' in the ledger while its agent is actually idle. reconcile compares
  the two and repairs the ledger.

  An idle/blocked agent whose task still reads 'working' (or 'paused-by-human')
  is put through the normal notify-settle path, so it is recorded and Dispatch
  is woken — still exactly once, because it takes the same settle claim. Like
  the watcher, reconcile CLASSIFIES first: a task the human stopped and has not
  resumed stays suppressed (and is re-stamped 'paused-by-human' only once), so
  reconcile never turns a human pause into a false completion.

  --dry-run  Report what would change; touch nothing.
  --no-wake  Record the repair in the ledger but do not wake Dispatch.
EOF
}

cmd_reconcile() {
  local dry=0 wake=1
  local -a want=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --no-wake) wake=0; shift ;;
      -h|--help) usage_reconcile; return 0 ;;
      -*) die "reconcile: unknown arg '$1'" ;;
      *) want+=("$1"); shift ;;
    esac
  done

  # Open tasks (anything not closed) and their last known ledger status.
  local open_tasks
  open_tasks="$(python3 - "$LEDGER" <<'PY'
import json, sys
state, order = {}, []
for line in open(sys.argv[1]):
    line = line.strip()
    if not line: continue
    try: o = json.loads(line)
    except Exception: continue
    tid = o.get("id")
    if not tid: continue
    if tid not in state: order.append(tid)
    state.setdefault(tid, {}).update(o)
for tid in order:
    if state[tid].get("status") != "closed":
        print("%s\t%s" % (tid, state[tid].get("status", "?")))
PY
)"

  local changed=0 tid ledger_status live
  while IFS=$'\t' read -r tid ledger_status; do
    [ -n "$tid" ] || continue
    if [ "${#want[@]}" -gt 0 ]; then
      local hit=0 w
      for w in "${want[@]}"; do [ "$w" = "$tid" ] && hit=1; done
      [ "$hit" -eq 1 ] || continue
    fi

    live="$(_agent_status "$tid")"
    case "${live:-gone}" in
      working)
        printf '  %-34s ledger=%-16s live=working        ok\n' "$tid" "$ledger_status" ;;
      idle|done|blocked)
        if [ "$ledger_status" = "working" ] || [ "$ledger_status" = "paused-by-human" ]; then
          local new="awaiting-dispatch"
          [ "$live" = "blocked" ] && new="blocked"
          printf '  %-34s ledger=%-16s live=%-12s REPAIR -> %s\n' \
            "$tid" "$ledger_status" "$live" "$new"
          if [ "$dry" -eq 0 ]; then
            changed=1
            if [ "$wake" -eq 1 ]; then
              cmd_notify_settle "$tid" --by reconcile --status "$new" --classify \
                --note "reconciled: agent was '$live' while the ledger still said '$ledger_status' (a settle was missed)"
            else
              ledger_append "{\"event\":\"settled\",\"id\":\"$tid\",\"status\":\"$new\",\"by\":\"reconcile\",\"note\":\"reconciled (no wake)\",\"ts\":\"$(now)\"}"
            fi
          fi
        else
          printf '  %-34s ledger=%-16s live=%-12s ok\n' "$tid" "$ledger_status" "$live"
        fi ;;
      gone|unknown|"")
        printf '  %-34s ledger=%-16s live=%-12s NO AGENT\n' "$tid" "$ledger_status" "${live:-gone}"
        if [ "$dry" -eq 0 ] && [ "$ledger_status" = "working" ]; then
          changed=1
          ledger_append "{\"event\":\"reconciled\",\"id\":\"$tid\",\"status\":\"orphaned\",\"note\":\"no live herdr agent; the executor is gone\",\"ts\":\"$(now)\"}"
        fi ;;
    esac
  done <<< "$open_tasks"

  if [ "$dry" -eq 1 ]; then
    info "reconcile: dry run — nothing written"
  elif [ "$changed" -eq 1 ]; then
    info "reconcile: ledger repaired"
  else
    info "reconcile: ledger already matches herdr"
  fi
}

# ---------------------------------------------------------------------------
# prune
# ---------------------------------------------------------------------------
# Remove dangling worktree-view symlinks (target gone) and unused repo symlinks.
prune_repo_symlinks() {
  local link repo
  for link in "$ROOT"/*; do
    [ -L "$link" ] || continue
    repo="$(basename "$link")"
    # skip the worktree view dir itself (not a symlink) — only symlinks reach here
    local target; target="$(readlink "$link")"
    case "$target" in
      "$REPOS"/*) ;;      # a repo view symlink — candidate
      *) continue ;;
    esac
    # is it still referenced by any worktree view entry?
    if [ -d "$WORKTREE_VIEW/$repo" ] && [ -n "$(ls -A "$WORKTREE_VIEW/$repo" 2>/dev/null)" ]; then
      continue
    fi
    rm -f "$link"
    info "pruned unused repo view: $repo"
  done
}

cmd_prune() {
  # 1. dangling worktree-view symlinks
  if [ -d "$WORKTREE_VIEW" ]; then
    while IFS= read -r link; do
      [ -e "$link" ] && continue   # target still resolves -> keep
      rm -f "$link"
      info "pruned dangling worktree symlink: ${link#$ROOT/}"
    done < <(find "$WORKTREE_VIEW" -type l 2>/dev/null)
    # tidy empty dirs
    find "$WORKTREE_VIEW" -mindepth 1 -type d -empty -delete 2>/dev/null || true
  fi
  # 2. unused repo symlinks
  prune_repo_symlinks
  info "prune complete"
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------
cmd_list() {
  python3 - "$LEDGER" <<'PY'
import json, sys
path = sys.argv[1]
state = {}
order = []
for line in open(path):
    line = line.strip()
    if not line: continue
    try: o = json.loads(line)
    except Exception: continue
    tid = o.get("id")
    if not tid: continue
    if tid not in state: order.append(tid)
    state.setdefault(tid, {}).update(o)
if not order:
    print("(no tasks in ledger)"); sys.exit(0)
w = max(len(t) for t in order)
for tid in order:
    o = state[tid]
    repos = ",".join(w_["repo"] for w_ in o.get("worktrees", [])) or "-"
    status = o.get("status", "?")
    tail = o.get("request", "") or ""
    # A settle the watcher suppressed because the HUMAN stopped the executor:
    # never silently swallowed — it surfaces here (and in `reconcile`).
    if status == "paused-by-human":
        tail = "(stopped by you — steer it or let it resume) " + tail
    elif o.get("cause") == "agent-error" and o.get("event") == "settled":
        tail = "(settled on an AGENT/PROVIDER ERROR) " + tail
    # A brainstorm session is a DIALOGUE: idle means "waiting for you to type",
    # never "stalled". Say so, and say what it is, so its nature survives the
    # conversation.
    if o.get("mode") == "brainstorm":
        skills = o.get("skills") or "?"
        if status == "in-conversation":
            tail = f"(IN CONVERSATION · skills: {skills} · talk to it: herdr agent focus {tid}) " + tail
        elif status == "wrapping-up":
            tail = f"(wrapping up · skills: {skills} · writing its plan) " + tail
        elif status == "working":
            tail = f"(brainstorm session · skills: {skills}) " + tail
    print(f"{tid:<{w}}  {status:<16}  {repos:<20}  {tail[:70]}")
PY
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
usage() {
  cat >&2 <<EOF
task-worktree — blessed path for agentic tasks in this Dispatch root

Usage: task-worktree <create|handoff|wrapup|done|report|classify|reconcile|remove|prune|list|help> [args]

  create    Spin a task: worktree(s) + ephemeral task dir + executor agent.
            --mode code | investigate | brainstorm (brainstorm needs --skill).
  handoff   Baton-pass a task to a FRESH-context executor (same worktree/branch).
  wrapup    Ask a live --mode brainstorm session for its plan NOW (human's word only).
  done      (EXECUTORS) "I am finished" — record + notify + wake Dispatch.
  watch     Detached settle backstop for one task (armed automatically).
  report    Persist a report durably; auto-close if --mode investigate/brainstorm.
  classify  Why did an executor settle? (human /stop vs finished vs crashed)
  reconcile Repair ledger status from live herdr agent state.

  remove    Close a task and clean up (keeps the branch by default).
  prune     Reconcile: drop dangling worktree symlinks + unused repo links.
  list      Show task status from the ledger.

Run 'task-worktree <cmd> --help' for details.
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    create) cmd_create "$@" ;;
    handoff) cmd_handoff "$@" ;;
    wrapup) cmd_wrapup "$@" ;;
    done)   cmd_done "$@" ;;
    watch)  cmd_watch "$@" ;;
    notify-settle) cmd_notify_settle "$@" ;;
    # plumbing, used by the watcher and the selftest
    _release) _settle_release "$@" ;;
    _forget)  _settle_forget "$@" ;;
    _status)  _agent_status "$@" ;;
    report) cmd_report "$@" ;;
    classify) cmd_classify "$@" ;;
    reconcile) cmd_reconcile "$@" ;;
    remove) cmd_remove "$@" ;;
    prune)  cmd_prune "$@" ;;
    list)   cmd_list "$@" ;;
    help|-h|--help) usage ;;
    *) usage; die "unknown command '$cmd'" ;;
  esac
}

main "$@"
