#!/usr/bin/env bash
#
# task-worktree — the one blessed path for spinning, tearing down, and
# reconciling agentic tasks in this Dispatch root.
#
# This is a scratch bash script. It is expected to graduate into a reusable
# skill (its own repo) later; keep the surface small and the herdr calls
# well-isolated so that extraction is easy.
#
# Subcommands:
#   create    Create worktree(s) + ephemeral task dir + spawn an executor agent.
#   handoff   Swap in a fresh-context executor on an existing worktree/branch.
#   done      Executor self-notification: "I am finished" (PRIMARY completion path).
#   watch     Detached settle watcher for one task (BACKSTOP; armed by create).
#   report    Persist an executor's report durably.
#   reconcile Repair ledger status from live herdr agent state.
#   remove    Tear down a task: herdr worktrees, symlinks, task dir, ledger.
#   prune     Garbage-collect dangling worktree symlinks + unused repo symlinks.
#   list      Show current task status derived from the ledger.
#   help      Show usage.
#
# Completion is EXACTLY-ONCE per settle. Two independent paths converge on the
# same code (`notify-settle`), which takes a per-task settle CLAIM before it
# records/notifies/wakes:
#   1. PRIMARY  — the executor calls `done` as its final action.
#   2. BACKSTOP — the detached `watch` process sees the agent settle.
# Whoever gets there first claims the settle; the other is suppressed. The claim
# is released when the executor genuinely resumes work (re-arming), so a task
# that settles -> is steered -> settles again reports every time.
#
set -euo pipefail

# ---------------------------------------------------------------------------
# Layout / config
# ---------------------------------------------------------------------------
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"     # the Dispatch root
SELF="$ROOT/bin/$(basename "${BASH_SOURCE[0]}")"            # re-invocable path
REPOS="${TASK_REPOS_DIR:-$HOME/Repositories}"               # source repos
WORKTREE_STORE="${TASK_WORKTREE_STORE:-$HOME/agentic-workspaces/.worktrees}"
WORKTREE_VIEW="$ROOT/worktree"                             # symlink view
TASKS_DIR="$ROOT/tasks"                                     # ephemeral task dirs
REPORTS_DIR="$ROOT/reports"                                 # durable task reports
DISPATCH_DIR="$ROOT/.dispatch"
LEDGER="$DISPATCH_DIR/ledger.jsonl"
EXECUTOR_CONTEXT="$DISPATCH_DIR/task-executor.AGENTS.md"
SETTLE_DIR="$DISPATCH_DIR/settle"                           # per-task settle claims
LOG_DIR="$DISPATCH_DIR/logs"                                # watcher logs
DEFAULT_AGENT_KIND="${TASK_AGENT_KIND:-pi}"

SETTLE_EPOCH=""     # set by _settle_claim
WATCH_LOG=""        # set by cmd_watch

die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
info() { printf '· %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

have herdr   || die "herdr not found on PATH"
have python3 || die "python3 not found on PATH"
have git     || die "git not found on PATH"

mkdir -p "$DISPATCH_DIR" "$WORKTREE_VIEW" "$TASKS_DIR" "$WORKTREE_STORE" "$REPORTS_DIR" \
         "$SETTLE_DIR" "$LOG_DIR"
[ -f "$LEDGER" ] || : > "$LEDGER"

# ---------------------------------------------------------------------------
# JSON helpers (herdr speaks JSON on stdout)
# ---------------------------------------------------------------------------

# jget <json> <python-expr-over-d>  -> prints result or exits non-zero
jget() {
  python3 - "$1" "$2" <<'PY'
import json, sys
d = json.loads(sys.argv[1])
if isinstance(d, dict) and "error" in d:
    sys.stderr.write("herdr error: %s\n" % d["error"].get("message", d["error"]))
    sys.exit(3)
try:
    print(eval(sys.argv[2], {"d": d}))
except Exception as e:
    sys.stderr.write("json path failed: %s\n" % e)
    sys.exit(4)
PY
}

nonce() { printf '%03x' "$((RANDOM % 4096))"; }

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# ledger_append <json-object-string>
ledger_append() { printf '%s\n' "$1" >> "$LEDGER"; }

# _default_branch <repo> -> prints the repo's default branch (main/master)
_default_branch() {
  local repo="$1" ref c
  ref="$(git -C "$REPOS/$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$ref" ]; then printf '%s\n' "${ref#origin/}"; return; fi
  for c in main master; do
    if git -C "$REPOS/$repo" show-ref --verify --quiet "refs/remotes/origin/$c"; then
      printf '%s\n' "$c"; return
    fi
  done
  printf 'main\n'
}

# _compare_url <repo> <branch> -> prints the GitHub compare link (main...branch)
# Converts the origin remote (git@ or https) to https and builds the compare URL
# against the repo's default branch. Prints nothing if origin isn't GitHub.
_compare_url() {
  local repo="$1" branch="$2" url base slug
  url="$(git -C "$REPOS/$repo" remote get-url origin 2>/dev/null || true)"
  [ -n "$url" ] || return 0
  case "$url" in
    git@github.com:*) slug="${url#git@github.com:}" ;;
    https://github.com/*) slug="${url#https://github.com/}" ;;
    ssh://git@github.com/*) slug="${url#ssh://git@github.com/}" ;;
    *) return 0 ;;
  esac
  slug="${slug%.git}"
  base="$(_default_branch "$repo")"
  printf 'https://github.com/%s/compare/%s...%s\n' "$slug" "$base" "$branch"
}

# ---------------------------------------------------------------------------
# herdr agent probes
#
# IMPORTANT (regression guard): `herdr agent wait --until <S>` takes ONE status
# and must be REPEATED for several (`--until idle --until done`). A
# space-separated list makes herdr exit rc=2 with "unknown option: <s>", which
# silently turns every probe into "false" — exactly the bug that made the old
# watcher spin forever without ever recording a settle. A BARE `herdr agent wait
# <id>` already defaults to idle/done/blocked, so prefer it for settle waits.
#
# Exit codes we rely on (verified against live agents):
#   0     the requested state was reached
#   1     timeout / no match / agent_not_found  (a normal, expected outcome)
#   >=2   bad invocation or herdr failure       (NEVER retry-loop on this)
# ---------------------------------------------------------------------------

HWAIT_ERR=""

# _hwait <target> [herdr-wait-args...]
#   rc 0  matched
#   rc 1  no match / timed out (agent is alive, just not in that state)
#   rc 2  FATAL: bad invocation, herdr failure, or the agent is gone.
#         Callers MUST treat rc 2 as "stop", never as "try again".
_hwait() {
  local out rc=0
  HWAIT_ERR=""
  out="$(herdr agent wait "$@" 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] && return 0
  if [ "$rc" -ge 2 ]; then
    HWAIT_ERR="herdr agent wait rc=$rc: $out"
    return 2
  fi
  case "$out" in
    *agent_not_found*) HWAIT_ERR="agent not found: $out"; return 2 ;;
  esac
  return 1
}

# _agent_field <target> <field>  -> prints the field of the live agent record.
# rc 1 if the agent does not exist. Fields: agent_status, state_change_seq, ...
_agent_field() {
  local out rc=0
  out="$(herdr agent get "$1" 2>&1)" || rc=$?
  [ "$rc" -eq 0 ] || return 1
  python3 - "$out" "$2" <<'PY'
import json, sys
try:
    a = json.loads(sys.argv[1])["result"]["agent"]
except Exception:
    sys.exit(1)
print(a.get(sys.argv[2], ""))
PY
}

# _agent_status <target> -> idle|working|blocked|done|unknown, or "" if gone
_agent_status() { _agent_field "$1" agent_status 2>/dev/null || true; }
# _agent_seq <target> -> herdr's monotonic state_change_seq ("" if gone)
_agent_seq()    { _agent_field "$1" state_change_seq 2>/dev/null || true; }

# _discover_dispatch_pane -> pane id of the Dispatch agent (cwd == the root)
_discover_dispatch_pane() {
  local out
  out="$(herdr agent list 2>/dev/null)" || return 0
  python3 - "$out" "$ROOT" <<'PY'
import json, sys
try:
    agents = json.loads(sys.argv[1])["result"]["agents"]
except Exception:
    sys.exit(0)
root = sys.argv[2]
for a in agents:
    # the Dispatch agent is the one rooted AT the dispatch root (executors live
    # in tasks/<id>/ subdirs and carry a task name)
    if a.get("cwd") == root and not a.get("name"):
        print(a.get("pane_id", "")); break
PY
}

# _task_field <id> <key> -> a field from the task's latest created/handoff record
_task_field() {
  local rec; rec="$(_find_created_rec "$1")"
  [ -n "$rec" ] || return 0
  jget "$rec" "d.get('$2') or ''" 2>/dev/null || true
}

# _resolve_dispatch_pane <id> -> the pane to wake.
# Deliberately does NOT consult $HERDR_PANE_ID: when an EXECUTOR runs `done`,
# that variable points at the executor's own pane, which would wake the wrong
# agent. Resolution order: explicit arg > task.env > ledger > live discovery.
_resolve_dispatch_pane() {
  local id="$1" explicit="${2:-}" p=""
  [ -n "$explicit" ] && { printf '%s\n' "$explicit"; return 0; }
  [ -n "${TASK_DISPATCH_PANE:-}" ] && { printf '%s\n' "$TASK_DISPATCH_PANE"; return 0; }
  if [ -n "$id" ] && [ -f "$TASKS_DIR/$id/task.env" ]; then
    p="$(. "$TASKS_DIR/$id/task.env" >/dev/null 2>&1; printf '%s' "${TASK_DISPATCH_PANE:-}")"
    [ -n "$p" ] && { printf '%s\n' "$p"; return 0; }
  fi
  [ -n "$id" ] && p="$(_task_field "$id" dispatch_pane)"
  [ -n "$p" ] && { printf '%s\n' "$p"; return 0; }
  _discover_dispatch_pane
}

# ---------------------------------------------------------------------------
# Settle claims — the exactly-once gate
#
# One claim file per task ($SETTLE_DIR/<id>.claim). Holding it means "this
# settle has already been recorded and Dispatch has already been woken". It is
# released when the executor genuinely resumes work, which is what makes the
# re-arming behaviour (settle -> steer -> settle again) keep reporting.
# ---------------------------------------------------------------------------

# _settle_claim <id> <by> <force 0|1>
#   rc 0  we own this settle -> caller must record + notify + wake
#   rc 1  suppressed — this settle was already reported by someone else
_settle_claim() {
  local id="$1" by="$2" force="${3:-0}" seq verdict
  seq="$(_agent_seq "$id")"
  mkdir -p "$SETTLE_DIR"
  verdict="$(python3 - "$SETTLE_DIR/$id.claim" "$SETTLE_DIR/$id.lock" "$by" "$seq" "$force" "$(now)" <<'PY'
import json, os, shutil, sys, time

claim_path, lock_path, by, seq, force, ts = sys.argv[1:7]
force = force == "1"
seq = int(seq) if seq.strip().isdigit() else None

# --- tiny cross-process lock (mkdir is atomic on every POSIX fs) -------------
for attempt in range(200):                       # ~10s worth of tries
    try:
        os.mkdir(lock_path); break
    except FileExistsError:
        try:                                     # break a lock left by a crash
            if time.time() - os.path.getmtime(lock_path) > 30:
                shutil.rmtree(lock_path, ignore_errors=True); continue
        except OSError:
            pass
        time.sleep(0.05)
else:
    shutil.rmtree(lock_path, ignore_errors=True)
    os.mkdir(lock_path)

try:
    claim = None
    try:
        with open(claim_path) as fh:
            claim = json.load(fh)
    except Exception:
        claim = None

    def fire(epoch):
        with open(claim_path, "w") as fh:
            json.dump({"epoch": epoch, "by": by, "seq": seq,
                       "released": False, "ts": ts}, fh)
        print("fire %d" % epoch)

    if force or claim is None:
        fire(int((claim or {}).get("epoch", 0)) + 1)
    elif claim.get("released"):
        # the executor resumed work since the last settle -> a genuinely NEW
        # settle. This is what preserves re-arming.
        fire(int(claim.get("epoch", 0)) + 1)
    elif by == "watcher":
        # BACKSTOP suppressed: the executor already self-reported this settle.
        # Record the seq we actually observed the agent settle at, so a later
        # executor-side call can tell "same settle" from "a new one".
        claim["seq"] = seq if seq is not None else claim.get("seq")
        claim["watcher_seen"] = True
        with open(claim_path, "w") as fh:
            json.dump(claim, fh)
        print("skip %d" % int(claim.get("epoch", 0)))
    else:
        # Executor/reconcile side. If the monotonic state_change_seq from herdr has
        # advanced past the claim, the agent changed state since it was taken
        # (it was steered and worked again) -> a new settle. This keeps
        # re-arming working even if the watcher died and never released.
        prev = claim.get("seq")
        if seq is not None and isinstance(prev, int) and seq > prev:
            fire(int(claim.get("epoch", 0)) + 1)
        else:
            print("skip %d" % int(claim.get("epoch", 0)))
finally:
    shutil.rmtree(lock_path, ignore_errors=True)
PY
)"
  SETTLE_EPOCH="${verdict#* }"
  case "$verdict" in
    fire*) return 0 ;;
    *)     return 1 ;;
  esac
}

# _settle_release <id> [reason] — mark the current claim released because the
# executor resumed work, so the NEXT settle reports again (re-arming).
_settle_release() {
  # NOTE: separate statements on purpose — bash expands every word of a `local`
  # command before assigning any of them, so `local a=$1 b=$a` would blow up.
  local id="$1" reason="${2:-resumed}"
  local claim="$SETTLE_DIR/$id.claim"
  [ -f "$claim" ] || return 0
  python3 - "$claim" <<'PY' || return 0
import json, sys
p = sys.argv[1]
try:
    with open(p) as fh: c = json.load(fh)
except Exception:
    sys.exit(0)
if c.get("released"):
    sys.exit(1)          # already released -> no duplicate 'resumed' event
c["released"] = True
with open(p, "w") as fh: json.dump(c, fh)
PY
  ledger_append "{\"event\":\"resumed\",\"id\":\"$id\",\"status\":\"working\",\"reason\":\"$reason\",\"ts\":\"$(now)\"}"
}

# _settle_forget <id> — drop all claim state (teardown).
_settle_forget() {
  rm -f  "$SETTLE_DIR/$1.claim" 2>/dev/null || true
  rm -rf "$SETTLE_DIR/$1.lock"  2>/dev/null || true
}

# ---------------------------------------------------------------------------
# notify-settle — the ONE place a settle is recorded + announced.
# Used by `done` (executor, primary), `watch` (backstop) and `reconcile`.
# ---------------------------------------------------------------------------
usage_notify_settle() {
  cat >&2 <<EOF
Usage: task-worktree notify-settle <task-id> --by <executor|watcher|reconcile>
                            [--status <awaiting-dispatch|blocked|watcher-failed>]
                            [--note <text>] [--pr <url>] [--commit <sha>]
                            [--body <text> | --body-file <path>]
                            [--dispatch-pane <pane>] [--compare <url>] [--force]

  Internal plumbing: takes the settle claim, appends the durable 'settled'
  ledger event, fires the desktop notification and wakes Dispatch — EXACTLY
  ONCE per settle. Prefer 'done' (executors) over calling this directly.
EOF
}

cmd_notify_settle() {
  local id="" by="" status="awaiting-dispatch" note="" pr="" commit=""
  local body="" body_file="" pane_arg="" compare="" force=0 quiet=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --by)            by="$2"; shift 2 ;;
      --status)        status="$2"; shift 2 ;;
      --note)          note="$2"; shift 2 ;;
      --pr)            pr="$2"; shift 2 ;;
      --commit)        commit="$2"; shift 2 ;;
      --body)          body="$2"; shift 2 ;;
      --body-file)     body_file="$2"; shift 2 ;;
      --dispatch-pane) pane_arg="$2"; shift 2 ;;
      --compare)       compare="$2"; shift 2 ;;
      --force)         force=1; shift ;;
      --quiet)         quiet=1; shift ;;
      -h|--help)       usage_notify_settle; return 0 ;;
      -*) die "notify-settle: unknown arg '$1'" ;;
      *) [ -n "$id" ] && die "notify-settle: unexpected arg '$1'"; id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || { usage_notify_settle; die "notify-settle: task id required"; }
  [ -n "$by" ] || die "notify-settle: --by required"

  # 0. EXACTLY-ONCE GATE.
  if ! _settle_claim "$id" "$by" "$force"; then
    [ "$quiet" -eq 1 ] || info "settle already reported for $id (epoch ${SETTLE_EPOCH:-?}) — $by suppressed"
    return 0
  fi
  local epoch="${SETTLE_EPOCH:-1}"

  local mode branch primary
  mode="$(_task_field "$id" mode)";    [ -n "$mode" ] || mode="code"
  branch="$(_task_field "$id" branch)"
  primary="$(_task_field "$id" primary_repo)"
  if [ -z "$compare" ] && [ "$mode" = "code" ] && [ -n "$branch" ] && [ -n "$primary" ]; then
    compare="$(_compare_url "$primary" "$branch" 2>/dev/null || true)"
  fi

  # 1. The executor's own words, persisted BEFORE any wake so they survive even
  #    if every wake fails and the agent workspace is later torn down.
  local exec_report=""
  if [ -n "$body_file" ]; then
    [ -f "$body_file" ] || die "notify-settle: --body-file not found: $body_file"
    body="$(cat "$body_file")"
  fi
  if [ -n "$body" ]; then
    mkdir -p "$REPORTS_DIR"
    exec_report="$REPORTS_DIR/$id.executor.md"
    {
      printf '%s\n\n' "# Executor report: $id (settle #$epoch, by $by)"
      [ -n "$note" ]    && printf '%s\n' "- **note:** $note"
      [ -n "$pr" ]      && printf '%s\n' "- **pr:** $pr"
      [ -n "$commit" ]  && printf '%s\n' "- **commit:** $commit"
      [ -n "$compare" ] && printf '%s\n' "- **compare:** $compare"
      printf '%s\n\n---\n\n' "- **ts:** $(now)"
      printf '%s\n' "$body"
    } > "$exec_report"
  fi

  # 2. DURABLE ledger event — append-only, survives any wake failure, and makes
  #    `list` accurate with no live polling.
  local entry
  entry="$(python3 - "$id" "$status" "$by" "$epoch" "$note" "$pr" "$commit" \
                    "${exec_report:+reports/$id.executor.md}" "$compare" "$(now)" <<'PY'
import json, sys
(id_, status, by, epoch, note, pr, commit, rf, compare, ts) = sys.argv[1:11]
print(json.dumps({
    "event": "settled", "id": id_, "status": status, "by": by,
    "epoch": int(epoch) if str(epoch).isdigit() else None,
    "note": note or None, "pr": pr or None, "commit": commit or None,
    "executor_report": rf or None, "compare": compare or None, "ts": ts,
}))
PY
)"
  ledger_append "$entry"

  # 3. Desktop notification for the human (covers the case where every wake fails).
  herdr notification show "Task $id settled ($status)" \
    --body "${note:-Recorded to ledger — Dispatch will report.}" >/dev/null 2>&1 || true

  # 4. Wake Dispatch — retried so a transient busy state can't swallow it.
  local pane; pane="$(_resolve_dispatch_pane "$id" "$pane_arg")"
  if [ -z "$pane" ]; then
    info "warning: could not resolve the Dispatch pane; settle is recorded in the ledger only"
    return 0
  fi
  local msg
  if [ "$by" = "executor" ]; then
    msg="[task-executor] Task $id reports DONE (status: $status)."
  else
    msg="[task-$by] Executor $id settled ($status)."
  fi
  [ -n "$note" ]        && msg="$msg Note: $note"
  [ -n "$pr" ]          && msg="$msg PR: $pr"
  [ -n "$compare" ]     && msg="$msg Show the human this GitHub compare link: $compare"
  [ -n "$commit" ]      && msg="$msg Commit: $commit"
  [ -n "$exec_report" ] && msg="$msg Full executor report: reports/$id.executor.md"
  msg="$msg Next: read it (herdr agent read $id) if you need more, then persist it with bin/task-worktree report $id --status awaiting-review --note \"<summary>\"${exec_report:+ --body-file reports/$id.executor.md}, and surface the result to the human."

  local attempt
  for attempt in 1 2 3 4 5; do
    herdr agent prompt "$pane" "$msg" >/dev/null 2>&1 && { 
      [ "$quiet" -eq 1 ] || info "woke Dispatch ($pane) for $id settle #$epoch"
      return 0
    }
    sleep 10
  done
  info "warning: could not wake Dispatch ($pane) after 5 attempts; settle #$epoch is still recorded in the ledger"
}

# ---------------------------------------------------------------------------
# done — the executor's PRIMARY completion path
# ---------------------------------------------------------------------------
usage_done() {
  cat >&2 <<EOF
Usage: task-worktree done [<task-id>] --note "<one-line summary>"
                          [--pr <url>] [--commit <sha>]
                          [--body <text> | --body-file <path>]
                          [--blocked] [--force]

  Called BY THE EXECUTOR as its final action, after committing and pushing.
  Records the durable settle event, notifies the human and wakes Dispatch.
  Executors must NEVER call 'herdr agent prompt' by hand.

  The task id defaults to \$TASK_ID, or to TASK_ID in ./task.env (which 'create'
  writes into the task workspace), so plain 'task-worktree done --note ...'
  works from inside a task dir.

  --note      One-line summary (required) — what you did.
  --pr        Pull-request URL, when the brief asked for a PR.
  --commit    Head commit SHA of your branch.
  --body[-file]  Your full markdown report; stored at reports/<id>.executor.md
              so it survives teardown.
  --blocked   You are stopping BLOCKED, not finished (status: blocked).
  --force     Report again even if this settle was already reported.
EOF
}

cmd_done() {
  local id="" status="awaiting-dispatch"
  local -a pass=()
  local note_seen=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --note)      note_seen=1; pass+=(--note "$2"); shift 2 ;;
      --pr|--commit|--body|--body-file|--dispatch-pane|--compare)
                   pass+=("$1" "$2"); shift 2 ;;
      --blocked)   status="blocked"; shift ;;
      --force)     pass+=(--force); shift ;;
      -h|--help)   usage_done; return 0 ;;
      -*) die "done: unknown arg '$1'" ;;
      *) [ -n "$id" ] && die "done: unexpected arg '$1'"; id="$1"; shift ;;
    esac
  done

  # Work out who we are without guessing: explicit arg > \$TASK_ID > ./task.env.
  [ -n "$id" ] || id="${TASK_ID:-}"
  if [ -z "$id" ] && [ -f "./task.env" ]; then
    id="$(. ./task.env >/dev/null 2>&1; printf '%s' "${TASK_ID:-}")"
  fi
  [ -n "$id" ] || { usage_done; die "done: task id required (no \$TASK_ID and no ./task.env)"; }
  [ "$note_seen" -eq 1 ] || { usage_done; die "done: --note is required"; }
  [ -n "$(_find_created_rec "$id")" ] || die "done: no ledger record for task '$id'"

  cmd_notify_settle "$id" --by executor --status "$status" ${pass[@]+"${pass[@]}"}
}

# ---------------------------------------------------------------------------
# watch — the detached settle BACKSTOP (armed by create; runs as its own process)
# ---------------------------------------------------------------------------
usage_watch() {
  cat >&2 <<EOF
Usage: task-worktree watch <task-id> [--dispatch-pane <pane>] [--compare <url>]

  Long-running BACKSTOP for one task. Waits for the executor to settle and
  hands the settle to 'notify-settle', which de-duplicates against the
  executor's own 'done'. Re-arms after every settle. Normally started detached
  by 'create'; run it in the foreground to debug (logs to .dispatch/logs/).
EOF
}

_watch_log() { printf '%s %s\n' "$(now)" "$*" >> "$WATCH_LOG"; }

# _watch_abort <id> <reason> — fail LOUD: log it, tell the human, and record a
# durable ledger event + wake so a broken watcher can never fail silently.
_watch_abort() {
  local id="$1" reason="$2"
  _watch_log "ABORT: $reason"
  herdr notification show "Task watcher FAILED ($id)" \
    --body "$reason — see ${WATCH_LOG#$ROOT/}" >/dev/null 2>&1 || true
  cmd_notify_settle "$id" --by watcher --status watcher-failed --force \
    --note "watcher aborted: $reason (log: ${WATCH_LOG#$ROOT/}) — check this task's real state with bin/task-worktree reconcile" \
    >/dev/null 2>&1 || true
  exit 1
}

cmd_watch() {
  local id="" pane="" compare=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dispatch-pane) pane="$2"; shift 2 ;;
      --compare)       compare="$2"; shift 2 ;;
      -h|--help)       usage_watch; return 0 ;;
      -*) die "watch: unknown arg '$1'" ;;
      *) [ -n "$id" ] && die "watch: unexpected arg '$1'"; id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || { usage_watch; die "watch: task id required"; }

  mkdir -p "$LOG_DIR"
  WATCH_LOG="$LOG_DIR/watch-$id.log"

  # DEBOUNCE: seconds the executor must stay settled before we trust a settle.
  # A freshly-booted agent momentarily reports idle/done BEFORE it starts
  # working, so a single wait can latch onto that boot transient and fire a
  # false settle. Two defences, both preserved from the debounce fix:
  #   (1) require having WITNESSED a genuine working phase, and
  #   (2) require the settle to persist across the debounce window.
  # These sleeps live in this DETACHED process — they never block Dispatch.
  local debounce="${TASK_WATCH_DEBOUNCE:-5}"
  # SAFETY VALVE: the maximum number of inconclusive probes before we give up
  # and fail loud. The old watcher could spin here forever, recording nothing.
  local max_spins="${TASK_WATCH_MAX_SPINS:-120}"

  _watch_log "watch start (pid $$, debounce=${debounce}s, max_spins=$max_spins, pane=${pane:-auto})"

  local rc st spins n

  # Phase 1 — WITNESS a genuine work phase (first cycle only). The boot
  # transient can satisfy a bare "--until working" wait, so we additionally
  # require a fresh probe to read the agent as actually working. If the agent
  # never shows work across all attempts (a genuinely fast task that finished
  # before we looked), fall through — phase 2's debounce still guards us.
  local witnessed=0
  for n in 1 2 3 4 5 6; do
    rc=0; _hwait "$id" --until working --timeout 30000 || rc=$?
    [ "$rc" -ge 2 ] && _watch_abort "$id" "$HWAIT_ERR"
    if [ "$(_agent_status "$id")" = "working" ]; then witnessed=1; break; fi
    sleep "$debounce"
  done
  _watch_log "phase 1 done: witnessed=$witnessed"

  # RE-ARMING LOOP: report EVERY settle.
  while :; do
    # Phase 2 — wait for a settle that HOLDS across the debounce window.
    # NOTE: a BARE wait already means idle|done|blocked. Never write
    # '--until idle done blocked' — herdr exits rc=2 on that.
    spins=0
    while :; do
      rc=0; _hwait "$id" || rc=$?
      if [ "$rc" -ge 2 ]; then
        # The agent vanishing is normal iff the task was torn down.
        if [ ! -d "$TASKS_DIR/$id" ]; then
          _watch_log "task dir gone — task closed; watcher exiting cleanly"; return 0
        fi
        _watch_abort "$id" "$HWAIT_ERR"
      fi
      sleep "$debounce"
      st="$(_agent_status "$id")"
      case "$st" in
        idle|done|blocked) break ;;                     # a real, held settle
        working) : ;;                                   # resumed mid-window
        "") if [ ! -d "$TASKS_DIR/$id" ]; then
              _watch_log "agent gone + task dir gone — exiting cleanly"; return 0
            fi ;;
      esac
      spins=$((spins + 1))
      [ "$spins" -gt "$max_spins" ] && \
        _watch_abort "$id" "settle never stabilised after $max_spins probes (last status: '${st:-gone}')"
      _watch_log "settle not held (status='${st:-gone}'), spin $spins/$max_spins"
    done

    local status="awaiting-dispatch"
    [ "$st" = "blocked" ] && status="blocked"
    _watch_log "settled: status=$status"

    # Hand off to the shared path — it de-duplicates against the executor's
    # own 'done', so Dispatch is woken exactly once for this settle.
    cmd_notify_settle "$id" --by watcher --status "$status" --quiet \
      ${pane:+--dispatch-pane "$pane"} ${compare:+--compare "$compare"} \
      >>"$WATCH_LOG" 2>&1 || _watch_log "warning: notify-settle failed (see above)"

    # RE-ARM: block until the executor genuinely resumes work, then release the
    # settle claim so the NEXT settle reports again.
    spins=0
    while :; do
      if [ "$(_agent_status "$id")" = "working" ]; then break; fi
      rc=0; _hwait "$id" --until working || rc=$?
      if [ "$rc" -ge 2 ]; then
        if [ ! -d "$TASKS_DIR/$id" ]; then
          _watch_log "task closed while parked; watcher exiting cleanly"; return 0
        fi
        _watch_abort "$id" "$HWAIT_ERR"
      fi
      sleep "$debounce"
      spins=$((spins + 1))
      # Nothing is pending here (the settle is already recorded), so we back off
      # instead of aborting — but we never hot-spin.
      if [ "$spins" -gt "$max_spins" ]; then
        _watch_log "re-arm: no confirmed resume after $spins probes; backing off"
        sleep 30
      fi
    done
    witnessed=1
    _settle_release "$id" "executor resumed work"
    _watch_log "re-armed: executor resumed work"
  done
}

# ---------------------------------------------------------------------------
# create
# ---------------------------------------------------------------------------

# _resolve_repo <repo> -> ensures \$REPOS/<repo> resolves to a git repo,
# creating the on-demand symlink when we can work out where it lives.
# Dies with an EXACT fix-it command when we can't.
_resolve_repo() {
  local repo="$1" target=""
  if [ -d "$REPOS/$repo/.git" ] || [ -e "$REPOS/$repo/.git" ]; then return 0; fi

  # Candidates, best first:
  #   1. the Dispatch root itself (this harness repo is usually linked in as
  #      \$REPOS/<root-basename> -> the root; that link is easy to lose)
  #   2. an existing repo-view symlink at the root
  if [ "$repo" = "$(basename "$ROOT")" ] && [ -e "$ROOT/.git" ]; then
    target="$ROOT"
  elif [ -L "$ROOT/$repo" ]; then
    local t; t="$(cd "$ROOT" && readlink "$repo")"
    [ -e "$t/.git" ] && target="$t"
  fi

  if [ -n "$target" ]; then
    [ -e "$REPOS/$repo" ] && rm -f "$REPOS/$repo"
    ln -s "$target" "$REPOS/$repo"
    info "restored missing repo link: $REPOS/$repo -> $target"
    return 0
  fi

  die "repo '$repo' is not a git repo under $REPOS (missing: $REPOS/$repo).
Fix it with ONE of:
  ln -s /path/to/$repo $REPOS/$repo        # link an existing checkout
  git -C $REPOS clone <remote-url> $repo   # or clone it
Then re-run this command."
}

# _done_brief <id> <compare-url> -> the completion contract appended to every
# executor briefing, so the executor always knows how to reach Dispatch.
_done_brief() {
  local id="$1" compare="${2:-}"
  printf '%s' "Your task id is $id (also in ./task.env). When you are finished — after committing and pushing — your FINAL action MUST be to tell Dispatch yourself:
  $SELF done $id --note \"<one-line summary>\" [--pr <url>] [--body-file <path-to-your-report.md>]
(use --blocked instead of finishing if you are stopping blocked). Never run 'herdr agent prompt' by hand."
  [ -n "$compare" ] && printf '%s' "
Compare link for your branch: $compare"
  printf '\n'
}

usage_create() {
  cat >&2 <<EOF
Usage: task-worktree create --slug <name> --repo <repo> [--repo <repo> ...]
                            [--branch <name>] [--base <ref>] [--mode <mode>]
                            [--agent <kind>] [--request "<your words>"]
                            [--prompt "<opening instruction>"] [--no-agent]

  --slug     Human slug for the task (a short nonce is appended -> the task id).
  --repo     Repo under \$REPOS to work in. First --repo is the primary.
             Repeat for multi-repo tasks.
  --branch   Branch name (default: the task id).
  --base     Base ref for new branches (default: HEAD of each repo).
  --mode     Task lifecycle (default: 'code'):
               code        touches the tree; stays open for review, closed later.
               investigate read-only find/answer; reports and auto-closes itself.
  --agent    Executor agent kind (default: \$TASK_AGENT_KIND or 'pi').
  --request  Your original request, recorded in the ledger.
  --prompt   Opening instruction handed to the executor agent.
  --no-agent Prepare worktrees + task dir only; do not spawn an agent.
EOF
}

cmd_create() {
  local slug="" branch="" base="" agent="$DEFAULT_AGENT_KIND"
  local request="" prompt="" no_agent=0 mode="code"
  local -a repos=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --slug)    slug="$2"; shift 2 ;;
      --repo)    repos+=("$2"); shift 2 ;;
      --branch)  branch="$2"; shift 2 ;;
      --base)    base="$2"; shift 2 ;;
      --mode)    mode="$2"; shift 2 ;;
      --agent)   agent="$2"; shift 2 ;;
      --request) request="$2"; shift 2 ;;
      --prompt)  prompt="$2"; shift 2 ;;
      --no-agent) no_agent=1; shift ;;
      -h|--help) usage_create; return 0 ;;
      *) die "create: unknown arg '$1'" ;;
    esac
  done

  [ -n "$slug" ]        || { usage_create; die "create: --slug required"; }
  [ "${#repos[@]}" -gt 0 ] || { usage_create; die "create: at least one --repo required"; }
  case "$mode" in
    code|investigate) ;;
    *) die "create: --mode must be 'code' or 'investigate' (got '$mode')" ;;
  esac

  # sanitize slug: lowercase, non-alnum -> '-'
  slug="$(printf '%s' "$slug" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-//; s/-$//')"
  [ -n "$slug" ] || die "create: --slug produced an empty slug"
  local id="${slug}-$(nonce)"
  [ -n "$branch" ] || branch="$id"

  # validate repos exist (restoring a lost on-demand link when we can)
  local repo
  for repo in "${repos[@]}"; do
    _resolve_repo "$repo"
  done

  info "task id: $id  branch: $branch  mode: $mode  repos: ${repos[*]}"

  local task_dir="$TASKS_DIR/$id"
  [ -e "$task_dir" ] && die "task dir already exists: $task_dir"
  mkdir -p "$task_dir"

  # per-repo worktree creation
  local -a wt_workspaces=()
  local -a wt_records=()
  local primary="${repos[0]}"
  for repo in "${repos[@]}"; do
    # 1. lazy on-demand repo symlink at root
    if [ ! -e "$ROOT/$repo" ]; then
      ln -s "$REPOS/$repo" "$ROOT/$repo"
      info "linked repo view: $repo -> $REPOS/$repo"
    fi

    # 2. create the worktree via herdr (authoritative)
    local checkout="$WORKTREE_STORE/$repo/$branch"
    # Base selection: an explicit --base always wins ("unless specified").
    # Otherwise start from the FRESHLY-FETCHED latest main tip so we never
    # branch off a stale local checkout.
    local repo_base="$base"
    if [ -z "$repo_base" ]; then
      local main_branch; main_branch="$(_default_branch "$repo")"
      info "fetching latest $repo/$main_branch ..."
      git -C "$REPOS/$repo" fetch --quiet origin "$main_branch" 2>/dev/null \
        || info "warning: fetch failed for $repo (continuing from local ref)"
      repo_base="origin/$main_branch"
    fi
    info "base: $repo @ $repo_base"
    local -a base_args=(--base "$repo_base")
    local out
    out="$(herdr worktree create \
      --cwd "$REPOS/$repo" \
      --branch "$branch" \
      ${base_args[@]+"${base_args[@]}"} \
      --path "$checkout" \
      --label "$repo" \
      --no-focus 2>&1)" || { printf '%s\n' "$out" >&2; die "herdr worktree create failed for $repo"; }

    local wsid path
    wsid="$(jget "$out" "d['result']['workspace']['workspace_id']")"
    path="$(jget "$out" "d['result']['worktree']['path']")"
    wt_workspaces+=("$wsid")
    info "worktree: $repo@$branch -> $path (ws $wsid)"

    # 3. symlink into the flat worktree view
    mkdir -p "$WORKTREE_VIEW/$repo/$(dirname "$branch")"
    ln -sfn "$path" "$WORKTREE_VIEW/$repo/$branch"

    # 4. symlink into the ephemeral task dir (executor's isolated view)
    ln -sfn "$WORKTREE_VIEW/$repo/$branch" "$task_dir/$repo"

    wt_records+=("{\"repo\":\"$repo\",\"branch\":\"$branch\",\"workspace_id\":\"$wsid\",\"path\":\"$path\"}")
  done

  # executor AGENTS.md into the task dir
  ln -sfn "$EXECUTOR_CONTEXT" "$task_dir/AGENTS.md"

  # Dispatch's own pane: resolved ONCE, here, where $HERDR_PANE_ID legitimately
  # belongs to Dispatch (it is running this command). It is then persisted into
  # the task workspace + ledger so the executor's `done` never has to guess.
  local dispatch_pane="${DISPATCH_PANE_ID:-${HERDR_PANE_ID:-}}"
  [ -n "$dispatch_pane" ] || dispatch_pane="$(_discover_dispatch_pane)"
  local task_compare=""
  [ "$mode" = "code" ] && task_compare="$(_compare_url "$primary" "$branch" 2>/dev/null || true)"

  # task.env — the executor's identity kit. Sourced by `task-worktree done`, and
  # readable by the executor itself.
  cat > "$task_dir/task.env" <<EOF
# Identity of this task — written by 'task-worktree create'. Source it or read it.
TASK_ID="$id"
TASK_SLUG="$slug"
TASK_MODE="$mode"
TASK_BRANCH="$branch"
TASK_PRIMARY_REPO="$primary"
TASK_REPOS="${repos[*]}"
TASK_DISPATCH_PANE="$dispatch_pane"
TASK_COMPARE_URL="$task_compare"
TASK_WORKTREE_BIN="$SELF"
EOF

  # spawn executor agent in an isolated workspace rooted at the task dir
  local exec_wsid="" exec_pane=""
  if [ "$no_agent" -eq 0 ]; then
    local out
    out="$(herdr workspace create --cwd "$task_dir" --label "$id" --no-focus 2>&1)" \
      || { printf '%s\n' "$out" >&2; die "herdr workspace create failed"; }
    exec_wsid="$(jget "$out" "d['result']['workspace']['workspace_id']")"
    exec_pane="$(jget "$out" "d['result']['root_pane']['pane_id']")"
    info "executor workspace: $exec_wsid  pane: $exec_pane"

    herdr agent start "$id" --kind "$agent" --pane "$exec_pane" >/dev/null 2>&1 \
      || die "herdr agent start failed (kind=$agent pane=$exec_pane)"
    info "started $agent agent '$id'"

    if [ -n "$prompt" ]; then
      local full="$prompt

Read ./AGENTS.md first — it defines how you must operate as a task executor. Primary repo: $primary (branch $branch).
$(_done_brief "$id" "$task_compare")"
      herdr agent prompt "$id" "$full" >/dev/null 2>&1 \
        || info "warning: agent prompt submission failed; brief the agent manually"
    fi

    # BACKSTOP watcher: a detached `task-worktree watch` process. It never
    # blocks Dispatch and never polls Dispatch; it waits on herdr for the
    # executor to settle and then goes through the SAME notify-settle path the
    # executor's own `done` uses, so the two can't double-report. It lives in
    # its own process (not an inline heredoc) so it can be run and tested
    # directly: bin/task-worktree watch <id>.
    nohup "$SELF" watch "$id" \
      ${dispatch_pane:+--dispatch-pane "$dispatch_pane"} \
      ${task_compare:+--compare "$task_compare"} \
      >>"$LOG_DIR/watch-$id.log" 2>&1 &
    disown 2>/dev/null || true
    info "backstop watcher armed for $id (log: .dispatch/logs/watch-$id.log); primary path is the executor's own 'done'"
  fi


  # ledger entry
  local wts; wts="$(IFS=,; echo "${wt_records[*]}")"
  local entry
  entry="$(python3 - "$id" "$slug" "$branch" "$primary" "$agent" \
                    "$request" "$prompt" "$exec_wsid" "$mode" "$(now)" "$wts" \
                    "$dispatch_pane" "$task_compare" <<'PY'
import json, sys
(id_, slug, branch, primary, agent, request, prompt, exec_ws, mode, ts, wts,
 pane, compare) = sys.argv[1:14]
print(json.dumps({
    "event": "created",
    "id": id_, "slug": slug, "branch": branch, "primary_repo": primary,
    "agent_kind": agent, "mode": mode, "request": request, "prompt": prompt,
    "executor_workspace_id": exec_ws or None,
    "dispatch_pane": pane or None, "compare": compare or None,
    "worktrees": json.loads("[" + wts + "]"),
    "status": "working", "ts": ts,
}))
PY
)"
  ledger_append "$entry"
  # A fresh task is a fresh settle epoch.
  _settle_forget "$id"

  printf '\n✔ task %s ready\n  task dir: %s\n' "$id" "$task_dir" >&2
  echo "$id"
}

# ---------------------------------------------------------------------------
# remove
# ---------------------------------------------------------------------------
usage_remove() {
  cat >&2 <<EOF
Usage: task-worktree remove <task-id> [--delete-branch]

  Tears down herdr worktree workspaces, the executor workspace, the flat
  worktree symlinks, the ephemeral task dir, and unused repo symlinks.
  The git branch is kept by default (it holds the work); pass --delete-branch
  to also delete it.
EOF
}

# _find_created_rec <id>  -> prints the latest task record (or empty).
# Matches 'created' OR 'handoff' events: a handoff replaces the executor and
# carries a FRESH executor_workspace_id plus the copied worktrees/branch/mode,
# so teardown/report always act on the LIVE workspace, not a stale one.
_find_created_rec() {
  python3 - "$LEDGER" "$1" <<'PY'
import json, sys
path, id_ = sys.argv[1], sys.argv[2]
found = None
for line in open(path):
    line = line.strip()
    if not line: continue
    try: o = json.loads(line)
    except Exception: continue
    if o.get("id") == id_ and o.get("event") in ("created", "handoff"):
        found = o
print(json.dumps(found) if found else "")
PY
}

# _teardown_from_rec <rec-json> <delete_branch 0|1> <id>
# Tears down herdr worktrees, the executor workspace, view symlinks, the task
# dir, and records a 'closed' event. Shared by `remove` and investigate
# auto-close. Callers must persist any report BEFORE invoking this.
_teardown_from_rec() {
  local rec="$1" delete_branch="$2" id="$3"

  # Stop the backstop watcher first so it can't fire on the agent disappearing.
  pkill -f "task-worktree watch $id" >/dev/null 2>&1 \
    && info "stopped backstop watcher for $id" || true
  _settle_forget "$id"

  python3 - "$rec" <<'PY' | while IFS=$'\t' read -r wsid repo branch path; do
import json, sys
o = json.loads(sys.argv[1])
for w in o.get("worktrees", []):
    print("\t".join([w["workspace_id"], w["repo"], w["branch"], w["path"]]))
PY
    info "removing worktree $repo@$branch (ws $wsid)"
    herdr worktree remove --workspace "$wsid" --force >/dev/null 2>&1 \
      || info "warning: herdr worktree remove failed for $wsid (continuing)"
    rm -f "$WORKTREE_VIEW/$repo/$branch"
    if [ "$delete_branch" -eq 1 ]; then
      git -C "$REPOS/$repo" branch -D "$branch" >/dev/null 2>&1 \
        && info "deleted branch $repo@$branch" || true
    fi
  done

  local exec_ws; exec_ws="$(jget "$rec" "d.get('executor_workspace_id') or ''" 2>/dev/null || true)"
  if [ -n "$exec_ws" ] && [ "$exec_ws" != "None" ]; then
    herdr workspace close "$exec_ws" >/dev/null 2>&1 \
      && info "closed executor workspace $exec_ws" || true
  fi

  rm -rf "${TASKS_DIR:?}/$id"
  find "$WORKTREE_VIEW" -mindepth 1 -type d -empty -delete 2>/dev/null || true
  prune_repo_symlinks

  ledger_append "{\"event\":\"closed\",\"id\":\"$id\",\"status\":\"closed\",\"ts\":\"$(now)\"}"
  info "task $id closed"
}

cmd_remove() {
  local id="" delete_branch=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --delete-branch) delete_branch=1; shift ;;
      -h|--help) usage_remove; return 0 ;;
      -*) die "remove: unknown arg '$1'" ;;
      *) id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || { usage_remove; die "remove: task id required"; }

  local rec; rec="$(_find_created_rec "$id")"
  [ -n "$rec" ] || die "no ledger record for task '$id'"
  _teardown_from_rec "$rec" "$delete_branch" "$id"
}

# ---------------------------------------------------------------------------
# handoff — baton-pass an existing task to a FRESH-context executor
# ---------------------------------------------------------------------------
usage_handoff() {
  cat >&2 <<EOF
Usage: task-worktree handoff <task-id> [--prompt "<opening instruction>"]
                            [--note-from <path>] [--agent <kind>]

  Replaces the idle executor on an existing task with a brand-new, empty-context
  agent, keeping the SAME worktree(s), branch, uncommitted changes and PR — the
  baton pass. The old executor workspace (its context) is closed; the worktrees
  are untouched. The existing re-arming watcher keeps tracking the task id, so
  no duplicate watcher is armed.

  --prompt     Opening instruction for the fresh agent (defaults to a generic
               "continue this task" brief).
  --note-from  File whose contents are handed to the fresh agent as a handoff
               note (e.g. the prior agent's HANDOFF.md). Optional but strongly
               recommended — the old agent's knowledge lives in the tree/notes,
               not in the discarded context.
  --agent      Executor kind for the fresh agent (default: the task's original).
EOF
}

cmd_handoff() {
  local id="" prompt="" note_file="" agent=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --prompt)    prompt="$2"; shift 2 ;;
      --note-from) note_file="$2"; shift 2 ;;
      --agent)     agent="$2"; shift 2 ;;
      -h|--help)   usage_handoff; return 0 ;;
      -*) die "handoff: unknown arg '$1'" ;;
      *) [ -n "$id" ] && die "handoff: unexpected arg '$1'"; id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || { usage_handoff; die "handoff: task id required"; }

  local rec; rec="$(_find_created_rec "$id")"
  [ -n "$rec" ] || die "handoff: no ledger record for task '$id'"

  local mode branch primary old_ws agent_kind
  mode="$(jget "$rec" "d.get('mode') or 'code'")"
  branch="$(jget "$rec" "d.get('branch') or ''")"
  primary="$(jget "$rec" "d.get('primary_repo') or ''")"
  old_ws="$(jget "$rec" "d.get('executor_workspace_id') or ''")"
  agent_kind="$(jget "$rec" "d.get('agent_kind') or '$DEFAULT_AGENT_KIND'")"
  [ -n "$agent" ] && agent_kind="$agent"

  local task_dir="$TASKS_DIR/$id"
  [ -d "$task_dir" ] || die "handoff: task dir missing ($task_dir) — is the task closed?"

  local note=""
  if [ -n "$note_file" ]; then
    [ -f "$note_file" ] || die "handoff: --note-from not found: $note_file"
    note="$(cat "$note_file")"
  fi
  [ -n "$prompt" ] || prompt="You are taking over this in-progress task with a fresh context. Read ./AGENTS.md and inspect the working tree (including any HANDOFF note / recent commits) to see what the previous executor did, then carry the work to completion."

  info "handoff: task $id  branch $branch  agent $agent_kind"

  # 1. Close the prior executor workspace (discards the old context). The
  #    worktree workspaces are separate, so uncommitted work is preserved.
  if [ -n "$old_ws" ] && [ "$old_ws" != "None" ]; then
    herdr workspace close "$old_ws" >/dev/null 2>&1 \
      && info "closed prior executor workspace $old_ws" \
      || info "warning: could not close prior executor workspace $old_ws (continuing)"
  fi

  # 2. Fresh executor workspace + agent, rooted at the SAME task dir (which
  #    already symlinks to the existing worktree(s)).
  local out new_ws new_pane
  out="$(herdr workspace create --cwd "$task_dir" --label "$id" --no-focus 2>&1)" \
    || { printf '%s\n' "$out" >&2; die "handoff: herdr workspace create failed"; }
  new_ws="$(jget "$out" "d['result']['workspace']['workspace_id']")"
  new_pane="$(jget "$out" "d['result']['root_pane']['pane_id']")"
  info "new executor workspace: $new_ws  pane: $new_pane"

  herdr agent start "$id" --kind "$agent_kind" --pane "$new_pane" >/dev/null 2>&1 \
    || die "handoff: herdr agent start failed (kind=$agent_kind pane=$new_pane)"
  info "started fresh $agent_kind agent '$id'"

  # 3. Brief the fresh agent: prompt + optional handoff note + standard footer.
  local full="$prompt"
  [ -n "$note" ] && full="$full

--- handoff note ---
$note
--- end handoff note ---"
  local ho_compare=""
  [ "$mode" = "code" ] && [ -n "$primary" ] && [ -n "$branch" ] \
    && ho_compare="$(_compare_url "$primary" "$branch" 2>/dev/null || true)"
  full="$full

Read ./AGENTS.md first — it defines how you must operate as a task executor. Primary repo: $primary (branch $branch).
$(_done_brief "$id" "$ho_compare")"
  herdr agent prompt "$id" "$full" >/dev/null 2>&1 \
    || info "warning: agent prompt submission failed; brief the agent manually"

  # A fresh executor means fresh work: release the settle claim so its eventual
  # settle reports again (and refresh task.env, whose pane/branch may be stale).
  _settle_release "$id" "handed off to a fresh executor"
  if [ -f "$task_dir/task.env" ]; then
    local ho_pane; ho_pane="$(_resolve_dispatch_pane "$id")"
    python3 - "$task_dir/task.env" "$ho_pane" <<'PY' || true
import re, sys
p, pane = sys.argv[1], sys.argv[2]
if pane:
    s = open(p).read()
    s = re.sub(r'^TASK_DISPATCH_PANE=.*$', 'TASK_DISPATCH_PANE="%s"' % pane, s, flags=re.M)
    open(p, "w").write(s)
PY
  fi

  # 4. Ledger 'handoff' event — copies the task's worktrees/branch/mode from the
  #    prior record but records the NEW executor_workspace_id so teardown/report
  #    act on the live workspace. status stays 'working'.
  local entry
  entry="$(python3 - "$rec" "$id" "$new_ws" "$prompt" "$note" "$(now)" <<'PY'
import json, sys
(rec, id_, new_ws, prompt, note, ts) = sys.argv[1:7]
o = json.loads(rec)
print(json.dumps({
    "event": "handoff",
    "id": id_,
    "slug": o.get("slug"),
    "branch": o.get("branch"),
    "primary_repo": o.get("primary_repo"),
    "agent_kind": o.get("agent_kind"),
    "mode": o.get("mode") or "code",
    "request": o.get("request"),
    "prompt": prompt,
    "handoff_note": note or None,
    "executor_workspace_id": new_ws or None,
    "worktrees": o.get("worktrees", []),
    "status": "working",
    "ts": ts,
}))
PY
)"
  ledger_append "$entry"

  # 5. Watcher: the original re-arming watcher keys on the task id and is parked
  #    in its "wait for work to resume" phase, so it picks up the fresh agent —
  #    no second watcher is armed (avoids duplicate settle records / wakes).
  info "reused existing re-arming watcher for $id (no duplicate armed)"

  printf '\n✔ handoff complete for %s\n  task dir: %s\n' "$id" "$task_dir" >&2
  echo "$id"
}

# ---------------------------------------------------------------------------
# report
# ---------------------------------------------------------------------------
usage_report() {
  cat >&2 <<EOF
Usage: task-worktree report <task-id> [--status <status>] [--note <text>]
                            [--commit <sha>] [--body <text> | --body-file <path>]

  Persists the executor's report DURABLY — first to reports/<id>.md, then as a
  'reported' ledger event — BEFORE any teardown, so it can never be lost.

  If the task was created with --mode investigate, it then auto-closes itself
  (teardown + branch delete, nothing to review). A --mode code task is left open
  at its report status for human review and explicit 'remove' later.

  --status   Report status (default: awaiting-review).
  --note     One-line summary recorded in the ledger.
  --commit   Commit SHA to record (code tasks).
  --body     Full report text (markdown) for reports/<id>.md.
  --body-file  Read the full report text from a file instead of --body.
EOF
}

cmd_report() {
  local id="" status="" note="" commit="" body="" body_file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --status)    status="$2"; shift 2 ;;
      --note)      note="$2"; shift 2 ;;
      --commit)    commit="$2"; shift 2 ;;
      --body)      body="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      -h|--help)   usage_report; return 0 ;;
      -*) die "report: unknown arg '$1'" ;;
      *) [ -n "$id" ] && die "report: unexpected arg '$1'"; id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || { usage_report; die "report: task id required"; }

  local rec; rec="$(_find_created_rec "$id")"
  [ -n "$rec" ] || die "report: no ledger record for task '$id'"
  local mode; mode="$(jget "$rec" "d.get('mode') or 'code'")"
  local rep_branch; rep_branch="$(jget "$rec" "d.get('branch') or ''")"
  local rep_primary; rep_primary="$(jget "$rec" "d.get('primary_repo') or ''")"
  [ -n "$status" ] || status="awaiting-review"

  # Compare link (code tasks): main...branch on the primary repo.
  local compare=""
  if [ "$mode" = "code" ] && [ -n "$rep_branch" ] && [ -n "$rep_primary" ]; then
    compare="$(_compare_url "$rep_primary" "$rep_branch")"
  fi

  if [ -n "$body_file" ]; then
    [ -f "$body_file" ] || die "report: --body-file not found: $body_file"
    body="$(cat "$body_file")"
  fi

  # 1. DURABLE report file first — human-readable, survives any teardown.
  mkdir -p "$REPORTS_DIR"
  local report_file="$REPORTS_DIR/$id.md"
  {
    printf '%s\n\n' "# Task report: $id"
    printf '%s\n' "- **status:** $status"
    printf '%s\n' "- **mode:** $mode"
    [ -n "$commit" ] && printf '%s\n' "- **commit:** $commit"
    [ -n "$compare" ] && printf '%s\n' "- **compare:** $compare"
    printf '%s\n\n' "- **ts:** $(now)"
    [ -n "$note" ] && printf '%s\n\n' "**note:** $note"
    printf '%s\n\n' '---'
    printf '%s\n' "$body"
  } > "$report_file"
  info "report persisted: ${report_file#$ROOT/}"

  # 2. Ledger 'reported' event pointing at the durable file.
  local entry
  entry="$(python3 - "$id" "$status" "$note" "$commit" "$mode" "reports/$id.md" "$(now)" <<'PY'
import json, sys
(id_, status, note, commit, mode, rf, ts) = sys.argv[1:8]
print(json.dumps({
    "event": "reported", "id": id_, "status": status,
    "note": note or None, "commit": commit or None, "mode": mode,
    "report_file": rf, "ts": ts,
}))
PY
)"
  ledger_append "$entry"

  # 3. Investigate tasks auto-close (report is already safely persisted).
  if [ "$mode" = "investigate" ]; then
    info "mode=investigate → auto-closing $id"
    _teardown_from_rec "$rec" 1 "$id"
  else
    info "mode=code → task $id left open at '$status' for review"
    [ -n "$compare" ] && info "compare: $compare"
  fi
}

# ---------------------------------------------------------------------------
# reconcile — repair ledger status from LIVE herdr state
# ---------------------------------------------------------------------------
usage_reconcile() {
  cat >&2 <<EOF
Usage: task-worktree reconcile [<task-id> ...] [--dry-run] [--no-wake]

  The ledger is the record of intent; herdr is authoritative for liveness. If a
  settle was ever missed (a dead watcher, a crashed executor), a task can sit at
  'working' in the ledger while its agent is actually idle. reconcile compares
  the two and repairs the ledger.

  An idle/blocked agent whose task still reads 'working' is put through the
  normal notify-settle path, so it is recorded and Dispatch is woken — still
  exactly once, because it takes the same settle claim.

  --dry-run  Report what would change; touch nothing.
  --no-wake  Record the repair in the ledger but do not wake Dispatch.
EOF
}

cmd_reconcile() {
  local dry=0 wake=1
  local -a want=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --no-wake) wake=0; shift ;;
      -h|--help) usage_reconcile; return 0 ;;
      -*) die "reconcile: unknown arg '$1'" ;;
      *) want+=("$1"); shift ;;
    esac
  done

  # Open tasks (anything not closed) and their last known ledger status.
  local open_tasks
  open_tasks="$(python3 - "$LEDGER" <<'PY'
import json, sys
state, order = {}, []
for line in open(sys.argv[1]):
    line = line.strip()
    if not line: continue
    try: o = json.loads(line)
    except Exception: continue
    tid = o.get("id")
    if not tid: continue
    if tid not in state: order.append(tid)
    state.setdefault(tid, {}).update(o)
for tid in order:
    if state[tid].get("status") != "closed":
        print("%s\t%s" % (tid, state[tid].get("status", "?")))
PY
)"

  local changed=0 tid ledger_status live
  while IFS=$'\t' read -r tid ledger_status; do
    [ -n "$tid" ] || continue
    if [ "${#want[@]}" -gt 0 ]; then
      local hit=0 w
      for w in "${want[@]}"; do [ "$w" = "$tid" ] && hit=1; done
      [ "$hit" -eq 1 ] || continue
    fi

    live="$(_agent_status "$tid")"
    case "${live:-gone}" in
      working)
        printf '  %-34s ledger=%-16s live=working        ok\n' "$tid" "$ledger_status" ;;
      idle|done|blocked)
        if [ "$ledger_status" = "working" ]; then
          local new="awaiting-dispatch"
          [ "$live" = "blocked" ] && new="blocked"
          printf '  %-34s ledger=%-16s live=%-12s REPAIR -> %s\n' \
            "$tid" "$ledger_status" "$live" "$new"
          if [ "$dry" -eq 0 ]; then
            changed=1
            if [ "$wake" -eq 1 ]; then
              cmd_notify_settle "$tid" --by reconcile --status "$new" \
                --note "reconciled: agent was '$live' while the ledger still said 'working' (a settle was missed)"
            else
              ledger_append "{\"event\":\"settled\",\"id\":\"$tid\",\"status\":\"$new\",\"by\":\"reconcile\",\"note\":\"reconciled (no wake)\",\"ts\":\"$(now)\"}"
            fi
          fi
        else
          printf '  %-34s ledger=%-16s live=%-12s ok\n' "$tid" "$ledger_status" "$live"
        fi ;;
      gone|unknown|"")
        printf '  %-34s ledger=%-16s live=%-12s NO AGENT\n' "$tid" "$ledger_status" "${live:-gone}"
        if [ "$dry" -eq 0 ] && [ "$ledger_status" = "working" ]; then
          changed=1
          ledger_append "{\"event\":\"reconciled\",\"id\":\"$tid\",\"status\":\"orphaned\",\"note\":\"no live herdr agent; the executor is gone\",\"ts\":\"$(now)\"}"
        fi ;;
    esac
  done <<< "$open_tasks"

  if [ "$dry" -eq 1 ]; then
    info "reconcile: dry run — nothing written"
  elif [ "$changed" -eq 1 ]; then
    info "reconcile: ledger repaired"
  else
    info "reconcile: ledger already matches herdr"
  fi
}

# ---------------------------------------------------------------------------
# prune
# ---------------------------------------------------------------------------
# Remove dangling worktree-view symlinks (target gone) and unused repo symlinks.
prune_repo_symlinks() {
  local link repo
  for link in "$ROOT"/*; do
    [ -L "$link" ] || continue
    repo="$(basename "$link")"
    # skip the worktree view dir itself (not a symlink) — only symlinks reach here
    local target; target="$(readlink "$link")"
    case "$target" in
      "$REPOS"/*) ;;      # a repo view symlink — candidate
      *) continue ;;
    esac
    # is it still referenced by any worktree view entry?
    if [ -d "$WORKTREE_VIEW/$repo" ] && [ -n "$(ls -A "$WORKTREE_VIEW/$repo" 2>/dev/null)" ]; then
      continue
    fi
    rm -f "$link"
    info "pruned unused repo view: $repo"
  done
}

cmd_prune() {
  # 1. dangling worktree-view symlinks
  if [ -d "$WORKTREE_VIEW" ]; then
    while IFS= read -r link; do
      [ -e "$link" ] && continue   # target still resolves -> keep
      rm -f "$link"
      info "pruned dangling worktree symlink: ${link#$ROOT/}"
    done < <(find "$WORKTREE_VIEW" -type l 2>/dev/null)
    # tidy empty dirs
    find "$WORKTREE_VIEW" -mindepth 1 -type d -empty -delete 2>/dev/null || true
  fi
  # 2. unused repo symlinks
  prune_repo_symlinks
  info "prune complete"
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------
cmd_list() {
  python3 - "$LEDGER" <<'PY'
import json, sys
path = sys.argv[1]
state = {}
order = []
for line in open(path):
    line = line.strip()
    if not line: continue
    try: o = json.loads(line)
    except Exception: continue
    tid = o.get("id")
    if not tid: continue
    if tid not in state: order.append(tid)
    state.setdefault(tid, {}).update(o)
if not order:
    print("(no tasks in ledger)"); sys.exit(0)
w = max(len(t) for t in order)
for tid in order:
    o = state[tid]
    repos = ",".join(w_["repo"] for w_ in o.get("worktrees", [])) or "-"
    print(f"{tid:<{w}}  {o.get('status','?'):<12}  {repos:<20}  {o.get('request','')[:60]}")
PY
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
usage() {
  cat >&2 <<EOF
task-worktree — blessed path for agentic tasks in this Dispatch root

Usage: task-worktree <create|handoff|done|report|reconcile|remove|prune|list|help> [args]

  create    Spin a task: worktree(s) + ephemeral task dir + executor agent.
  handoff   Baton-pass a task to a FRESH-context executor (same worktree/branch).
  done      (EXECUTORS) "I am finished" — record + notify + wake Dispatch.
  watch     Detached settle backstop for one task (armed automatically).
  report    Persist an executor's report durably; auto-close if --mode investigate.
  reconcile Repair ledger status from live herdr agent state.
  remove    Close a task and clean up (keeps the branch by default).
  prune     Reconcile: drop dangling worktree symlinks + unused repo links.
  list      Show task status from the ledger.

Run 'task-worktree <cmd> --help' for details.
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    create) cmd_create "$@" ;;
    handoff) cmd_handoff "$@" ;;
    done)   cmd_done "$@" ;;
    watch)  cmd_watch "$@" ;;
    notify-settle) cmd_notify_settle "$@" ;;
    # plumbing, used by the watcher and the selftest
    _release) _settle_release "$@" ;;
    _forget)  _settle_forget "$@" ;;
    _status)  _agent_status "$@" ;;
    report) cmd_report "$@" ;;
    reconcile) cmd_reconcile "$@" ;;
    remove) cmd_remove "$@" ;;
    prune)  cmd_prune "$@" ;;
    list)   cmd_list "$@" ;;
    help|-h|--help) usage ;;
    *) usage; die "unknown command '$cmd'" ;;
  esac
}

main "$@"
